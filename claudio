#!/usr/bin/env sh
# claudio — Claude Code profile and account manager
#
# A profile says what Claude has (MCP servers, permissions, hooks, skills,
# commands, subagents, instructions), symlinked into a project directory. An
# account says who Claude is: an isolated CLAUDE_CONFIG_DIR, so its own login.
# The axes are independent. See readme.md for use, CLAUDE.md for why.
#
# Environment:
#   CLAUDIO_PROFILES  Directory containing profile directories
#                     (default: ~/.claudio/profiles)
#   CLAUDIO_ACCOUNTS  Directory containing account config dirs
#                     (default: ~/.claudio/accounts)
#   CLAUDIO_CONF      Global defaults file (default: ~/.claudio/claudio.conf)
#   CLAUDIO_USER_SETTINGS  Claude Code's own user settings, READ never written
#                     (default: ~/.claude/settings.json)
#   CLAUDIO_MANAGED_SETTINGS  Enterprise managed settings, READ never written
#                     (default: the OS policy path)
#   CLAUDIO_LEGACY    Where claudio USED to keep its data, for `migrate`
#                     (default: ~/.claude — Claude Code's own directory)
#   CLAUDIO_ACCOUNT   Account to use when none is given on the command line
#   CLAUDIO_TAGS      Extra tags, comma separated (k=v,k=v)
#   CLAUDIO_HOST      Machine name for the automatic host= tag
#   CLAUDIO_USAGE_DIR Where the recorder writes and `claudio usage` reads;
#                     exported into the receiver (default: ~/.claudio-usage)
#   CLAUDIO_SELF      The claudio to ask about this machine's config; set by
#                     `claudio usage` so `doctor` diagnoses the claudio that
#                     ran it rather than whichever is first on $PATH
#   CLAUDIO_DOCKER    Docker binary used for docker mcp calls (default: docker)
#   CLAUDIO_GIT       git binary used for the update check (default: git)
#   CLAUDIO_REPO      Repository the update check reads tags from
#   CLAUDIO_UPDATE    0 disables the update machinery entirely (for CI)
#   EDITOR            Editor for `edit` and `mcp <profile> extra` (default: vim)

# This build of claudio, and where newer ones come from. Kept at the very top
# because `claudio --version` is the first question anyone asks of a single
# file they copied to /usr/local/bin, and this is the answer.
VERSION=0.1.0
REPO_URL="${CLAUDIO_REPO:-https://github.com/gabrielbelli/claudio.git}"

# Defined before the storage paths because they are normalised on the way in.
# A trailing slash is invisible to a human and fatal to claudio: every symlink
# test is a literal prefix match on `readlink` output, so CLAUDIO_PROFILES=/p/
# builds links under /p/ while the test compares against "/p//*" and matches
# nothing — `clean` then reports success having removed nothing.
#
# It ASSIGNS $_ns rather than printing it. `x=$(_no_slash …)` is a fork even
# though the body is pure shell, and these run on the way to every command
# including the status line shim below, which Claude Code invokes several times
# a second: the two captures cost ~1 ms of the ~1.2 ms the shim used to spend
# reaching its own dispatch. Measured, see the note on the shim block.
_no_slash() {
  _ns=$1
  while :; do
    case "$_ns" in
      /|'') break ;;
      */)   _ns=${_ns%/} ;;
      *)    break ;;
    esac
  done
}

_no_slash "${CLAUDIO_PROFILES:-$HOME/.claudio/profiles}"; PROFILES_DIR=$_ns
_no_slash "${CLAUDIO_ACCOUNTS:-$HOME/.claudio/accounts}"; ACCOUNTS_DIR=$_ns
GLOBAL_CONF="${CLAUDIO_CONF:-$HOME/.claudio/claudio.conf}"
MARKER=".claudio"
LOCAL_MARKER=".claudio.local"

# --- the status line shim, dispatched early ---
#
# `claudio statusline --shim` is what an account's settings.json runs, so it
# executes on EVERY status line render — several times a second while you type.
# It reads the payload Claude Code pipes in, records a plan-usage sample, and
# hands the identical bytes to the renderer named by `statusline=`.
#
# It is dispatched HERE, above the other ~4 000 lines, and deliberately NOT
# from the `case $CMD in` table at the foot of the file. A POSIX shell parses
# and executes a script file incrementally, so exiting from here never reads
# the rest of it. Medians of 60 runs on this machine, recording off and no
# renderer configured, against the cost of starting the shell at all:
#
#                       dispatched here   from the table   bare shell spawn
#     dash                    2 763 µs         9 084 µs           2 461 µs
#     bash                    6 133 µs        16 353 µs           5 308 µs
#
# So a recording-off render costs ~0.3 ms of claudio under dash and ~0.8 ms
# under bash, against 6.3 ms / 10.2 ms if this were tidied down into
# cmd_statusline. RE-MEASURED at 4 285 lines; the previous figures were taken
# at ~2 600 and are stated here as replaced rather than quietly corrected,
# because a re-baselined number with no note reads like one that was always
# right. The early-exit and floor columns are unchanged within noise and the
# table column has grown with the file, which is the shape the argument
# predicts: the cost is PARSING the rest, so it rises as the file does.
#
# Nothing would FAIL if you moved it — every render would just get slower,
# forever, invisibly. test.sh pins the position with an elapsed-time assertion,
# which is the only shape of test that can catch that.
#
# Recording off is the default and the path optimised for: it reads one config
# key, never touches stdin, never forks jq, and `exec`s the renderer rather
# than waiting on it. Recording on falls through to the rest of the file, which
# it needs anyway, and lands in _u_shim near the bottom.

_u_conf_file() {
  # $1=file, $2 and (optionally) $3, $4 = keys. Sets $_UC to the LAST value of
  # $2 in that file, $_UC2 to the last value of $3 and $_UC3 to the last value
  # of $4, and leaves alone whichever key the file does not mention — so a
  # caller layers by calling in order, narrow before broad. Same line format and
  # same last-wins rule as _conf_values, but read in this shell: no pipeline,
  # no $( ), no fork.
  #
  # THREE keys in ONE traversal, because the shim needs `logging`, the `usage`
  # it replaces and `usage_dir` on every render, and reading them one at a time
  # would open every config file three times. An empty key name is skipped
  # rather than matched: `"$3"=*` with $3 empty is the pattern `=*`, which any
  # line beginning with `=` satisfies, and a key that has already found its
  # value is passed here as an empty name.
  [ -f "$1" ] || return 0
  [ -n "$2$3$4" ] || return 0
  while IFS= read -r _uc_l || [ -n "$_uc_l" ]; do
    case "$_uc_l" in '#'*|'') continue ;; esac
    if [ -n "$2" ]; then
      case "$_uc_l" in "$2"=*) _UC=${_uc_l#"$2"=}; continue ;; esac
    fi
    if [ -n "$3" ]; then
      case "$_uc_l" in "$3"=*) _UC2=${_uc_l#"$3"=}; continue ;; esac
    fi
    if [ -n "$4" ]; then
      case "$_uc_l" in "$4"=*) _UC3=${_uc_l#"$4"=} ;; esac
    fi
  done < "$1"
  return 0
}

_u_conf_next() {
  # False once every key has been answered and no broader layer need be read.
  # A key that HAS a value must not be looked for again further out, and with
  # two keys resolving at different depths that can no longer be an early
  # `return`: blanking the key NAME is how the shared reader is told to stop
  # looking for that one, and it is what keeps a project-level usage_dir from
  # being overwritten by a global usage_dir line in the layer below it.
  [ -z "$_UC" ]  || _uk1=''
  [ -z "$_UC2" ] || _uk2=''
  [ -z "$_UC3" ] || _uk3=''
  [ -n "$_uk1$_uk2$_uk3" ]
}

_u_conf() {
  # $1 and (optionally) $2, $3 = keys. Their layered values land in $_UC, $_UC2
  # and $_UC3. Requires $_U_ACCT and $_U_PROF.
  #
  # This is _telemetry_conf's rule — read the long note there for WHY the
  # account layer is inverted and lives in the global conf only — implemented a
  # second time, fork-free, because _telemetry_conf costs four $( ) captures
  # PER KEY and this runs on every render forever. That is the same trade
  # _stamp_read already makes ("one open, four assignments, zero forks"). The
  # two must agree: test.sh's `logging` precedence tests mirror the `otel` ones
  # case for case, so a change to one rule that is not made to the other fails.
  _UC=''; _UC2=''; _UC3=''
  _uk1=$1; _uk2=${2:-}; _uk3=${3:-}
  if [ -n "$_U_ACCT" ]; then
    _u_conf_file "$GLOBAL_CONF" "account.$_U_ACCT.$_uk1" \
                 "${_uk2:+account.$_U_ACCT.$_uk2}" \
                 "${_uk3:+account.$_U_ACCT.$_uk3}"
    _u_conf_next || return 0
  fi
  _u_conf_file "$LOCAL_MARKER" "$_uk1" "$_uk2" "$_uk3"
  _u_conf_next || return 0
  if [ -n "$_U_PROF" ]; then
    _u_conf_file "$PROFILES_DIR/$_U_PROF/claudio.conf" "$_uk1" "$_uk2" "$_uk3"
    _u_conf_next || return 0
  fi
  _u_conf_file "$GLOBAL_CONF" "$_uk1" "$_uk2" "$_uk3"
  return 0
}

# The two receiver helpers the shim needs on the render path. They live up here
# with _u_conf for the same reason it does — the early block below is the only
# code the recording-off path ever reads — and the rest of the receiver section
# sits with the recorder near the foot of the file.

_recv_alive() {
  # $1 = usage dir. True when the receiver named by <dir>/recv.pid answers
  # `kill -0`. Sets $_RECV_PID and $_RECV_TOKEN from the file.
  #
  # ZERO forks: one open, two `read`s and a `kill`, all builtins. That is the
  # whole budget available on a path Claude Code runs several times a second.
  #
  # Cheap and not exact, deliberately, and the receiver's own contract says so:
  # a recycled pid answers "alive" wrongly, and nothing portable is both cheap
  # and exact (no /proc on macOS; a start time costs a fork). The exactness
  # lives where it can be afforded — `claudio run` asks `ps` once per session,
  # which is precisely when a wrong answer is about to cost a session's records.
  # A graceful exit removes the pidfile, so a stale one means a SIGKILL.
  _RECV_PID=''; _RECV_TOKEN=''
  [ -f "$1/recv.pid" ] || return 1
  { read -r _RECV_PID; read -r _RECV_TOKEN; } < "$1/recv.pid" 2>/dev/null || :
  case $_RECV_PID in ''|*[!0-9]*) _RECV_PID=''; return 1 ;; esac
  kill -0 "$_RECV_PID" 2>/dev/null
}

_recv_target() {
  # $1 = an OTLP endpoint. True when it names THIS machine, and then $_RECV_PORT
  # is the port it asks for (empty means the receiver's own default).
  #
  # Loopback only, and by name. An endpoint on another host is someone else's
  # collector and starting a local receiver for it would be both useless and
  # rude; claudio starts a receiver only for an export aimed at claudio.
  _RECV_PORT=''
  case $1 in http://*) ;; *) return 1 ;; esac
  _rt_a=${1#*://}
  _rt_a=${_rt_a%%/*}
  case $_rt_a in
    127.0.0.1|127.0.0.1:*|localhost|localhost:*|'[::1]'|'[::1]':*) ;;
    *) return 1 ;;
  esac
  case $_rt_a in *:*) _RECV_PORT=${_rt_a##*:} ;; esac
  case $_RECV_PORT in *[!0-9]*) _RECV_PORT='' ;; esac
  return 0
}

if [ "${1:-}" = statusline ] && [ "${2:-}" = --shim ]; then
  # Who is this session? Out here there is no $RUN_ACCT — the shim is a child
  # of Claude Code, not of `claudio run` — so the one thing it can trust is
  # $CLAUDE_CONFIG_DIR, which `run` exported and Claude Code passed on. A
  # directory that is not a direct child of the accounts dir is not a claudio
  # account: `account.<name>.usage` then does not apply and the plain layers
  # decide. That is the honest answer for a session started outside claudio,
  # and it is one reason recording is opt-in rather than on by default.
  _U_ACCT=''
  case "${CLAUDE_CONFIG_DIR:-}" in
    "$ACCOUNTS_DIR"/?*)
      _U_ACCT=${CLAUDE_CONFIG_DIR#"$ACCOUNTS_DIR"/}
      _U_ACCT=${_U_ACCT%/}
      case "$_U_ACCT" in *[/\\]*|.*) _U_ACCT='' ;; esac
      ;;
  esac
  # ...and the profile from the cwd marker, with `read` rather than a `cat`
  # fork. A name that could escape the profiles directory is dropped silently
  # rather than reported: _validate_name exits, and a status line must never
  # fail. The worst a dropped name costs is one config layer.
  _U_PROF=''
  if [ -f "$MARKER" ]; then
    IFS= read -r _U_PROF < "$MARKER" || :
    case "$_U_PROF" in ''|.*|*/*|*\\*|*' '*) _U_PROF='' ;; esac
  fi

  # One layered pass for all three keys the shim needs. usage_dir is resolved
  # HERE rather than inside _u_record because the receiver check below needs it
  # too, and a second pass over the same three files would be the cost this
  # whole block exists to avoid.
  #
  # `logging` is the key; `usage` is the one it replaces, read for one release
  # so an existing machine keeps recording across the upgrade. This is
  # _logging_resolve's rule, second implementation — see the note there, and
  # keep the two in step. Two things it deliberately does NOT do: it never
  # prints (a status line must render, not diagnose, so the deprecation notice
  # is `claudio run`'s to give), and a mode claudio does not know reads as off
  # rather than as a guess.
  _u_conf logging usage usage_dir
  _U_ON=''
  case "$_UC" in
    local|remote) _U_ON=1 ;;
    '') if [ "$_UC2" = 1 ]; then _U_ON=1; fi ;;
  esac
  _U_DIR=$_UC3
  [ -n "$_U_DIR" ] || _U_DIR="$HOME/.claudio-usage"
  # ~/.claude is Claude Code's directory and its layout is Claude Code's to
  # change. Refuse rather than squat, however it was configured; an empty
  # $_U_DIR is what everything downstream reads as "nowhere to write".
  case "$_U_DIR" in "$HOME/.claude"|"$HOME/.claude"/*) _U_DIR='' ;; esac
  # statusline= is global-conf only, like every other machine-level key: it
  # names a command on THIS machine. Read directly rather than through _u_conf.
  _UC=''; _u_conf_file "$GLOBAL_CONF" statusline; _U_CMD=$_UC

  # Is the receiver this session exports to still alive? The shim is the only
  # thing on the machine that runs while a session does, so it is the supervisor
  # — and one render is under a second, well inside Claude Code's exporter retry
  # window, so a receiver that dies is usually replaced before anything is lost.
  #
  # The gate is the ENVIRONMENT, not the config: `claudio run` exports
  # CLAUDE_CODE_ENABLE_TELEMETRY and the endpoint into the environment of the
  # claude it execs, Claude Code passes that on to the status line, and stream A
  # exists in exactly those sessions and nowhere else. So this reads the export
  # that is actually happening rather than re-deriving it from `otel=`, and it
  # costs no config read at all — a session started outside claudio has no
  # stream A, so it has no receiver to keep alive either.
  #
  # Three cheap tests, in the order that makes the common answer the first one:
  # telemetry off (no work), receiver alive (nothing to do), a fault already
  # reported (do not chase it several times a second — the next `claudio run`
  # prints recv.err, and a successful bind clears it). Anything else falls
  # through to the rest of the file, which is where the spawn lives: it is the
  # cold path by construction, and it costs one parse of a file this render was
  # about to need anyway if recording is on.
  _U_SPAWN=''
  if [ "${CLAUDE_CODE_ENABLE_TELEMETRY:-}" = 1 ] && [ -n "$_U_DIR" ] &&
     [ "${OTEL_EXPORTER_OTLP_PROTOCOL:-}" = http/json ] &&
     _recv_target "${OTEL_EXPORTER_OTLP_ENDPOINT:-}"; then
    if ! _recv_alive "$_U_DIR" && [ ! -f "$_U_DIR/recv.err" ]; then _U_SPAWN=1; fi
  fi

  if [ "$_U_ON" != 1 ] && [ -z "$_U_SPAWN" ]; then
    # No renderer configured is not an error: an account wired for recording
    # with nothing to draw is a legitimate silent sensor, and it must print
    # nothing at all rather than a blank line.
    #
    # A bare command word is `exec`ed directly, and only a command LINE goes
    # through a shell. `statusline=claude-statusline` is the documented form,
    # and the shell that saves is a whole process — 2.2 ms under dash, 5.7 ms
    # under bash — on every render. Anything holding a space, a quote, a tilde
    # or any other metacharacter still goes through sh, exactly as Claude Code
    # would have run it.
    if [ -n "$_U_CMD" ]; then
      case $_U_CMD in
        *[!A-Za-z0-9_/.-]*) exec sh -c "$_U_CMD" ;;
        *)                  exec "$_U_CMD" ;;
      esac
    fi
    exit 0
  fi
  # Recording is on, or the receiver needs starting. Everything below is needed
  # now, so fall through to the dispatch table, which routes --shim to _u_shim.
fi

# Update-check bookkeeping: when the last check ran, what it found, and what
# has already been said about it. claudio's own root, alongside the global conf
# and never inside an account dir — that is a CLAUDE_CONFIG_DIR and belongs to
# Claude Code. Derived from GLOBAL_CONF rather than given its own variable so
# that overriding CLAUDIO_CONF moves the stamp with it, which is what keeps the
# test suite hermetic without a fourth path for a new wrapper to forget.
STAMP_FILE="$(dirname "$GLOBAL_CONF")/update-stamp"

# Claude Code's OWN settings file. claudio reads it and never writes it — that
# directory belongs to Claude Code — and only to answer one question: is a
# status line already in effect? (See the statusline section.) The override
# exists so the test suite can answer that question without reading the
# developer's real file, which would make `new` behave differently per machine.
# Deliberately NOT part of the LAYOUT_CUSTOM test below: that flag is about
# where claudio keeps its own data, not about Claude Code's files.
USER_SETTINGS="${CLAUDIO_USER_SETTINGS:-$HOME/.claude/settings.json}"

# Where claudio's data lived before it moved out of Claude Code's directory.
# Read only by `migrate` and its hint; see the migration section near the end.
_no_slash "${CLAUDIO_LEGACY:-$HOME/.claude}"; LEGACY_DIR=$_ns
# Whether the storage layout was overridden. It gates the default project scan:
# if you have told claudio its directories are somewhere unusual, it must not
# go on to assume your projects are in the usual place. This is also what keeps
# the test suite hermetic — it always overrides, so migrate never scans $HOME.
if [ -n "$CLAUDIO_LEGACY$CLAUDIO_PROFILES$CLAUDIO_ACCOUNTS$CLAUDIO_CONF" ]; then
  LAYOUT_CUSTOM=1
else
  LAYOUT_CUSTOM=0
fi

# Literal newline and tab, for building lists in POSIX sh.
NL='
'
TAB=$(printf '\t')

# Maps profile items to their target paths in the project directory.
# Format: profile_item:target_path (one per line)
CONFIG_MAP="
mcp.json:.mcp.json
settings.json:.claude/settings.json
settings.local.json:.claude/settings.local.json
CLAUDE.md:CLAUDE.md
CLAUDE.local.md:CLAUDE.local.md
commands:.claude/commands
skills:.claude/skills
agents:.claude/agents
hooks:.claude/hooks
"

# --- helpers ---

_usage() {
  cat <<'EOF'
claudio — Claude Code profile and account manager

Usage: claudio <command> [args]

Start here:
  account new <name>          Create an account and log in to it
  new <profile> [--manual]    Scaffold a new profile (Docker MCP mode default)
  run [profile] [opts]        Link the profile, set account/tags, launch Claude

Profiles:
  list                        List available profiles (* = active in cwd)
  current                     Print the profile active in cwd
  use <profile>               Link a profile into cwd without launching
  clean                       Deactivate profile, remove symlinks from cwd
  show [profile] [component]  Show a profile's items, or one item's contents
  edit [profile] [component]  Open profile or component in $EDITOR
  init <profile>              Capture current project config as a new profile

Settings:
  default [--account <name>] [--tag k=v]   Save defaults to .claudio.local
  env [profile] [opts]        Print run's environment as export lines
  statusline [--preview | --set <account> | --all]  Status line and plan-usage
                              recording: show, render, or wire into accounts
  usage [args]                Read what was recorded: ingest, show, doctor
  recv [args]                 Run the OTLP receiver in the foreground
  migrate [--dry-run|--undo]  Move claudio's data out of ~/.claude (one-time)
  update [--check]            Check for a newer claudio and say how to get it
  --version                   Print claudio's version
  help                        This text

Accounts (each is an isolated CLAUDE_CONFIG_DIR, so its own login):
  account list                List accounts, login state and logged-in address
  account new <name>          Create an account config dir and log in to it
  account login <name>        Log in again to an existing account
  account path <name>         Print the account's config dir
  account default [<name>]    Show or set the machine-wide default account
  account rm <name>           Delete an account and its stored login
(each account's settings.json runs claudio's status line shim, which records
5-hour/7-day plan usage when logging=local — see `claudio statusline`.)

MCP servers (Docker MCP Toolkit — servers are managed by Docker):
  mcp <profile> add <ref>...  Add server(s); bare refs default to docker://
  mcp <profile> rm <name>...  Remove server(s) from the profile
  mcp <profile> [show]        Show the profile's servers (+ extras)
  mcp <profile> extra         Edit mcp.extra.json for non-Docker MCPs
                              (e.g. remote HTTP servers) merged next to the gateway
  mcp <profile> config ...    Pass through to `docker mcp profile config`
  mcp catalog <oci-ref>       Import a catalog from an OCI reference
  mcp catalog                 List imported catalogs

Options for run/env:
  --account <name>            Which account to run as
  --tag key=value             Extra tag (repeatable)
  --no-telemetry              Do not enable telemetry for this run
  --                          run only: everything after this is passed to claude
(default takes --account and --tag only; telemetry is a config-file setting.)

Profiles and accounts are independent: the same profile runs under any account.
run tags usage automatically: host=, plus profile=/account=/email= when each
resolves. email= is the logged-in address — real PII; override with --tag.

Components for edit/show:
  mcp, settings, local-settings, claude, local-claude,
  commands, skills, agents, hooks

Examples:
  claudio account new work                  # create the account and log in
  claudio new soc                           # scaffold a profile
  claudio mcp soc add ghcr.io/acme/srv:v1   # add an MCP server (via Docker)
  claudio run soc                           # link it and launch Claude
  claudio default --account work            # stop retyping --account here
  claudio run -- -p "fix the bug"           # everything after -- goes to claude
EOF
}

# Sorted names of the immediate subdirectories of $1. Profiles and accounts are
# both "a directory of directories", so they list the same way. A glob over a
# missing directory expands to a literal that [ -d ] rejects, so no guard.
_dirnames() {
  for d in "$1"/*/; do
    [ -d "$d" ] && basename "$d"
  done | sort
}

_profiles() { _dirnames "$PROFILES_DIR"; }

_require_profile() {
  # The empty check stays ahead of _validate_name: its message is lowercase
  # ("profile name required") and the capitalised form is what callers expect.
  [ -z "$1" ] && { echo "Profile name required" >&2; exit 1; }
  _validate_name "$1" profile
  PROFILE_PATH="$PROFILES_DIR/$1"
  if [ ! -d "$PROFILE_PATH" ]; then
    echo "Profile '$1' not found in $PROFILES_DIR" >&2
    # Both hints go to stderr: cmd_env's stdout is meant to be eval'd.
    _avail=$(_profiles)
    if [ -n "$_avail" ]; then
      printf 'Available: %s\n' "$(printf '%s' "$_avail" | tr '\n' ' ')" >&2
    fi
    echo "Create it with: claudio new $1" >&2
    _legacy_hint
    exit 1
  fi
}

# Create the directory for a brand-new profile; sets $profile. Shared by `new`
# and `init` — which is also the one place, alongside _require_profile, where
# profile names are validated before they become path components.
_new_profile_dir() {
  # The empty check stays ahead of _validate_name for the capitalised message.
  [ -z "$1" ] && { echo "Profile name required" >&2; exit 1; }
  _validate_name "$1" profile
  profile="$PROFILES_DIR/$1"
  if [ -d "$profile" ]; then
    echo "Profile '$1' already exists" >&2
    echo "Edit it with: claudio edit $1" >&2
    exit 1
  fi
  mkdir -p "$profile" || exit 1
}

_active_profile() {
  if [ -f "$MARKER" ]; then
    cat "$MARKER"
  fi
}

_is_claudio_link() {
  # Returns 0 if the path is a symlink pointing into the profiles dir
  [ -L "$1" ] || return 1
  _link_dest=$(readlink "$1")
  case "$_link_dest" in
    "$PROFILES_DIR"/*) return 0 ;;
    *) return 1 ;;
  esac
}

_blank_settings_json() {
  # The settings.json a fresh profile gets. $1, when given, is one extra JSON
  # member (already indented, no leading comma) to append inside the object.
  #
  # It takes an argument rather than the caller editing the file afterwards
  # because without jq the only way to add a key to a JSON document is to
  # generate the whole document — so the blank and the with-a-status-line form
  # have to come from one place, or the day someone adds a default permission
  # here the status-line writer silently starts dropping it.
  printf '{\n  "permissions": {\n    "allow": [],\n    "deny": []\n  }'
  if [ -n "$1" ]; then
    printf ',\n%s' "$1"
  fi
  printf '\n}\n'
}

_ensure_profile_items() {
  # Populate any missing items in a profile with sensible blanks so that
  # symlinks are always created and later additions take effect immediately.
  profile="$1"
  echo "$CONFIG_MAP" | while IFS=: read -r item _target; do
    [ -z "$item" ] && continue
    [ -e "$profile/$item" ] && continue
    case "$item" in
      mcp.json)      printf '{\n  "mcpServers": {}\n}\n' > "$profile/$item" ;;
      settings.json) _blank_settings_json > "$profile/$item" ;;
      *.json)        printf '{}\n' > "$profile/$item" ;;
      *.md)          touch "$profile/$item" ;;
      *)             mkdir -p "$profile/$item" ;;
    esac
  done
}

_component_path() {
  case "$1" in
    mcp)            echo "mcp.json" ;;
    settings)       echo "settings.json" ;;
    local-settings) echo "settings.local.json" ;;
    claude)         echo "CLAUDE.md" ;;
    local-claude)   echo "CLAUDE.local.md" ;;
    commands)       echo "commands" ;;
    skills)         echo "skills" ;;
    agents)         echo "agents" ;;
    hooks)          echo "hooks" ;;
    *) echo "Unknown component: $1" >&2; echo "Valid: mcp, settings, local-settings, claude, local-claude, commands, skills, agents, hooks" >&2; exit 1 ;;
  esac
}

# --- Docker MCP Toolkit helpers ---

DOCKER_BIN="${CLAUDIO_DOCKER:-docker}"

_docker_ok() { command -v "$DOCKER_BIN" >/dev/null 2>&1; }

# Run `docker mcp ...` with the configured docker binary.
_dmcp() { "$DOCKER_BIN" mcp "$@"; }

# A profile is in Docker MCP mode if it carries an mcp.docker marker.
_mcp_is_docker() { [ -f "$1/mcp.docker" ]; }

# The Docker MCP profile id backing a claudio profile.
_docker_id() { cat "$1/mcp.docker" 2>/dev/null; }

# (Re)generate a profile's mcp.json: the Docker gateway runner, plus any
# servers hand-kept in mcp.extra.json (for MCPs Docker isn't fit for, e.g.
# remote HTTP endpoints). The extras are merged next to the gateway entry.
_write_gateway_json() {
  # $1 = profile path, $2 = docker profile id
  _wg_extra="$1/mcp.extra.json"
  _wg_out="$1/mcp.json"

  if [ -f "$_wg_extra" ]; then
    if command -v jq >/dev/null 2>&1; then
      _wg_base='{"mcpServers":{"MCP_DOCKER":{"command":"docker","args":["mcp","gateway","run","--profile","'"$2"'"]}}}'
      if printf '%s' "$_wg_base" | jq --slurpfile e "$_wg_extra" \
          '.mcpServers += ($e[0].mcpServers // {})' > "$_wg_out.tmp" 2>/dev/null; then
        mv "$_wg_out.tmp" "$_wg_out"
        return
      fi
      rm -f "$_wg_out.tmp"
      echo "  warning: $_wg_extra is not valid JSON — writing gateway only" >&2
    else
      echo "  warning: $_wg_extra present but jq is not installed — extra MCP servers NOT merged (install jq)" >&2
    fi
  fi
  # Fallback: the gateway runner alone, no extras merged.
  cat > "$_wg_out" <<EOF
{
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run", "--profile", "$2"]
    }
  }
}
EOF
}

# Normalise a server reference: add docker:// scheme to bare image refs.
_mcp_ref() {
  case "$1" in
    *://*) printf '%s' "$1" ;;
    *)     printf 'docker://%s' "$1" ;;
  esac
}

# --- commands ---

# --- accounts & tags ---
#
# Config files (global, profile, project) share one `key=value` line format.
# `tag=` may repeat; every other key takes the last value seen.

_conf_values() {
  # $1=file $2=key. Prints each matching value on its own line.
  [ -f "$1" ] || return 0
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      '#'*|'') continue ;;
      "$2"=*) printf '%s\n' "${_line#"$2"=}" ;;
    esac
  done < "$1"
}

_conf_last() {
  # Last value wins, so a later line overrides an earlier one.
  _conf_values "$1" "$2" | tail -n 1
}

_accounts() { _dirnames "$ACCOUNTS_DIR"; }

_account_dir() { echo "$ACCOUNTS_DIR/$1"; }

_account_exists() { [ -d "$ACCOUNTS_DIR/$1" ]; }

_require_account() {
  [ -n "$1" ] || { echo "Account name required" >&2; exit 1; }
  if ! _account_exists "$1"; then
    echo "Account not found: $1" >&2
    echo "Create it with: claudio account new $1" >&2
    exit 1
  fi
}

_dir_logged_in() {
  # $1 = an account config dir. macOS keeps credentials in the Keychain rather
  # than the config dir, so the presence of oauthAccount in .claude.json is the
  # portable signal. Takes a directory rather than a name because `migrate`
  # asks the same question about accounts that are not in ACCOUNTS_DIR yet.
  # A migrated account is the one case where the marker lies: .claude.json
  # travels with the directory, but on macOS the Keychain entry is named after
  # the OLD path, so the credential is orphaned while the marker still says
  # otherwise. `migrate` drops this file to record that, and it is claudio's
  # own file rather than an edit to Claude Code's JSON — which also means no
  # jq dependency for something that must always work.
  _cj="$1/.claude.json"
  # ...but the flag is only trusted until Claude Code writes the config again.
  # Logging in rewrites .claude.json, so a newer config means the account has
  # been used since the move and the flag has gone stale — including when the
  # login happened outside claudio, which manual bookkeeping alone would miss.
  if [ -f "$1/.claudio-relogin" ] && [ ! "$_cj" -nt "$1/.claudio-relogin" ]; then
    return 1
  fi
  [ -f "$_cj" ] && grep -q '"oauthAccount"' "$_cj" 2>/dev/null
}

_account_logged_in() { _dir_logged_in "$ACCOUNTS_DIR/$1"; }

_dir_email() {
  # $1 = an account config dir. Prints the logged-in address, or nothing.
  # sed rather than jq: jq is optional everywhere else in claudio and this is
  # only a label — a missing address should cost you a column, not the command.
  [ -f "$1/.claude.json" ] || return 0
  sed -n 's/.*"emailAddress"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$1/.claude.json" 2>/dev/null | head -1
}

_validate_name() {
  # Account and profile names become path components, so anything that can
  # escape the parent directory has to be rejected before it reaches rm -rf.
  # A leading dot is rejected along with the traversal cases: _dirnames lists
  # profiles and accounts with a `*/` glob, so a dotted name would create
  # something the tool could never show you again.
  #
  # Dots INSIDE a name are allowed, which in principle lets accounts `my` and
  # `my.acct` share a prefix in the global conf's `account.<name>.<key>` space.
  # Harmless: claudio only ever constructs that key from a resolved account
  # name and looks it up literally — it never parses `account.…` back apart.
  case "$1" in
    '') printf '%s name required\n' "$2" >&2; exit 1 ;;
    .*|*/*|*\\*) printf 'Invalid %s name: %s\n' "$2" "$1" >&2
                 printf 'Names may not start with . or contain / or \\\n' >&2; exit 1 ;;
    -*) printf 'Invalid %s name: %s (may not start with -)\n' "$2" "$1" >&2; exit 1 ;;
  esac
  case "$1" in
    *' '*|*"$(printf '\t')"*)
      printf 'Invalid %s name: %s (may not contain whitespace)\n' "$2" "$1" >&2; exit 1 ;;
  esac
}

_shell_quote() {
  # Quote only when the value needs it, so ordinary output stays readable while
  # anything with whitespace or shell metacharacters is still safe to eval.
  # Embedded single quotes become '\'' .
  case "$1" in
    '') printf "''" ;;
    *[!A-Za-z0-9_/.:=,+-]*)
      printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}

_validate_tag() {
  # OTEL_RESOURCE_ATTRIBUTES is comma separated with no quoting, and Claude
  # Code rejects spaces in values, so reject them here where the error is clear.
  case "$1" in
    *=*) ;;
    *) echo "Tag must be key=value: $1" >&2; exit 1 ;;
  esac
  case "$1" in
    *' '*|*,*) echo "Tag may not contain spaces or commas: $1" >&2; exit 1 ;;
  esac
}

_host_slug() {
  # Machine identity for the automatic `host=` tag, sanitised into a slug.
  #
  # The value is normalised rather than validated-and-rejected because real
  # machine names ("Gabriel's MacBook Pro", "web-01.corp.example.com") would
  # fail _validate_tag: OTEL_RESOURCE_ATTRIBUTES is comma separated with no
  # quoting, and Claude Code rejects spaces. The domain goes because macOS
  # flips between `box.local` and `box.lan` with the network. CLAUDIO_HOST
  # wins outright, for containers where `uname -n` is a random hash.
  # Prints nothing when there is no usable name; the caller omits the tag.
  _h=${CLAUDIO_HOST:-$(uname -n 2>/dev/null)}
  [ -n "$_h" ] || return 0
  _h=${_h%%.*}
  printf '%s' "$_h" | tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9_-]\{1,\}/-/g; s/^-*//; s/-*$//'
}

_merge_tags() {
  # stdin: key=value lines, later wins. stdout: comma-joined, first-seen order.
  awk -F= '
    /^[ \t]*$/ { next }
    { key = $1; val = $0; sub(/^[^=]*=/, "", val)
      if (!(key in seen)) order[++n] = key
      seen[key] = val }
    END { out = ""
      for (i = 1; i <= n; i++) {
        k = order[i]
        out = out (out == "" ? "" : ",") k "=" seen[k]
      }
      print out }'
}

_conf_set() {
  # $1=file $2=key $3=value. Replaces any existing `key=` line, keeping the rest
  # of the file, and writes atomically. Shared by `default` (project file) and
  # `account default` (machine file).
  #
  # It rewrites to a single line rather than appending: `_conf_last` would
  # tolerate duplicate `key=` lines perfectly well, but a file that accumulates
  # a new `account=` on every invocation is unreadable to the human who has to
  # edit it by hand.
  _f=$1; _k=$2; _v=$3
  _d=$(dirname "$_f")
  [ -d "$_d" ] || mkdir -p "$_d" || return 1
  if [ -e "$_f" ]; then
    # Read the old contents before writing: if the file exists but cannot be
    # read, bail rather than truncating the user's settings to a single line.
    [ -r "$_f" ] || { printf 'Cannot read %s\n' "$_f" >&2; return 1; }
    _rest=$(grep -v "^$_k=" "$_f") || _rest=''
  else
    _rest=''
  fi
  # `if` rather than `&&`: a false test would make the group exit non-zero.
  { printf '%s=%s\n' "$_k" "$_v"
    if [ -n "$_rest" ]; then printf '%s\n' "$_rest"; fi
  } > "$_f.tmp" || return 1
  mv "$_f.tmp" "$_f"
}

_resolve_account() {
  # Most specific wins: --account, environment, project, profile, machine-wide
  # default. Empty means "leave CLAUDE_CONFIG_DIR alone", i.e. Claude Code's own
  # default login — which is still the answer when nothing is configured at all.
  #
  # Prints "<source>\t<name>" so the caller can tell the user WHERE the account
  # came from. This runs inside $( ), so a global would not survive.
  if [ -n "$1" ]; then printf 'flag\t%s\n' "$1"; return; fi
  if [ -n "$CLAUDIO_ACCOUNT" ]; then printf 'CLAUDIO_ACCOUNT\t%s\n' "$CLAUDIO_ACCOUNT"; return; fi
  _a=$(_conf_last "$LOCAL_MARKER" account)
  [ -n "$_a" ] && { printf '%s\t%s\n' "$LOCAL_MARKER" "$_a"; return; }
  if [ -n "$2" ]; then
    _a=$(_conf_last "$PROFILES_DIR/$2/claudio.conf" account)
    [ -n "$_a" ] && { printf "profile '%s'\t%s\n" "$2" "$_a"; return; }
  fi
  _a=$(_conf_last "$GLOBAL_CONF" account)
  [ -n "$_a" ] && printf 'machine default\t%s\n' "$_a"
}

_resolve_tags() {
  # $1=profile $2=account $3=extra tags (newline separated).
  # Layered, later wins: auto, global, profile, project, environment, --tag.
  #
  # The auto layer is `profile=`, `account=`, `host=`, `email=`. host= is
  # unconditional (a machine has a name whether or not a profile or account
  # resolved). All four are emitted here, in the bottom layer, so an explicit
  # `--tag host=` or `tag=email=` in a config file still overrides them via
  # _merge_tags.
  #
  # email= is the logged-in address, read from the RESOLVED ACCOUNT's config
  # dir and from nowhere else — there is deliberately no $HOME fallback for
  # the default login; see the note at the read below. It is the identity
  # behind `account=`, which is only a label you chose and which anyone can
  # override with `--tag account=`. Two caveats worth knowing: it is real PII
  # in every exported record, and on a metrics pipeline it becomes a label, so
  # one series per address.
  {
    if [ -n "$1" ]; then echo "profile=$1"; fi
    if [ -n "$2" ]; then echo "account=$2"; fi
    _host=$(_host_slug)
    if [ -n "$_host" ]; then echo "host=$_host"; fi
    # Only for a resolved account. Falling back to $HOME would read Claude
    # Code's own config for the default login, which is not claudio's account
    # to describe — and it would make the test suite read the developer's real
    # home, so results would differ per machine. email= travels with account=.
    if [ -n "$2" ]; then _email=$(_dir_email "$ACCOUNTS_DIR/$2"); else _email=""; fi
    # A space or comma would corrupt OTEL_RESOURCE_ATTRIBUTES, which has no
    # quoting. No real address contains either, but this is parsed out of JSON
    # with sed, so guard rather than trust.
    case "$_email" in *' '*|*,*) _email="" ;; esac
    if [ -n "$_email" ]; then echo "email=$_email"; fi
    # The three config files, broad to narrow, exactly as every other key is
    # resolved. This line's POSITION is the whole of its correctness: below it
    # and a machine-wide `tag=` would beat a profile's, inverting the layering
    # for one key; above the auto block and the automatic host=/email= would
    # beat a global `tag=host=`, breaking the bottom-layer promise. Unguarded
    # like _resolve_account's global read — _conf_values returns 0 on a file
    # that is absent or a $CLAUDIO_CONF that is empty.
    _conf_values "$GLOBAL_CONF" tag
    [ -n "$1" ] && _conf_values "$PROFILES_DIR/$1/claudio.conf" tag
    _conf_values "$LOCAL_MARKER" tag
    [ -n "$CLAUDIO_TAGS" ] && echo "$CLAUDIO_TAGS" | tr ',' "$NL"
    [ -n "$3" ] && printf '%s\n' "$3"
  } | _merge_tags   # _merge_tags already skips blank lines
}

_telemetry_conf() {
  # $1=key $2=profile $3=account.
  # Account (global conf only) beats project, which beats profile, which beats
  # the plain global key.
  #
  # The account layer is deliberately INVERTED relative to every other resolver
  # here (_resolve_account and _resolve_tags both go broad to narrow, most
  # specific wins). Do not "fix" it back: a privacy choice attached to an
  # identity must not be overridable by a file inside a repo, which anyone can
  # have written. `account.personal.otel=0` is a guarantee, not a default —
  # that account never reports, whatever a project checks in. It lives only in
  # the global conf, so all machine-level policy stays readable in one file.
  #
  # No parser change was needed for the dotted key: _conf_values matches with
  # `case "$_line" in "$2"=*)`, and the quoted "$2" is a literal, not a glob —
  # so the dots are unremarkable, `otel` cannot match `account.x.otel=`, and an
  # account named `*` cannot inject a pattern.
  #
  # An unknown account.<x>.<key> is simply inert. Nothing validates it here on
  # purpose: _telemetry_conf is called from _build_env, which runs inside $( ),
  # where an `exit` would be swallowed.
  #
  # Deliberately no environment layer, unlike accounts ($CLAUDIO_ACCOUNT) and
  # tags ($CLAUDIO_TAGS): where your telemetry goes is a property of the machine
  # and the project, not of one shell. `--no-telemetry` is the only per-run
  # override, and it can only turn telemetry off, never point it somewhere new.
  _tc=$(_telemetry_lookup "$1" "$2" "$3")
  [ -n "$_tc" ] || return 0
  printf '%s\n' "${_tc#*"$TAB"}"
}

_telemetry_lookup() {
  # $1=key $2=profile $3=account. Prints `<where>\t<value>` for the layer that
  # decided, or nothing at all when no layer names the key.
  #
  # ONE search order, in ONE place. _telemetry_conf takes the value and
  # _logging_resolve takes the layer, so a remedy can never name a file that
  # did not decide: "turn it on with: logging=local in <global conf>" was
  # printed at a user who already had exactly that line, beaten by an
  # `account.<name>.logging=none` in the same file — advice that is already
  # followed, with no way to reach the line that actually decided.
  #
  # `<where>` is a whole phrase rather than a path, because the account layer's
  # key is not the key the user typed. The tab is safe as a delimiter: the
  # phrase is built here from a key name, a value and a path, and a tab in a
  # config VALUE only ever lands in the last field.
  if [ -n "$3" ]; then
    # Guarded rather than left to build "account..$1" with an empty name: that
    # key is harmless only by luck, and this is the kind of thing that later
    # grows a matching bug in a config file.
    _v=$(_conf_last "$GLOBAL_CONF" "account.$3.$1")
    [ -n "$_v" ] && { printf 'account.%s.%s=%s in %s%s%s\n' "$3" "$1" "$_v" "$GLOBAL_CONF" "$TAB" "$_v"; return; }
  fi
  _v=$(_conf_last "$LOCAL_MARKER" "$1")
  [ -n "$_v" ] && { printf '%s=%s in %s%s%s\n' "$1" "$_v" "$LOCAL_MARKER" "$TAB" "$_v"; return; }
  if [ -n "$2" ]; then
    _v=$(_conf_last "$PROFILES_DIR/$2/claudio.conf" "$1")
    [ -n "$_v" ] && { printf '%s=%s in %s%s%s\n' "$1" "$_v" "$PROFILES_DIR/$2/claudio.conf" "$TAB" "$_v"; return; }
  fi
  _v=$(_conf_last "$GLOBAL_CONF" "$1")
  [ -n "$_v" ] && printf '%s=%s in %s%s%s\n' "$1" "$_v" "$GLOBAL_CONF" "$TAB" "$_v"
  return 0
}

_ship_conf() {
  # $1=key ($ship_url|$ship_token) $2=account. GLOBAL CONF ONLY, and only ever
  # under an `account.<name>.` prefix — there is deliberately NO plain
  # `ship_url` key at any layer.
  #
  # This is _telemetry_conf's account inversion taken to its conclusion. That
  # helper still falls through to the project file, the profile conf and the
  # plain global key when no account layer names the key; here there is
  # nothing to fall through TO, on purpose. A destination is the one setting
  # where the broad layers are not a convenience but a hole: a `.claudio.local`
  # or a profile `claudio.conf` inside a repository someone else wrote would
  # otherwise be able to name where this machine's telemetry is posted, and
  # `logging=remote` on a work account means an employer's server. The keys
  # live in the user's own file or they do not exist.
  #
  # Fail closed follows from that: an account with no ship_url ships NOTHING,
  # and _logging_resolve names it rather than letting `logging=remote` read as
  # shipping. usage/cu/ship.py reads exactly these two keys, from exactly this
  # file, with exactly this rule.
  [ -n "$2" ] || return 0
  _conf_last "$GLOBAL_CONF" "account.$2.$1"
}

# The keys `logging=` replaces. Read for one release, with a warning, then
# deleted — see _logging_resolve. Named once, here, because test.sh derives the
# list from this line and checks that every doc marks exactly these deprecated:
# a hardcoded copy in the suite would just be a fourth place to forget.
LOGGING_LEGACY="otel usage"

_logging_resolve() {
  # $1=profile $2=account. ONE key where there were three. Sets, in the
  # caller's shell:
  #   _LG_MODE  the configured mode: none|local|remote, or '' when unset
  #   _LG_OTEL  1 when stream A (Claude Code's OTLP export) should be on
  #   _LG_USE   1 when stream B (plan-usage recording) should be on
  #   _LG_NOTE  a diagnostic for the caller to print, or ''
  #   _LG_WHY   the layer that decided the mode, as a phrase naming the key,
  #             the value and the file — or '' when no layer names `logging`
  #
  # `remote` IMPLIES local — the file is written either way. A
  # remote-without-local mode was considered and dropped: it saves a rotating
  # 32MB file and buys a state where a healthy setup is indistinguishable from
  # a broken one, which needed a disclaimer to be legible at all.
  #
  # Layering is _telemetry_conf's, inversion and all, so
  # `account.<name>.logging=none` is exactly the guarantee
  # `account.<name>.otel=0` was: read from the GLOBAL conf only, beating
  # project, profile and the plain key alike, because a privacy or reporting
  # choice attached to an identity must not be overridable by a file inside a
  # repo someone else wrote. The shim implements the same rule fork-free in
  # _u_conf; test.sh mirrors the `otel` precedence cases onto both.
  _LG_MODE=''; _LG_OTEL=''; _LG_USE=''; _LG_NOTE=''; _LG_WHY=''
  # One lookup, giving both the value and the layer that produced it. The layer
  # is what makes a remedy honest — see _telemetry_lookup.
  _lg_l=$(_telemetry_lookup logging "$1" "$2")
  _lg_v=''
  if [ -n "$_lg_l" ]; then _lg_v=${_lg_l#*"$TAB"}; _LG_WHY=${_lg_l%%"$TAB"*}; fi
  # The old keys are read even when `logging` is set, and that is the point:
  # "your otel=1 is being ignored" has to be said out loud. A key silently
  # dropped is this project's cardinal sin, and a deprecation is precisely the
  # moment it happens.
  _lg_o=$(_telemetry_conf otel "$1" "$2")
  _lg_u=$(_telemetry_conf usage "$1" "$2")
  if   [ -n "$_lg_o" ] && [ -n "$_lg_u" ]; then _lg_old='otel= and usage= are'
  elif [ -n "$_lg_o" ]; then _lg_old='otel= is'
  elif [ -n "$_lg_u" ]; then _lg_old='usage= is'
  else _lg_old=''
  fi

  case "$_lg_v" in
    none)         _LG_MODE=none ;;
    local|remote) _LG_MODE=$_lg_v; _LG_OTEL=1; _LG_USE=1 ;;
    '') ;;
    *)
      # A value claudio does not know is not licence to guess. Guessing `local`
      # turns on something nobody asked for; guessing `none` and saying nothing
      # is the silent loss this whole project is about. So: off, and named.
      #
      # And named TOGETHER WITH what it retired. This branch used to `return 0`
      # here, jumping over both the fallback below and the retirement notice —
      # so a user who fat-fingered `logging=lokal` while still carrying otel=1
      # lost their export and was told only about the typo. The reasonable
      # reading of "claudio does not know that value" is that the previous
      # configuration still stands, and it did not. The clause is APPENDED
      # rather than reached by falling through: the `elif` below replaces the
      # note wholesale and would name `logging=none`, a mode nobody wrote.
      _LG_MODE=none
      _LG_NOTE="logging=$_lg_v is not a value claudio knows (none|local|remote) — logging is off"
      if [ -n "$_lg_old" ]; then
        _LG_NOTE="$_LG_NOTE, and the deprecated $_lg_old ignored — delete it."
      fi
      return 0 ;;
  esac


  if [ -z "$_LG_MODE" ]; then
    # No `logging=` at any layer, so the keys it replaces still decide — and
    # they decide independently of each other, exactly as they did before, so
    # an existing machine behaves identically across the upgrade.
    if [ "$_lg_o" = 1 ]; then _LG_OTEL=1; fi
    if [ "$_lg_u" = 1 ]; then _LG_USE=1; fi
    if [ -n "$_lg_old" ]; then
      _LG_NOTE="$_lg_old deprecated — use logging=none|local|remote. Still read in this release; the next will not."
    fi
  elif [ -n "$_lg_old" ]; then
    # ONE rule, not a per-layer merge: `logging=` anywhere retires the old keys
    # everywhere, account-level ones included. A merge would leave a config in
    # which some old lines still bite and some do not, which nobody can reason
    # about; and the direction chosen has to be the one that cannot make
    # `logging=local` quietly do nothing — a feature that reads as enabled and
    # records nothing is this project's cardinal sin. The price is that an
    # `account.<name>.otel=0` stops applying the moment `logging=` appears, so
    # it is named on stderr on every run until the line is gone.
    _LG_NOTE="logging=$_LG_MODE is set, so the deprecated $_lg_old ignored — delete it."
  fi

  # `remote` ships now — usage/cu/ship.py, ticking inside the receiver — so
  # what has to be said out loud is no longer "nothing ships", it is every
  # state in which the user believes shipping is happening and it is not.
  # There are exactly three, and all three are silent without this block:
  #
  #   no account resolved   destinations are keyed by account and there is no
  #                         account, so no destination can be found at all;
  #   no ship_url           the mode says remote and nothing names where;
  #   the mode came from a  the shipper is a machine-wide receiver with no cwd
  #   project/profile file  and no profile, so it reads the mode from the
  #                         global conf only and cannot honour that layer.
  #
  # Silence is reserved for the one case that is actually working. Appended
  # rather than assigned, because a deprecated key being retired at the same
  # time is a separate thing the user must hear.
  if [ "$_LG_MODE" = remote ]; then
    _lg_r=''
    if [ -z "$2" ]; then
      _lg_r="logging=remote, but no account resolved — destinations are configured per account (account.<name>.ship_url in $GLOBAL_CONF), so nothing is shipped."
    elif [ -z "$(_ship_conf ship_url "$2")" ]; then
      _lg_r="logging=remote, but account $2 has no destination — set account.$2.ship_url=<url> in $GLOBAL_CONF. Records are kept locally; nothing is shipped."
    else
      # Quoted in the pattern, so the path is a literal and a glob character
      # in it cannot widen the match — the same reason _conf_values quotes its.
      case "$_LG_WHY" in
        *" in $GLOBAL_CONF") ;;
        *) _lg_r="logging=remote comes from $_LG_WHY, and the shipper reads the mode from $GLOBAL_CONF only — nothing is shipped. Put logging=remote, or account.$2.logging=remote, in $GLOBAL_CONF." ;;
      esac
    fi
    if [ -n "$_lg_r" ]; then
      if [ -n "$_LG_NOTE" ]; then _LG_NOTE="$_LG_NOTE $_lg_r"; else _LG_NOTE=$_lg_r; fi
    fi
  fi
  return 0
}

_build_env() {
  # $1=profile $2=account $3=extra tags $4=no_telemetry.
  # Prints `NAME=value` lines for the caller to export.
  if [ -n "$2" ]; then
    _require_account "$2"
    echo "CLAUDE_CONFIG_DIR=$(_account_dir "$2")"
  fi

  _tags=$(_resolve_tags "$1" "$2" "$3")
  # Harmless when telemetry is off: nothing reads it unless an exporter is set.
  [ -n "$_tags" ] && echo "OTEL_RESOURCE_ATTRIBUTES=$_tags"

  # "$2" is the resolved account, already validated by _require_account above.
  _logging_resolve "$1" "$2"
  # ABOVE the --no-telemetry return, on purpose. The note is about a config
  # file that is going to stop working, not about this run's export, and
  # `--no-telemetry` silences one run's telemetry — not claudio's diagnostics.
  # stderr, like every other diagnostic on the run/env path: cmd_env's stdout
  # is meant to be eval'd.
  if [ -n "$_LG_NOTE" ]; then printf 'claudio: %s\n' "$_LG_NOTE" >&2; fi

  # Above every line that acts on $_LG_OTEL, so --no-telemetry beats even an
  # account.<x>.logging=remote: the flag can always silence a single run,
  # whatever the layers agreed on.
  [ "$4" = 1 ] && return 0
  [ "$_LG_OTEL" = 1 ] || return 0

  # The defaults are what claudio's OWN receiver can serve: OTLP/HTTP JSON on
  # 4318. They used to be `grpc` and 4317 — the Docker collector's shape — and
  # since `run` starts a receiver only for an http/json loopback export, the
  # documented opt-in (`otel=1` and nothing else) enabled telemetry, started
  # nothing, and exported every record to a port with nothing behind it. Claude
  # Code's exporter drops that in silence by design, so the default experience
  # of the feature was the exact failure this project calls its cardinal sin.
  # Anyone pointing claudio at their own collector was already setting both
  # keys; the default is now the case claudio can actually make work.
  _proto=$(_telemetry_conf otel_protocol "$1" "$2"); [ -n "$_proto" ] || _proto=http/json
  _ep=$(_telemetry_conf otel_endpoint "$1" "$2"); [ -n "$_ep" ] || _ep="http://localhost:4318"
  echo "CLAUDE_CODE_ENABLE_TELEMETRY=1"
  echo "OTEL_METRICS_EXPORTER=otlp"
  echo "OTEL_LOGS_EXPORTER=otlp"
  echo "OTEL_EXPORTER_OTLP_PROTOCOL=$_proto"
  echo "OTEL_EXPORTER_OTLP_ENDPOINT=$_ep"
}

cmd_list() {
  profiles=$(_profiles)
  if [ -z "$profiles" ]; then
    echo "No profiles found in $PROFILES_DIR"
    echo "Create one with: claudio new <name>"
    _legacy_hint
    exit 0
  fi
  active=$(_active_profile)
  echo "Available profiles:"
  echo "$profiles" | while read -r p; do
    if [ "$p" = "$active" ]; then
      echo "  * $p  (active)"
    else
      echo "    $p"
    fi
  done
}

cmd_use() {
  _require_profile "$1"
  profile_name="$1"
  shift
  # `use` links and nothing else, so anything left over is a mistake worth
  # naming: the command that does take claude arguments is `run`.
  if [ $# -gt 0 ]; then
    printf 'Unexpected argument: %s\n' "$1" >&2
    printf 'use only links the profile. To launch Claude Code: claudio run %s\n' "$profile_name" >&2
    exit 1
  fi

  # Clean existing profile first if one is active
  if [ -f "$MARKER" ]; then
    _do_clean
  fi

  mkdir -p .claude
  _ensure_profile_items "$PROFILE_PATH"

  # In Docker MCP mode, keep the gateway-runner mcp.json in sync with the id.
  if _mcp_is_docker "$PROFILE_PATH"; then
    _write_gateway_json "$PROFILE_PATH" "$(_docker_id "$PROFILE_PATH")"
  fi

  echo "$CONFIG_MAP" | while IFS=: read -r item target; do
    [ -z "$item" ] && continue
    src="$PROFILE_PATH/$item"

    # Check for conflicts
    if [ -e "$target" ] || [ -L "$target" ]; then
      if _is_claudio_link "$target"; then
        rm "$target"
      else
        echo "  warning: $target already exists and is not a claudio symlink, skipping" >&2
        continue
      fi
    fi

    case "$target" in */*) mkdir -p "${target%/*}" ;; esac
    ln -s "$src" "$target"
  done

  echo "$profile_name" > "$MARKER"
  echo "Activated profile '$profile_name' in $(pwd)"
  if _mcp_is_docker "$PROFILE_PATH"; then
    echo "  MCP via Docker MCP Toolkit (docker profile: $(_docker_id "$PROFILE_PATH"))"
  fi
  echo "Launch it with: claudio run"
}

cmd_clean() {
  if [ ! -f "$MARKER" ]; then
    echo "No active profile in current directory"
    exit 0
  fi
  # Captured, not streamed: _do_clean's loop runs in a subshell (`echo |
  # while`), so a counter incremented inside it would not survive. stdout is
  # the only channel that crosses that boundary — and knowing whether anything
  # was actually removed is the whole point. "Profile deactivated" printed over
  # a directory full of untouched symlinks is the exact silent-success failure
  # this tool exists to avoid.
  _cleaned=$(_do_clean)
  if [ -n "$_cleaned" ]; then
    printf '%s\n' "$_cleaned"
    echo "Profile deactivated"
    return 0
  fi

  echo "Profile deactivated (no claudio symlinks found to remove)"
  # The usual cause is claudio's data having moved: the links are still there,
  # still pointing at the old location, and no longer recognised as claudio's.
  _stale=$(_legacy_links .)
  if [ -n "$_stale" ]; then
    printf 'This directory still has %s symlink(s) pointing at claudio'"'"'s old location:\n' \
      "$(_count_lines "$_stale")"
    printf '%s\n' "$_stale" | sed 's|^\./|  |'
    echo "Repoint them with: claudio migrate --scan ."
  else
    _legacy_hint
  fi
}

_do_clean() {
  echo "$CONFIG_MAP" | while IFS=: read -r item target; do
    [ -z "$item" ] && continue
    if _is_claudio_link "$target"; then
      rm "$target"
      echo "  removed $target"
    fi
  done

  rm -f "$MARKER"

  # Remove .claude/ if empty
  [ -d ".claude" ] && rmdir ".claude" 2>/dev/null || true
}

# --- update checking ---
#
# Two rules shape everything here.
#
# 1. `claudio run` must NEVER wait on the network. It reads one small stamp
#    file, and if that file is stale it forks a detached refresh and carries on.
#    The refresh is a redirected COMPOUND command — `{ _update_refresh; }
#    >/dev/null 2>&1 </dev/null &`, braces included: that is not hygiene, it
#    is load-bearing, and the plain form is the bug rather than the fix. A
#    background child that inherits stdout makes any `out=$(claudio run …)`
#    capture block until the child exits AND swallow its output into the
#    capture — measured at 3s. See the full note at the fork itself.
# 2. It notifies once per NEW VERSION, not once per run. `notified=` in the
#    stamp is what keeps a message that would otherwise fire sixty times a day
#    a signal rather than wallpaper.
#
# The whole thing is opt-in with three states, held in `update_check=` in the
# global conf: unset means "not offered yet" (print the offer once, to stderr,
# never prompt — `run` must not block), 1 means enabled, 0 means declined and
# never mentioned again. `offered=` lives in the stamp rather than in the conf
# because the conf is the USER's file: claudio's own bookkeeping does not
# belong in it, and a three-state choice the user typed should not be a line
# claudio scribbled.
#
# This section sits beside the status line rather than up with the config
# helpers because both are self-contained features that only READ the config
# layers; nothing else in claudio calls into either.

GIT_BIN="${CLAUDIO_GIT:-git}"

_update_off() {
  # The single kill switch, for CI and for the test suite. Checked before any
  # file is opened, so a disabled claudio costs nothing at all.
  [ "$CLAUDIO_UPDATE" = 0 ]
}

_now() {
  # Seconds since the epoch, or 0 when `date +%s` is unavailable or odd.
  # 0 is read as "cannot tell the time" by the one caller that does arithmetic,
  # which then skips the refresh rather than subtracting from an empty string —
  # that would abort dash outright.
  _n=$(date +%s 2>/dev/null)
  case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
  printf '%s' "$_n"
}

_stamp_read() {
  # Fills STAMP_CHECKED/LATEST/NOTIFIED/OFFERED from $STAMP_FILE.
  #
  # Same `key=value` line format as the three config files, read the same way,
  # so no parser and no jq. Deliberately NOT _conf_last: that is
  # `_conf_values | tail`, i.e. a subshell and a fork per key, and this runs on
  # the way to `exec claude`. One open, four assignments, zero forks.
  STAMP_CHECKED=0; STAMP_LATEST=""; STAMP_NOTIFIED=""; STAMP_OFFERED=""
  [ -f "$STAMP_FILE" ] || return 0
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      checked=*)  STAMP_CHECKED=${_line#checked=} ;;
      latest=*)   STAMP_LATEST=${_line#latest=} ;;
      notified=*) STAMP_NOTIFIED=${_line#notified=} ;;
      offered=*)  STAMP_OFFERED=${_line#offered=} ;;
    esac
  done < "$STAMP_FILE"
  # A hand-edited or half-written stamp must not be able to break `run`:
  # $((_now - "soon")) is a fatal error in dash, not a zero.
  case "$STAMP_CHECKED" in ''|*[!0-9]*) STAMP_CHECKED=0 ;; esac
  return 0
}

_stamp_write() {
  # $1=checked $2=latest $3=notified $4=offered. All four every time, so the
  # file cannot drift into a half-state.
  #
  # Best effort by design: this is bookkeeping for a feature nobody asked for
  # in the middle of launching Claude Code, so a read-only directory must cost
  # a lost check, never a failed run. Hence every failure path returns 0.
  #
  # A unique temp name, unlike _conf_set's fixed "$_f.tmp": two terminals can
  # launch at once, and with a shared temp name one would truncate the other's
  # file mid-write. With $$ the loser's write is merely redundant.
  _st_d=$(dirname "$STAMP_FILE")
  [ -d "$_st_d" ] || mkdir -p "$_st_d" 2>/dev/null || return 0
  _st_t="$STAMP_FILE.$$"
  { printf 'checked=%s\n'  "$1"
    printf 'latest=%s\n'   "$2"
    printf 'notified=%s\n' "$3"
    printf 'offered=%s\n'  "$4"
  } > "$_st_t" 2>/dev/null || { rm -f "$_st_t"; return 0; }
  mv "$_st_t" "$STAMP_FILE" 2>/dev/null || rm -f "$_st_t"
  return 0
}

_ver_gt() {
  # True when $1 is strictly newer than $2. Dotted numeric, leading v ignored.
  #
  # awk rather than `sort -V`: BSD sort (macOS) has no -V, and claudio is a
  # POSIX sh script with no coreutils-GNU assumption anywhere else. A component
  # that is not a number reads as 0, so a `1.2.0-rc1` tag compares equal to
  # 1.2.0 and never announces itself as newer — the conservative direction.
  [ -n "$1" ] || return 1
  awk -v a="${1#v}" -v b="${2#v}" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".")
    n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) {
      ai = (i <= na ? x[i] + 0 : 0)
      bi = (i <= nb ? y[i] + 0 : 0)
      if (ai > bi) exit 0
      if (ai < bi) exit 1
    }
    exit 1
  }'
}

_self_path() {
  # The real path of this script, symlinks resolved. `readlink -f` is GNU-only
  # (BSD readlink has no -f worth relying on), so the hops are walked by hand,
  # bounded at 20 so a symlink cycle cannot spin forever. `cd … && pwd -P` at
  # the end normalises the result, which also collapses the /opt/homebrew/bin/..
  # that a Homebrew shim introduces — the Cellar test below depends on it.
  _sp_p=$0
  case "$_sp_p" in
    */*) ;;
    *)   _sp_p=$(command -v "$_sp_p" 2>/dev/null) ;;
  esac
  [ -n "$_sp_p" ] || return 1
  _sp_n=0
  while [ -L "$_sp_p" ] && [ "$_sp_n" -lt 20 ]; do
    _sp_t=$(readlink "$_sp_p" 2>/dev/null) || break
    [ -n "$_sp_t" ] || break
    case "$_sp_t" in
      /*) _sp_p=$_sp_t ;;
      *)  _sp_p="$(dirname "$_sp_p")/$_sp_t" ;;
    esac
    _sp_n=$((_sp_n + 1))
  done
  _sp_d=$(cd "$(dirname "$_sp_p")" 2>/dev/null && pwd -P) || return 1
  [ -n "$_sp_d" ] || return 1
  printf '%s/%s\n' "$_sp_d" "$(basename "$_sp_p")"
}

_brew_ctx() {
  # Prints "<brew prefix>\t<installed version>" when this claudio lives under a
  # Homebrew Cellar, or fails.
  #
  # Detected from the filesystem rather than by asking brew: `brew --prefix`
  # takes about 2.9 seconds to start (it is Ruby), and this path is read on the
  # way to launching Claude Code. Reading the directory name takes 0.007s.
  # The trade is a false positive for a hand-built tree that happens to be laid
  # out as .../Cellar/claudio/<version>/..., which costs one wrong sentence.
  _bc_p=$(_self_path) || return 1
  case "$_bc_p" in
    */Cellar/claudio/*)
      _bc_rest=${_bc_p#*/Cellar/claudio/}
      printf '%s\t%s\n' "${_bc_p%%/Cellar/claudio/*}" "${_bc_rest%%/*}"
      ;;
    *) return 1 ;;
  esac
}

_brew_tap_version() {
  # $1 = brew prefix. The version the tap formula offers, or nothing.
  # Three ways to write it, tried in order: an explicit `version "x"`, a
  # `tag: "vx"` on a git url, or the /tags/vX.tar.gz in a tarball url.
  # An unmatched glob stays literal under sh, and [ -f ] rejects it, so the
  # loop needs no nullglob and no guard.
  for _bt_f in "$1"/Library/Taps/*/*/claudio.rb "$1"/Library/Taps/*/*/Formula/claudio.rb; do
    [ -f "$_bt_f" ] || continue
    _bt_v=$(sed -n 's/^[[:space:]]*version[[:space:]]*"\([^"]*\)".*/\1/p' "$_bt_f" | head -1)
    [ -n "$_bt_v" ] || _bt_v=$(sed -n 's/.*tag:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' "$_bt_f" | head -1)
    [ -n "$_bt_v" ] || _bt_v=$(sed -n 's|.*/tags/v\{0,1\}\([0-9][^"/]*\)\.tar\.gz.*|\1|p' "$_bt_f" | head -1)
    if [ -n "$_bt_v" ]; then printf '%s\n' "$_bt_v"; return 0; fi
  done
  return 1
}

_update_fetch() {
  # THE ONLY PLACE claudio touches the network, and it must stay that way: the
  # test suite asserts against this file that `ls-remote` appears exactly once
  # and only ever behind "$GIT_BIN", which is what stops a future second fetch
  # site from escaping the stub.
  #
  # `git ls-remote` and not `gh`: gh would be a new dependency that needs auth,
  # and a public repo's tags need neither a clone nor a login. The https URL
  # rather than git@github.com so no SSH agent is required. The hang is bounded
  # with git's own low-speed options because macOS ships no timeout(1).
  # Kept on ONE line so the invariant above is a grep anyone can run.
  "$GIT_BIN" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 ls-remote --tags --refs "$REPO_URL" 2>/dev/null
}

_latest_tag() {
  # The newest release tag in the remote, or nothing at all.
  #
  # "Nothing at all" is the current reality, not a theoretical branch: the repo
  # has no tags yet, so every caller has to treat empty as "cannot compare"
  # rather than "up to date". Saying "up to date" on no evidence is how an
  # update check earns being ignored forever.
  _lt_best=""
  for _lt_t in $(_update_fetch | sed -n 's|.*refs/tags/||p'); do
    # Only version-shaped tags: a `nightly` or `latest` tag would compare as 0
    # and could otherwise win by being the first one seen.
    case "$_lt_t" in v[0-9]*|[0-9]*) ;; *) continue ;; esac
    if [ -z "$_lt_best" ] || _ver_gt "$_lt_t" "$_lt_best"; then _lt_best=$_lt_t; fi
  done
  printf '%s' "$_lt_best"
}

_update_refresh() {
  # The detached half: fetch, then stamp. Always stamps `checked`, success or
  # not, so being offline costs one failed attempt a DAY rather than one per
  # run. A failed fetch keeps the previously known `latest` rather than
  # forgetting it, so a notification is not lost to a flaky network.
  _stamp_read
  _ur_latest=$(_latest_tag)
  [ -n "$_ur_latest" ] || _ur_latest=$STAMP_LATEST
  _stamp_write "$(_now)" "$_ur_latest" "$STAMP_NOTIFIED" "$STAMP_OFFERED"
}

_update_how() {
  # How to actually get the new version, which depends on how this one arrived.
  if _brew_ctx >/dev/null 2>&1; then
    echo "  Upgrade with: brew upgrade claudio"
  else
    printf '  Get it from:  %s\n' "${REPO_URL%.git}"
    # Byte-for-byte the readme's Installation line, and pinned to it by a test.
    # Two spellings of the same install read as one of them being stale and the
    # reader cannot tell which.
    #
    # `make install` and NOT a copy of this one file. claudio stopped being one
    # file when `claudio usage` and `claudio recv` moved in beside it: a copied
    # script finds no Python, so both verbs fail — and the receiver they drive
    # is what stream A is exported to, so the failure is a silently empty
    # ledger rather than an error anybody sees.
    echo "  Then:         cd claudio && sudo make install"
  fi
}

_update_offer() {
  # Printed once, ever, to stderr, and it does not prompt: `run` is on its way
  # to exec and must not stop to ask a question. Both answers are one line to
  # paste, and the "never" answer is offered as plainly as the "yes" one.
  _stamp_read
  if [ -n "$STAMP_OFFERED" ]; then return 0; fi
  echo "claudio can check for a newer version (once a day, in the background)." >&2
  printf '  Yes:   echo update_check=1 >> %s\n' "$GLOBAL_CONF" >&2
  printf '  Never: echo update_check=0 >> %s   (you will not see this again either way)\n' "$GLOBAL_CONF" >&2
  _stamp_write "$STAMP_CHECKED" "$STAMP_LATEST" "$STAMP_NOTIFIED" 1
}

_update_notice() {
  # Called by `run`, just before exec. Everything here is either a variable
  # test or one file read; the only fork on the enabled path is `date`, and the
  # only fork on the disabled paths is none.
  if _update_off; then return 0; fi
  case "$(_conf_last "$GLOBAL_CONF" update_check)" in
    0) return 0 ;;                      # declined: never mentioned again
    1) ;;                               # enabled
    *) _update_offer; return 0 ;;       # not offered yet: offer, never fetch
  esac

  _stamp_read
  if [ -n "$STAMP_LATEST" ] && [ "$STAMP_LATEST" != "$STAMP_NOTIFIED" ] &&
     _ver_gt "$STAMP_LATEST" "$VERSION"; then
    printf 'claudio %s is available (you have %s)\n' "$STAMP_LATEST" "$VERSION" >&2
    _update_how >&2
    printf '  Silence it:   echo update_check=0 >> %s\n' "$GLOBAL_CONF" >&2
    # Recorded immediately, so this is said once per version and not once per
    # run — the difference between a notice and wallpaper.
    _stamp_write "$STAMP_CHECKED" "$STAMP_LATEST" "$STAMP_LATEST" "$STAMP_OFFERED"
  fi

  # Last, so the fork lands as close to `exec claude` as it can and any cost is
  # attributable to this line alone. 86400 = a day.
  _un_now=$(_now)
  if [ "$_un_now" != 0 ] && [ $((_un_now - STAMP_CHECKED)) -ge 86400 ]; then
    # The braces are load-bearing, not decoration. Redirecting a plain
    # background command — `_update_refresh >/dev/null 2>&1 &` — leaks the
    # inherited stdout under dash: dash saves the original descriptor to a high
    # fd so it can restore it, and that copy survives into the child. The pipe
    # of any `out=$(claudio run …)` then stays open, so the capture BLOCKS until
    # the refresh finishes (measured: 3s) even though its output goes nowhere.
    # Redirecting a compound command takes dash's other path and closes it.
    # Verified under both shells: 0s, and the stamp is still written afterwards.
    { _update_refresh; } >/dev/null 2>&1 </dev/null &
  fi
  return 0
}

cmd_update() {
  # Reports; it does not install. Something owns this install — brew, a
  # distribution package, or `make install` from a checkout, very possibly with
  # sudo — and the honest thing is to name that command rather than to rewrite
  # a binary out from under it. Nor is there one file to rewrite any more:
  # _update_how already says so, and `bin/claudio` without the matching
  # `libexec/claudio/` is a claudio whose two telemetry verbs cannot find
  # themselves.
  _up_check=0
  for _up_a in "$@"; do
    case "$_up_a" in
      --check) _up_check=1 ;;
      *) printf 'Unknown option: %s\n' "$_up_a" >&2
         echo "Valid: --check" >&2
         exit 1 ;;
    esac
  done

  if _update_off; then
    echo "Update checking is disabled (CLAUDIO_UPDATE=0)."
    return 0
  fi

  printf 'claudio %s\n' "$VERSION"

  # Homebrew owns both the install and the version list, so defer to it
  # entirely rather than comparing against a git tag it may not have built yet.
  if _up_ctx=$(_brew_ctx); then
    _up_pfx=${_up_ctx%%"$TAB"*}
    _up_inst=${_up_ctx#*"$TAB"}
    printf 'Installed with Homebrew (%s/Cellar/claudio/%s)\n' "$_up_pfx" "$_up_inst"
    if _up_tap=$(_brew_tap_version "$_up_pfx"); then
      if _ver_gt "$_up_tap" "$_up_inst"; then
        printf 'The tap offers %s.\n' "$_up_tap"
        echo "  Upgrade with: brew upgrade claudio"
      else
        printf 'The tap offers %s.\n' "$_up_tap"
      fi
    else
      # Honest about not knowing, rather than inventing a comparison.
      printf 'Cannot read a claudio formula under %s/Library/Taps.\n' "$_up_pfx"
      echo "  Check with:   brew update && brew upgrade claudio"
    fi
    return 0
  fi

  _stamp_read
  _up_latest=$(_latest_tag)
  if [ -z "$_up_latest" ]; then
    printf 'No releases are tagged yet in %s — nothing to compare against.\n' "${REPO_URL%.git}"
    echo "Until the first release is tagged this check can only ever say this."
  elif _ver_gt "$_up_latest" "$VERSION"; then
    printf '%s is available.\n' "$_up_latest"
    _update_how
  else
    printf 'Up to date (newest release is %s).\n' "$_up_latest"
  fi

  # --check reports and changes nothing, including the stamp. A plain `update`
  # is a real check, so it records one — and records that the answer has been
  # seen, or `run` would repeat it on the next launch.
  if [ "$_up_check" = 0 ]; then
    _stamp_write "$(_now)" "$_up_latest" "$_up_latest" "$STAMP_OFFERED"
  fi
  return 0
}

# --- status line ---
#
# What gets registered with Claude Code is claudio's own shim, `claudio
# statusline --shim`, and never the renderer directly. The shim records a
# plan-usage sample and forwards the payload to the command named by
# `statusline=` — see the early-dispatch block at the top of this file for the
# shim itself, and the usage-recording section below for what it records.
#
# `statusline=<command>` lives in the GLOBAL conf and nowhere else: it names a
# command on this machine, so it is machine-level policy by nature. claudio
# ships no renderer and hardcodes no path.
#
# It is registered against ACCOUNTS, not profiles, and that is the whole point
# of this section. An account IS a CLAUDE_CONFIG_DIR, so
# <account>/settings.json is the USER-level settings file for every session run
# under that account — recording therefore follows the identity, into any
# directory, with or without a profile, which is right because the 5-hour and
# 7-day quota is account-wide.
#
# A profile must never write one. A profile's settings.json is symlinked to
# .claude/settings.json, which is PROJECT level, and Claude Code resolves
# project ahead of user: a profile-written status line would shadow the account
# shim and silently stop recording in exactly the projects you work in most.
#
# Writing into an account directory is writing into a CLAUDE_CONFIG_DIR, which
# reads at first glance like a breach of claudio's "never write into Claude
# Code's directory" rule. It is not the same thing. That rule is about
# ~/.claude, which Claude Code owns and whose layout is Claude Code's to
# change; an account directory is one claudio created, named and manages, and
# settings.json is the only file in it that can make recording work at all.
# The precedent it does depart from is .claudio-relogin (see _dir_logged_in),
# which was deliberately claudio's own file rather than an edit to Claude
# Code's JSON — that was a bookkeeping flag with a choice; this is not.
#
# Hence claudio still looks before it writes, and on a hit reports rather than
# writes: never silently override a status line someone already has.
#
# Everything here is prefixed _sl_/_SL_ because POSIX sh has no `local` and
# cmd_new's messages are built from the globals `profile`, `name` and `manual`
# (see the note in _run_prelude) — a helper that clobbered one would corrupt
# the output of the command that called it.

_statusline_cmd() { _conf_last "$GLOBAL_CONF" statusline; }

_statusline_entry_path() {
  # The path claudio was INVOKED by, made absolute, with the final symlink
  # deliberately NOT followed.
  #
  # This is the one place that must not use _self_path, and the reason is the
  # Homebrew layout. `/opt/homebrew/bin/claudio` is a symlink into
  # `.../Cellar/claudio/<version>/bin/claudio`, so the resolved path carries a
  # VERSION in it — and `brew upgrade` deletes that directory. A status line
  # registered at the resolved path therefore stops existing at the next
  # upgrade: Claude Code draws nothing, plan-usage recording stops, and
  # `account list` still says `shim`, because _settings_has_shim matches
  # `statusline --shim` without the path in front of it (which it must, since
  # the path differs per install). Silent, permanent, and invisible on the one
  # surface built to show drift.
  #
  # The symlink is the stable name; the thing it points at is not. So resolve
  # the DIRECTORY (pwd -P, which normalises `/usr/local/bin/../bin`) and leave
  # the last component alone.
  _sk_p=$0
  case "$_sk_p" in
    */*) ;;
    *)   _sk_p=$(command -v "$_sk_p" 2>/dev/null) ;;
  esac
  [ -n "$_sk_p" ] || return 1
  _sk_d=$(cd "$(dirname "$_sk_p")" 2>/dev/null && pwd -P) || return 1
  [ -n "$_sk_d" ] || return 1
  printf '%s/%s\n' "$_sk_d" "$(basename "$_sk_p")"
}

_statusline_shim_cmd() {
  # The command an account's settings.json runs: this very script, in shim
  # mode. An absolute path, because Claude Code runs a status line through a
  # shell whose PATH is not necessarily yours. _shell_quote because the result
  # is pasted into a command line — it leaves an ordinary
  # /usr/local/bin/claudio untouched and only quotes a path that needs it.
  _sl_self=$(_statusline_entry_path) || _sl_self=$(_self_path) || return 1
  printf '%s statusline --shim' "$(_shell_quote "$_sl_self")"
}

_json_escape() {
  # Backslash and double quote are the only characters a conf value can carry
  # that would break a JSON string: _conf_values is line based, so the value
  # can never contain a newline, and a control character in a command is not
  # a thing that happens.
  sed 's/\\/\\\\/g; s/"/\\"/g'
}

_statusline_member() {
  # $1 = the command. The JSON member, indented to sit inside the settings
  # object built by _blank_settings_json.
  printf '  "statusLine": {\n    "type": "command",\n    "command": "%s"\n  }' \
    "$(printf '%s' "$1" | _json_escape)"
}

_managed_settings() {
  # Enterprise policy settings, which outrank every other settings file. The
  # path is computed lazily rather than at startup so the common case does not
  # pay for a `uname` fork on every claudio invocation.
  if [ -n "$CLAUDIO_MANAGED_SETTINGS" ]; then
    printf '%s' "$CLAUDIO_MANAGED_SETTINGS"
    return
  fi
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf '%s' "/Library/Application Support/ClaudeCode/managed-settings.json" ;;
    *)      printf '%s' "/etc/claude-code/managed-settings.json" ;;
  esac
}

_settings_has_statusline() {
  # grep, not jq: jq is optional throughout claudio, and the only action taken
  # on a hit is to REFUSE to write, so a false positive costs a message while a
  # false negative would cost the user their status line. Detection must be the
  # one that cannot be switched off by a missing dependency.
  [ -f "$1" ] || return 1
  grep -q '"statusLine"' "$1" 2>/dev/null
}

_settings_has_shim() {
  # ...and whether the status line in it is CLAUDIO'S. Same argument for grep,
  # and matched on `statusline --shim` rather than the whole command line
  # because the path in front of it changes with where claudio is installed.
  [ -f "$1" ] || return 1
  grep -q 'statusline --shim' "$1" 2>/dev/null
}

_statusline_sources() {
  # Every file that could put a status line on screen for a session launched in
  # THIS directory, most authoritative first, in Claude Code's own precedence
  # order: enterprise policy, the two project files, then the user file — which
  # for a claudio session is the RESOLVED account's settings.json, because an
  # account IS a CLAUDE_CONFIG_DIR, and only ~/.claude/settings.json when no
  # account resolves at all.
  #
  # Resolved, not globbed over every account. Once one account is wired a glob
  # returns a hit for every directory on the machine, reporting the first
  # account in glob order — a confident answer about an account this directory
  # may never use. This is the cwd-aware list, for reporting what is in effect
  # here; asking "is this account already spoken for" is a different question
  # with a different list, _statusline_account_sources.
  _managed_settings; printf '\n'
  printf '%s\n' ".claude/settings.local.json"
  printf '%s\n' ".claude/settings.json"
  _sl_sp=$(_active_profile)
  if [ -n "$_sl_sp" ] && [ ! -d "$PROFILES_DIR/$_sl_sp" ]; then _sl_sp=""; fi
  _sl_sa=$(_resolve_account "" "$_sl_sp"); _sl_sa=${_sl_sa#*"$TAB"}
  if [ -n "$_sl_sa" ] && [ -d "$ACCOUNTS_DIR/$_sl_sa" ]; then
    printf '%s\n' "$ACCOUNTS_DIR/$_sl_sa/settings.json"
  else
    printf '%s\n' "$USER_SETTINGS"
  fi
}

_statusline_account_sources() {
  # $1 = an account directory. What would already put a status line on screen
  # for a session run under THAT account, most authoritative first.
  #
  # Three deliberate absences, each of which would be a bug:
  #
  #   $USER_SETTINGS. ~/.claude/settings.json is not read at all when
  #   CLAUDE_CONFIG_DIR is set — the account's own settings.json REPLACES it.
  #   Consulting it would make `account new` decline on most machines, since
  #   the developer's real user file usually does have a statusLine.
  #
  #   The other accounts. Once one account is wired, _statusline_source finds
  #   it in glob order and returns a hit for every account, so nothing would
  #   ever be wired again.
  #
  #   The project files in cwd. An account is used in every directory, so the
  #   one you happen to be standing in when you type `account new` says nothing
  #   about it. A project file DOES outrank the account at run time, which is
  #   real drift — reported by `claudio statusline`, which is cwd-aware.
  _managed_settings; printf '\n'
  printf '%s\n' "$1/settings.json"
}

_statusline_source() {
  # The first of those that actually has one, or nothing.
  _statusline_sources | while IFS= read -r _sl_f; do
    if _settings_has_statusline "$_sl_f"; then
      printf '%s\n' "$_sl_f"
      break
    fi
  done
}

_statusline_describe() {
  # $1 = a settings file that has a status line. Always name the FILE; add the
  # command only when jq can read it properly.
  #
  # No sed for this, unlike _dir_email: "command" also appears under hooks and
  # mcpServers, so a regex would confidently print the wrong program's name.
  printf '  %s\n' "$1"
  if command -v jq >/dev/null 2>&1; then
    _sl_c=$(jq -r '.statusLine.command // empty' "$1" 2>/dev/null)
    if [ -n "$_sl_c" ]; then printf '  %s\n' "$_sl_c"; fi
  fi
}

_statusline_apply() {
  # $1 = account directory. For `account new` only.
  #   0 = written, shim command left in $_SL_SHIM
  #   1 = could not work out claudio's own path, nothing written
  #   2 = something already provides one, named in $_SL_SRC — reported, not written
  #
  # Note what is NOT a precondition: `statusline=` being set. Every account is
  # born wired whether or not a renderer or recording is configured today, so
  # turning either on later is a one-line edit to claudio.conf rather than a
  # re-setup of every account — and an account created before you had a
  # renderer is not quietly the one account that never records. A shim with
  # nothing to do prints nothing at all, which is indistinguishable from having
  # no status line, so the cost of wiring early is zero.
  _SL_SRC=""
  _SL_SHIM=$(_statusline_shim_cmd) || return 1
  [ -n "$_SL_SHIM" ] || return 1
  _SL_SRC=$(_statusline_account_sources | while IFS= read -r _sl_f; do
    if _settings_has_statusline "$_sl_f"; then printf '%s\n' "$_sl_f"; break; fi
  done)
  if [ -n "$_SL_SRC" ]; then
    return 2
  fi
  _blank_settings_json "$(_statusline_member "$_SL_SHIM")" > "$1/settings.json"
}

_statusline_report_conflict() {
  # $1 = account name, $2 = the file that already provides a status line.
  # Makes the case for switching rather than only declining: a refusal that
  # does not say what you are missing just reads as claudio being unhelpful.
  echo ""
  echo "You already have a status line configured:"
  _statusline_describe "$2"
  echo ""
  echo "Left alone — claudio never overwrites a status line it did not set."
  echo "An account's settings.json is the USER-level file for every session run"
  echo "under it, so writing one would replace what you already have."
  echo ""
  echo "claudio's shim forwards to your own status line and records a"
  echo "plan-usage sample on the way past — the 5-hour and 7-day percentages"
  echo "exist only in what Claude Code pipes to a status line, so nothing else"
  echo "on this machine can see them."
  echo ""
  echo "  Preview it:   claudio statusline --preview"
  echo "  Use it here:  claudio statusline --set $1"
}

_statusline_unconfigured() {
  # The one message for "there is nothing set up here at all", so the fix is
  # spelled the same way wherever you hit it. It names claude-statusline rather
  # than a /path/to/your/script.sh placeholder because a concrete command can be
  # pasted and a placeholder cannot; any command works, and claudio ships no
  # renderer. It is deliberately NOT a Homebrew dependency of claudio — separate
  # repository, optional part — so the line may need installing first.
  echo "No status line configured." >&2
  echo "Add one to $GLOBAL_CONF:" >&2
  echo "  statusline=claude-statusline" >&2
  echo "Then wire it into your accounts with: claudio statusline --all" >&2
}

_statusline_preview() {
  # The RENDERER, not the shim. Previewing through the shim would draw exactly
  # the same bytes — that is the point of a pass-through — and would append a
  # fabricated sample to your real recording on every preview.
  _SL_CMD=$(_statusline_cmd)
  [ -n "$_SL_CMD" ] || { _statusline_unconfigured; exit 1; }

  # Preview under the same environment `run` would build, or it would not be a
  # preview: account, profile and telemetry reach a status line as variables,
  # and those are exactly the three things claudio's own line is for.
  _sl_prof=$(_active_profile)
  if [ -n "$_sl_prof" ] && [ ! -d "$PROFILES_DIR/$_sl_prof" ]; then _sl_prof=""; fi
  _sl_acctline=$(_resolve_account "" "$_sl_prof")
  _sl_acct=${_sl_acctline#*"$TAB"}
  # Validated here, in this shell: _build_env runs inside $( ), where an exit
  # would be swallowed and the preview would lie about which account it used.
  if [ -n "$_sl_acct" ]; then _require_account "$_sl_acct"; fi
  _sl_envs=$(_build_env "$_sl_prof" "$_sl_acct" "" 0) || exit 1
  _sl_oldifs=$IFS; IFS=$NL
  for _sl_kv in $_sl_envs; do
    export "$_sl_kv"
  done
  IFS=$_sl_oldifs

  printf 'Previewing: %s\n' "$_SL_CMD"
  printf '  profile: %s\n' "${_sl_prof:-(none)}"
  printf '  account: %s\n' "${_sl_acct:-(none)}"
  echo ""
  # Claude Code feeds a status line one JSON object on stdin and runs the
  # command through a shell, so the preview does both — anything less would
  # render differently from the real thing.
  _sl_cwd=$(pwd | _json_escape)
  printf '{"hook_event_name":"Status","session_id":"claudio-preview","transcript_path":"","cwd":"%s","model":{"id":"claude-opus-4-1","display_name":"Opus"},"workspace":{"current_dir":"%s","project_dir":"%s"},"version":"0.0.0","output_style":{"name":"default"},"cost":{"total_cost_usd":0,"total_duration_ms":0,"total_lines_added":0,"total_lines_removed":0}}' \
    "$_sl_cwd" "$_sl_cwd" "$_sl_cwd" | sh -c "$_SL_CMD"
  _sl_rc=$?
  if [ "$_sl_rc" != 0 ]; then
    printf '\nwarning: the status line command exited %s\n' "$_sl_rc" >&2
    printf 'Fix it, or change statusline= in %s\n' "$GLOBAL_CONF" >&2
    exit 1
  fi
}

_statusline_wire() {
  # $1 = account name. Writes the shim into that account's settings.json and
  # reports what it did. Returns, never exits, so --all can carry on past one
  # refusal and still tell you about the rest:
  #   0 = written        1 = refused, someone else's JSON
  #   2 = already wired  3 = refused, something else provides a status line
  _sl_dir=$(_account_dir "$1")
  _sl_file="$_sl_dir/settings.json"
  _SL_SHIM=$(_statusline_shim_cmd) || {
    echo "Cannot work out claudio's own path, so there is nothing to register." >&2
    return 1
  }

  if _settings_has_shim "$_sl_file"; then
    printf "  %-20s already wired\n" "$1"
    return 2
  fi
  if _settings_has_statusline "$_sl_file"; then
    # ...unless claudio wrote it itself, before the shim existed. A settings
    # file that is byte-for-byte the blank plus a status line pointing straight
    # at the CONFIGURED renderer is claudio's own work: replacing it with the
    # shim that forwards to that same renderer draws the identical line and
    # starts recording, so refusing would leave the retrofit useless in exactly
    # the case it was built for. Byte-compared rather than parsed, for the same
    # reason the blank is — without jq, "is this document mine" has no other
    # honest answer, and a wrong guess costs someone their status line.
    _sl_prev=$(_statusline_cmd)
    if [ -n "$_sl_prev" ] && [ "$(cat "$_sl_file")" = \
         "$(_blank_settings_json "$(_statusline_member "$_sl_prev")")" ]; then
      _blank_settings_json "$(_statusline_member "$_SL_SHIM")" > "$_sl_file" || return 1
      printf "  %-20s upgraded: it called the renderer directly, now via the shim\n" "$1"
      return 0
    fi
    printf "  %-20s has a status line that is not claudio's — left alone\n" "$1"
    printf '      %s\n' "$_sl_file"
    return 3
  fi
  # Enterprise policy outranks every settings file, so wiring the account would
  # write a file that never runs. Say so rather than claim success.
  _sl_mgd=$(_managed_settings)
  if _settings_has_statusline "$_sl_mgd"; then
    printf "  %-20s enterprise policy already sets a status line — left alone\n" "$1"
    printf '      %s\n' "$_sl_mgd"
    return 3
  fi

  # Anything other than claudio's own blank is someone's work. Rewriting JSON
  # without jq means regenerating the whole document, which would silently drop
  # their keys, so claudio hands back the exact block instead of guessing.
  if [ -f "$_sl_file" ] && [ "$(cat "$_sl_file")" != "$(_blank_settings_json)" ]; then
    printf "Account '%s' has a settings.json claudio did not write.\n" "$1" >&2
    printf 'claudio will not rewrite JSON it does not own, so add this member yourself:\n' >&2
    printf '\n%s\n\n' "$(_statusline_member "$_SL_SHIM")" >&2
    printf '  File: %s\n' "$_sl_file" >&2
    return 1
  fi

  _blank_settings_json "$(_statusline_member "$_SL_SHIM")" > "$_sl_file" || return 1
  printf "  %-20s wired\n" "$1"
  return 0
}

_statusline_recording() {
  # Is plan-usage recording actually on? $1 = the account to answer for; empty
  # means "whatever this directory resolves to". Returns 0 for on, and sets
  # $_SL_REC_WHY to the reason whenever the answer is no.
  #
  # ACTUALLY on, not "configured on": this answered from $_LG_USE alone and
  # never looked at usage_dir, while the shim blanks $_U_DIR when the resolved
  # usage_dir is inside $HOME/.claude and the run path returns on the same
  # condition — both silently, by design, because an empty $_U_DIR is what
  # everything downstream reads as "nowhere to write". So `claudio statusline`
  # printed "Recording plan usage: on (logging=local)" while the shim wrote
  # nothing, for ever, with no diagnostic anywhere. The refusal is right; its
  # silence was not, and the one command whose job is to report the state of
  # recording is the wrong place to be quiet about it.
  #
  # The account layer is not optional detail here. `account.<name>.logging=none`
  # is advertised as a guarantee, and both callers used to pass "" for the
  # account — so the one user who had deliberately switched recording off for
  # an identity was told "Recording is on". Same resolution as
  # _statusline_sources: an account or profile that does not exist on disk is
  # not a layer.
  _sl_rp=$(_active_profile)
  if [ -n "$_sl_rp" ] && [ ! -d "$PROFILES_DIR/$_sl_rp" ]; then _sl_rp=""; fi
  _sl_ra=$1
  if [ -z "$_sl_ra" ]; then
    _sl_ra=$(_resolve_account "" "$_sl_rp"); _sl_ra=${_sl_ra#*"$TAB"}
  fi
  if [ -n "$_sl_ra" ] && [ ! -d "$ACCOUNTS_DIR/$_sl_ra" ]; then _sl_ra=""; fi
  _logging_resolve "$_sl_rp" "$_sl_ra"
  _SL_REC_WHY=''
  if [ "$_LG_USE" != 1 ]; then
    _SL_REC_WHY=$_LG_WHY
    return 1
  fi
  _sl_ud=$(_telemetry_conf usage_dir "$_sl_rp" "$_sl_ra")
  [ -n "$_sl_ud" ] || _sl_ud="$HOME/.claudio-usage"
  case "$_sl_ud" in
    "$HOME/.claude"|"$HOME/.claude"/*)
      _SL_REC_WHY="logging=$_LG_MODE, but usage_dir is $_sl_ud, inside ~/.claude — claudio will not write there"
      return 1 ;;
  esac
  return 0
}

_statusline_wire_footer() {
  # The one place that explains what a freshly wired account will actually do,
  # so `--set` and `--all` cannot drift apart on it. $1 = accounts written,
  # $2 = the account just wired, or empty when several were.
  [ "$1" -gt 0 ] || return 0
  _SL_CMD=$(_statusline_cmd)
  echo ""
  printf 'Registered: %s\n' "$_SL_SHIM"
  if [ -n "$_SL_CMD" ]; then
    printf 'Forwards to (statusline= in %s):\n  %s\n' "$GLOBAL_CONF" "$_SL_CMD"
  else
    printf 'No renderer yet — nothing will be drawn until %s has a\n' "$GLOBAL_CONF"
    printf 'statusline= line. Recording does not wait for one.\n'
  fi
  if _statusline_recording "${2:-}"; then
    echo "Recording is on."
  elif [ -n "$_SL_REC_WHY" ]; then
    # Name the LINE that decided, not the key the reader is most likely to try.
    # `account.<name>.logging` is read from the global conf only and beats the
    # plain global key — that inversion is the whole guarantee the key is sold
    # on — so "turn it on with: logging=local in <global conf>" was printed at
    # users who already had that exact line in that exact file. They edit it,
    # re-run, get the identical message, and have no way to reach the layer
    # that actually decided.
    printf 'Recording is off — decided by: %s\n' "$_SL_REC_WHY"
  else
    printf 'Recording is off. Turn it on with: logging=local in %s\n' "$GLOBAL_CONF"
  fi
  if [ -n "$_LG_NOTE" ]; then printf 'claudio: %s\n' "$_LG_NOTE"; fi
}

_statusline_set() {
  _validate_name "${1:-}" account
  _require_account "$1"
  _statusline_wire "$1"; _sl_rc=$?
  case $_sl_rc in
    0) _statusline_wire_footer 1 "$1" ;;
    # You asked for this account by name and it did not happen. Exit non-zero
    # for both refusals — a script that wires an account and carries on must be
    # able to tell "left alone" from "done". Already-wired is a real success.
    1|3) exit 1 ;;
  esac
  return 0
}

_statusline_all() {
  # Retrofit every account at once, because the accounts that predate the shim
  # are exactly the ones nobody will remember to fix by hand.
  _sl_accts=$(_accounts)
  if [ -z "$_sl_accts" ]; then
    echo "No accounts. Create one with: claudio account new <name>" >&2
    exit 1
  fi
  printf 'Wiring the status line shim into every account in %s:\n' "$ACCOUNTS_DIR"
  # A pipeline is a subshell, so the counters could not survive one; the list
  # is newline separated and comes from _dirnames, which cannot emit a blank.
  _sl_done=0; _sl_bad=0
  _sl_oldifs=$IFS; IFS=$NL
  for _sl_a in $_sl_accts; do
    IFS=$_sl_oldifs
    _statusline_wire "$_sl_a"; _sl_rc=$?
    if [ "$_sl_rc" = 0 ]; then _sl_done=$((_sl_done + 1)); fi
    if [ "$_sl_rc" = 1 ] || [ "$_sl_rc" = 3 ]; then _sl_bad=$((_sl_bad + 1)); fi
    IFS=$NL
  done
  IFS=$_sl_oldifs
  _statusline_wire_footer "$_sl_done"
  # `if`, not a trailing `&&`: this is the last statement, so a false test
  # would make claudio exit non-zero on a completely successful run.
  if [ "$_sl_bad" -gt 0 ]; then exit 1; fi
}

cmd_statusline() {
  case "${1:-}" in
    '')        _statusline_status ;;
    --preview) _statusline_preview ;;
    --set)     shift; _statusline_set "${1:-}" ;;
    --all)     _statusline_all ;;
    --shim)    _u_shim ;;
    *) printf 'Unknown option: %s\n' "$1" >&2
       printf 'Usage: claudio statusline [--preview | --set <account> | --all]\n' >&2
       exit 1 ;;
  esac
}

_statusline_status() {
  _SL_CMD=$(_statusline_cmd)
  # For the account this directory resolves to, not for no account at all: the
  # whole job of this command is to report what is actually in effect here.
  _sl_rec=0; if _statusline_recording ""; then _sl_rec=1; fi
  if [ -z "$_SL_CMD" ] && [ "$_sl_rec" != 1 ]; then
    # Neither a renderer nor recording: there is genuinely nothing set up, and
    # the same message that tells you how to fix it everywhere else applies.
    _statusline_unconfigured
    exit 1
  fi
  if [ -n "$_SL_CMD" ]; then
    printf 'Configured (statusline= in %s):\n' "$GLOBAL_CONF"
    printf '  %s\n' "$_SL_CMD"
  else
    printf 'No renderer configured (statusline= in %s is unset).\n' "$GLOBAL_CONF"
  fi
  if [ "$_sl_rec" = 1 ]; then
    printf 'Recording plan usage: on%s\n' "${_LG_MODE:+ (logging=$_LG_MODE)}"
  else
    # The off branch used to give no reason at all, which is the same failure
    # as the wrong reason: see _statusline_recording and _statusline_wire_footer.
    printf 'Recording plan usage: off%s\n' "${_SL_REC_WHY:+ ($_SL_REC_WHY)}"
  fi
  # _statusline_recording has just resolved it, so this is the one place that
  # can say a deprecated key is being read — or ignored — without a second pass.
  if [ -n "$_LG_NOTE" ]; then printf 'claudio: %s\n' "$_LG_NOTE"; fi

  # Per account, because that is where the shim is registered and drift between
  # accounts is invisible otherwise.
  echo ""
  _sl_accts=$(_accounts)
  if [ -z "$_sl_accts" ]; then
    echo "No accounts yet, so nothing is wired."
  else
    echo "Accounts (an account's settings.json is user level for its sessions):"
    _sl_unwired=0
    _sl_oldifs=$IFS; IFS=$NL
    for _sl_a in $_sl_accts; do
      IFS=$_sl_oldifs
      _sl_f="$ACCOUNTS_DIR/$_sl_a/settings.json"
      if _settings_has_shim "$_sl_f"; then
        printf '  %-20s wired\n' "$_sl_a"
      elif _settings_has_statusline "$_sl_f"; then
        printf "  %-20s a status line that is not claudio's\n" "$_sl_a"
        _sl_unwired=$((_sl_unwired + 1))
      else
        printf '  %-20s not wired\n' "$_sl_a"
        _sl_unwired=$((_sl_unwired + 1))
      fi
      IFS=$NL
    done
    IFS=$_sl_oldifs
    if [ "$_sl_unwired" -gt 0 ]; then
      echo ""
      echo "  Wire them all: claudio statusline --all"
    fi
  fi

  echo ""
  _sl_src=$(_statusline_source)
  if [ -n "$_sl_src" ]; then
    echo "In effect in this directory, from:"
    _statusline_describe "$_sl_src"
    # A project-level file outranks the account's, which is the one way a wired
    # account can silently stop recording. Worth naming when it is what we found.
    case "$_sl_src" in
      .claude/settings.json|.claude/settings.local.json)
        echo ""
        echo "note: that is a PROJECT-level file, so it outranks the account's"
        echo "      settings.json here — and claudio's shim with it, so this"
        echo "      directory records nothing." ;;
    esac
  else
    echo "No status line is in effect in this directory."
  fi
  echo ""
  echo "  Preview it:              claudio statusline --preview"
  echo "  Wire one account:        claudio statusline --set <account>"
  echo "  Wire every account:      claudio statusline --all"
}

cmd_new() {
  # Parse: name plus optional --manual (skip Docker MCP Toolkit wiring).
  name=""
  manual=0
  for a in "$@"; do
    case "$a" in
      --manual) manual=1 ;;
      -*)       echo "Unknown option: $a" >&2; echo "Valid: --manual" >&2; exit 1 ;;
      *)        [ -z "$name" ] && name="$a" ;;
    esac
  done
  _new_profile_dir "$name"
  _ensure_profile_items "$profile"
  # A profile deliberately does NOT get a status line. Its settings.json is
  # symlinked to .claude/settings.json, which is PROJECT level and outranks the
  # account's — so a profile-written status line would shadow the recording
  # shim in exactly the projects you use most. See the status line section.

  if [ "$manual" = 1 ]; then
    echo "Created profile '$name' at $profile (manual MCP mode)"
  elif _docker_ok && { _dmcp profile create --name "$name" --id "$name" >/dev/null 2>&1 || _dmcp profile show "$name" >/dev/null 2>&1; }; then
    echo "$name" > "$profile/mcp.docker"
    _write_gateway_json "$profile" "$name"
    echo "Created profile '$name' at $profile (Docker MCP mode)"
    echo "  Docker MCP profile: $name"
    echo "  Add servers:     claudio mcp $name add <image-or-ref>"
    echo "  Import a store:  claudio mcp catalog <oci-ref>"
    echo "  Non-Docker MCPs: claudio mcp $name extra   (e.g. remote HTTP servers)"
  else
    echo "Created profile '$name' at $profile (manual MCP mode — Docker MCP Toolkit unavailable)"
  fi
  # Outside the if/elif/else so every mode lands on the same next step, and
  # nothing seizes the terminal: `new` used to open $EDITOR on the directory,
  # which wiped these hints and made the command unscriptable.
  echo "  Edit it:         claudio edit $name"
  echo "  Use it:          claudio run $name"
}

cmd_edit() {
  _require_profile "$1"
  profile="$PROFILE_PATH"

  if [ -z "$2" ]; then
    ${EDITOR:-vim} "$profile"
    return
  fi

  # In Docker MCP mode the mcp.json is generated — servers live in Docker.
  if [ "$2" = "mcp" ] && _mcp_is_docker "$profile"; then
    id="$(_docker_id "$profile")"
    echo "Profile '$1' uses the Docker MCP Toolkit (docker profile: $id)."
    echo "Its .mcp.json is generated — manage servers with:"
    echo "  claudio mcp $1 add <ref>     add a Docker server"
    echo "  claudio mcp $1 rm <name>     remove a Docker server"
    echo "  claudio mcp $1 extra         edit non-Docker MCPs (remote HTTP, etc.)"
    echo "  claudio mcp $1               show servers"
    _docker_ok && _dmcp profile show "$id" 2>/dev/null
    return 0
  fi

  # $( ) is a subshell, so _component_path's exit on an unknown component would
  # be swallowed and $EDITOR would open a file literally named after the typo.
  component=$(_component_path "$2") || exit 1
  # Every component is a CONFIG_MAP item, so this fills a missing one with the
  # same blank `use` would have written — a bespoke case here wrote `{}` where
  # the rest of the tool writes `{"mcpServers": {}}`.
  _ensure_profile_items "$profile"
  ${EDITOR:-vim} "$profile/$component"
}

cmd_show() {
  _require_profile "$1"
  profile="$PROFILE_PATH"

  # Named component: print just that item. `show` and `edit` take the same
  # second argument, so there is no extra vocabulary to learn.
  if [ -n "$2" ]; then
    # $( ) is a subshell, so _component_path's exit would otherwise be swallowed.
    component=$(_component_path "$2") || exit 1
    src="$profile/$component"
    [ -e "$src" ] || { echo "Profile '$1' has no $component" >&2; exit 1; }
    if [ -d "$src" ]; then
      find "$src" -type f | sed "s|$src/||" | sort
    else
      cat "$src"
    fi
    return
  fi

  echo "Profile: $1"
  echo "Path:    $profile"
  if _mcp_is_docker "$profile"; then
    echo "MCP:     Docker MCP Toolkit (docker profile: $(_docker_id "$profile"))"
    # `if`, not `&&`: last statement of the branch, so a false test would make
    # the whole `if` exit non-zero. This shape has bitten the suite twice.
    if [ -f "$profile/mcp.extra.json" ]; then
      echo "         + extras from mcp.extra.json"
    fi
  else
    echo "MCP:     manual (.mcp.json)"
  fi
  echo ""

  # One line per item. Dumping every file inline was the only output in the
  # tool that grew with the user's data; `show <profile> <component>` has it.
  echo "$CONFIG_MAP" | while IFS=: read -r item target; do
    [ -z "$item" ] && continue
    src="$profile/$item"
    [ ! -e "$src" ] && continue

    if [ -d "$src" ]; then
      size="$(find "$src" -type f | wc -l | tr -d ' ') files"
    else
      size="$(wc -l < "$src" | tr -d ' ') lines"
    fi
    case "$size" in 0\ *) size=empty ;; 1\ *) size=${size%s} ;; esac
    printf '[%s] -> %s  (%s)\n' "$item" "$target" "$size"
  done

  echo ""
  echo "Contents of one item: claudio show $1 <component>"
}

cmd_current() {
  # "Nothing set" is stderr + non-zero, the same convention as
  # `account default`, so `p=$(claudio current) || p=none` works for both.
  active=$(_active_profile)
  if [ -z "$active" ]; then
    echo "No active profile in current directory" >&2
    echo "Link one with: claudio use <profile>" >&2
    exit 1
  fi
  echo "$active ($PROFILES_DIR/$active)"
}

cmd_init() {
  _new_profile_dir "$1"

  echo "$CONFIG_MAP" | while IFS=: read -r item target; do
    [ -z "$item" ] && continue
    [ ! -e "$target" ] && continue

    # Resolve symlinks — copy the actual content
    if [ -d "$target" ]; then
      cp -RL "$target" "$profile/$item"
    else
      cp -L "$target" "$profile/$item"
    fi
    echo "  captured $target -> $item"
  done

  _ensure_profile_items "$profile"
  echo "Created profile '$1' from current directory config (manual MCP mode)"
  echo "Path: $profile"
}

cmd_mcp() {
  # Global catalog helper: `claudio mcp catalog [<oci-ref>]`
  if [ "$1" = "catalog" ]; then
    shift
    _docker_ok || { echo "Docker MCP Toolkit (docker mcp) not available" >&2; exit 1; }
    if [ $# -eq 0 ]; then
      _dmcp catalog ls
    else
      _dmcp catalog pull "$@"
    fi
    return
  fi

  [ -z "$1" ] && {
    echo "Usage: claudio mcp <profile> [add|rm|show|config] ...  |  claudio mcp catalog <oci-ref>" >&2
    exit 1
  }
  _require_profile "$1"
  pname="$1"

  if ! _mcp_is_docker "$PROFILE_PATH"; then
    echo "Profile '$pname' uses manual MCP mode — no Docker servers to manage." >&2
    echo "Edit its .mcp.json directly:  claudio edit $pname mcp" >&2
    exit 1
  fi
  _docker_ok || { echo "Docker MCP Toolkit (docker mcp) not available" >&2; exit 1; }

  id="$(_docker_id "$PROFILE_PATH")"
  action="${2:-show}"
  # `shift` is a POSIX special built-in: shifting past $# is an error that makes
  # dash and ksh exit the whole script, so guard rather than relying on ||.
  shift; if [ $# -gt 0 ]; then shift; fi   # drop profile (+ action if present)

  case "$action" in
    show|ls)
      _dmcp profile show "$id"
      if [ -f "$PROFILE_PATH/mcp.extra.json" ]; then
        echo ""
        echo "extra (non-Docker) servers — $PROFILE_PATH/mcp.extra.json:"
        if command -v jq >/dev/null 2>&1; then
          jq -r '.mcpServers | keys[] | "  - " + .' "$PROFILE_PATH/mcp.extra.json" 2>/dev/null
        else
          sed 's/^/  /' "$PROFILE_PATH/mcp.extra.json"
        fi
      fi
      ;;
    extra)
      extra_file="$PROFILE_PATH/mcp.extra.json"
      [ -f "$extra_file" ] || printf '{\n  "mcpServers": {}\n}\n' > "$extra_file"
      ${EDITOR:-vim} "$extra_file"
      # Regenerate mcp.json so active symlinks pick up the change immediately.
      _write_gateway_json "$PROFILE_PATH" "$id"
      echo "Updated extras for '$pname' (regenerated mcp.json)."
      ;;
    add)
      [ $# -eq 0 ] && { echo "Usage: claudio mcp $pname add <image-or-ref>..." >&2; exit 1; }
      set -- $(for ref in "$@"; do printf '%s %s ' "--server" "$(_mcp_ref "$ref")"; done)
      _dmcp profile server add "$id" "$@"
      ;;
    rm|remove)
      [ $# -eq 0 ] && { echo "Usage: claudio mcp $pname rm <name>..." >&2; exit 1; }
      _dmcp profile server remove "$id" "$@"
      ;;
    config)
      _dmcp profile config "$id" "$@"
      ;;
    *)
      echo "Unknown mcp action: $action" >&2
      echo "Valid: add, rm, show, extra, config; or: claudio mcp catalog <oci-ref>" >&2
      exit 1
      ;;
  esac
}

_parse_run_opts() {
  # Sets RUN_ACCOUNT, RUN_TAGS, RUN_NO_TEL, and RUN_SHIFT — the number of
  # arguments consumed. The caller does `shift $RUN_SHIFT` so that "$@" survives
  # intact; flattening the remainder into a string would lose empty arguments,
  # split on embedded newlines, and glob-expand on re-splitting.
  RUN_ACCOUNT=""; RUN_TAGS=""; RUN_NO_TEL=0; RUN_SHIFT=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) [ $# -ge 2 ] || { echo "--account needs a value" >&2; exit 1; }
                 RUN_ACCOUNT="$2"; RUN_SHIFT=$((RUN_SHIFT + 2)); shift 2 ;;
      --account=*) RUN_ACCOUNT="${1#--account=}"
                 RUN_SHIFT=$((RUN_SHIFT + 1)); shift ;;
      --tag)     [ $# -ge 2 ] || { echo "--tag needs key=value" >&2; exit 1; }
                 _validate_tag "$2"; RUN_TAGS="$RUN_TAGS$2$NL"
                 RUN_SHIFT=$((RUN_SHIFT + 2)); shift 2 ;;
      --tag=*)   _t="${1#--tag=}"; _validate_tag "$_t"
                 RUN_TAGS="$RUN_TAGS$_t$NL"
                 RUN_SHIFT=$((RUN_SHIFT + 1)); shift ;;
      --no-telemetry) RUN_NO_TEL=1; RUN_SHIFT=$((RUN_SHIFT + 1)); shift ;;
      --)        RUN_SHIFT=$((RUN_SHIFT + 1)); break ;;
      -*)        printf 'Unknown option: %s\n' "$1" >&2
                 printf 'claudio options: --account <name>, --tag key=value, --no-telemetry\n' >&2
                 printf 'To pass it to claude instead, put it after --:  claudio run -- %s\n' "$1" >&2
                 exit 1 ;;
      *)         break ;;
    esac
  done
}

_run_prelude() {
  # The whole prologue shared by run and env: take an optional leading profile
  # name, parse the shared options, then resolve profile and account.
  #
  # NOTE: POSIX sh has no scoping, and cmd_use -> _ensure_profile_items assigns
  # a global `profile` (as do cmd_new/edit/show/init). Anything that must
  # survive a call into those uses an RUN_-prefixed name.
  #
  # Sets RUN_PROFILE, RUN_ACCT, RUN_ACCT_SRC (plus _parse_run_opts's globals)
  # and RUN_SHIFT — the TOTAL arguments consumed, including the profile — so
  # the caller does `shift $RUN_SHIFT` and "$@" reaches claude byte-for-byte.
  #
  # The account is validated HERE, in the caller's shell. _build_env runs
  # inside $( ), a subshell, so an `exit` from _require_account there would be
  # swallowed and Claude Code would launch under the wrong login.
  RUN_PROFILE=""; _pre_shift=0
  case "${1:-}" in
    ''|-*) : ;;
    *) RUN_PROFILE="$1"; _pre_shift=1; shift ;;
  esac
  _parse_run_opts "$@"
  RUN_SHIFT=$((RUN_SHIFT + _pre_shift))

  # The profile is optional. Ad-hoc directories are the common case: you want a
  # different account and some tags, not a full project config symlinked in.
  # Without one, run still sets identity and tags and touches no files.
  [ -n "$RUN_PROFILE" ] || RUN_PROFILE=$(_active_profile)
  if [ -n "$RUN_PROFILE" ]; then
    _require_profile "$RUN_PROFILE"
  fi

  _acctline=$(_resolve_account "$RUN_ACCOUNT" "$RUN_PROFILE")
  _tab=$(printf '\t')
  RUN_ACCT=${_acctline#*"$_tab"}
  RUN_ACCT_SRC=${_acctline%%"$_tab"*}
  if [ -n "$RUN_ACCT" ]; then
    _require_account "$RUN_ACCT"
  fi
}

cmd_run() {
  _run_prelude "$@"
  shift "$RUN_SHIFT"

  # Activate only when a profile is in play and it is not already active, so
  # `run` alone is enough to get working without ever surprising an ad-hoc dir.
  if [ -n "$RUN_PROFILE" ] && [ "$(_active_profile)" != "$RUN_PROFILE" ]; then
    cmd_use "$RUN_PROFILE" >/dev/null
  fi

  _envs=$(_build_env "$RUN_PROFILE" "$RUN_ACCT" "$RUN_TAGS" "$RUN_NO_TEL") || exit 1

  # Export into this shell, then hand the process to claude with "$@" untouched.
  _oldifs=$IFS; IFS=$NL
  for _kv in $_envs; do
    export "$_kv"
  done
  IFS=$_oldifs

  # Always say what context was resolved and where it came from: silently
  # running under the wrong login is the failure this whole feature exists to
  # prevent, so an unconfigured directory should be obvious, not invisible.
  if [ -n "$RUN_PROFILE" ]; then
    printf "profile: %s\n" "$RUN_PROFILE" >&2
  else
    printf 'warning: no profile active in this directory (ad-hoc run)\n' >&2
  fi

  if [ -n "$RUN_ACCT" ]; then
    printf "account: %s (from %s)\n" "$RUN_ACCT" "$RUN_ACCT_SRC" >&2
  else
    printf 'warning: no account configured — using Claude Code'"'"'s default login\n' >&2
    # Name the answer when there is only one account to name.
    _only=$(_accounts)
    if [ "$(printf '%s\n' "$_only" | grep -c .)" = 1 ]; then
      printf '         set one with: claudio account default %s\n' "$_only" >&2
    else
      printf '         set one with: claudio account default <name>\n' >&2
    fi
  fi

  # The tags are the feature's whole output; showing them is how you know a
  # --tag landed without re-running the command through `claudio env`.
  if [ -n "${OTEL_RESOURCE_ATTRIBUTES:-}" ]; then
    printf 'tags:    %s\n' "$OTEL_RESOURCE_ATTRIBUTES" >&2
  fi

  # The receiver for stream A, and this session's entry in its refcount. Gated
  # on the export this run is ACTUALLY about to make — the variables _build_env
  # has just exported into this shell — rather than on a second resolution of
  # the same keys, which could disagree with it. --no-telemetry is tested here
  # rather than inside, because an inherited CLAUDE_CODE_ENABLE_TELEMETRY would
  # otherwise outlive the one flag whose whole job is to silence a single run.
  # Nothing on this path waits on the receiver: see that section.
  if [ "$RUN_NO_TEL" != 1 ] && [ "${CLAUDE_CODE_ENABLE_TELEMETRY:-}" = 1 ]; then
    _run_receiver
  fi

  # Last of the stderr lines, and immediately before exec: it is the least
  # important thing said here, it never blocks, and nothing sits between its
  # background fork and handing the process over. See the update section.
  _update_notice

  exec claude "$@"
}

cmd_env() {
  _run_prelude "$@"

  # env sets variables; it does not link. Saying so on stderr keeps
  # `eval "$(claudio env soc)"` from quietly tagging a session profile=soc
  # while none of soc's servers or instructions are actually in place.
  if [ -n "$RUN_PROFILE" ] && [ "$(_active_profile)" != "$RUN_PROFILE" ]; then
    printf "note: profile '%s' is not linked here — env only sets variables (link it with: claudio use %s)\n" \
      "$RUN_PROFILE" "$RUN_PROFILE" >&2
  fi

  # Output is meant for `eval`, so values must be quoted: a path or tag
  # containing a space would otherwise truncate or execute.
  _envs=$(_build_env "$RUN_PROFILE" "$RUN_ACCT" "$RUN_TAGS" "$RUN_NO_TEL") || exit 1
  _oldifs=$IFS; IFS=$NL
  for _kv in $_envs; do
    _k=${_kv%%=*}; _v=${_kv#*=}
    printf 'export %s=%s\n' "$_k" "$(_shell_quote "$_v")"
  done
  IFS=$_oldifs
}

cmd_account() {
  action=${1:-list}; [ $# -gt 0 ] && shift
  case $action in
    list|ls)
      accounts=$(_accounts)
      if [ -z "$accounts" ]; then
        echo "No accounts. Create one with: claudio account new <name>"
        return 0
      fi
      _dflt=$(_conf_last "$GLOBAL_CONF" account)
      printf 'Accounts (in %s):\n' "$ACCOUNTS_DIR"
      # The shim column exists so drift is visible: an account created before
      # the shim existed, or one whose settings.json someone hand-edited,
      # records nothing and there is no other way to notice. email stays last —
      # it is the only free-form field, so it is the only one that can be wide.
      echo "$accounts" | while IFS= read -r a; do
        if _account_logged_in "$a"; then
          state="logged in"
          # Only when live: the address survives in the file after a login is
          # orphaned, and showing it then would imply a session that is not there.
          email=$(_dir_email "$ACCOUNTS_DIR/$a")
        else
          state="not logged in"; email=""
        fi
        if _settings_has_shim "$ACCOUNTS_DIR/$a/settings.json"; then
          shim="shim"
        elif _settings_has_statusline "$ACCOUNTS_DIR/$a/settings.json"; then
          shim="other"
        else
          shim="no shim"
        fi
        if [ "$a" = "$_dflt" ]; then mark='*'; else mark=' '; fi
        printf ' %s %-20s %-14s %-8s %s\n' "$mark" "$a" "$state" "$shim" "$email"
      done
      _unwired=$(echo "$accounts" | while IFS= read -r a; do
        if ! _settings_has_shim "$ACCOUNTS_DIR/$a/settings.json"; then echo x; fi
      done)
      if [ -n "$_dflt" ]; then
        printf '\n* machine default (used when nothing more specific applies)\n'
      fi
      # `if`, not `&&`: this is the last statement in the branch, so a false
      # test would make the whole command exit non-zero.
      if [ -n "$_unwired" ]; then
        printf '\nSome accounts do not run claudio'"'"'s status line shim, so they record\n'
        printf 'no plan usage. Wire them with: claudio statusline --all\n'
      fi
      ;;
    default)
      # Machine-wide fallback, the last layer before Claude Code's own login.
      name=${1:-}
      if [ -z "$name" ]; then
        _dflt=$(_conf_last "$GLOBAL_CONF" account)
        if [ -n "$_dflt" ]; then
          printf '%s\n' "$_dflt"
        else
          echo "No machine default account set." >&2
          echo "Set one with: claudio account default <name>" >&2
          exit 1
        fi
        return 0
      fi
      _validate_name "$name" account
      _require_account "$name"
      _conf_set "$GLOBAL_CONF" account "$name" || exit 1
      printf "Machine default account: %s (%s)\n" "$name" "$GLOBAL_CONF"
      ;;
    new|add)
      name=${1:-}
      [ -n "$name" ] || { echo "Usage: claudio account new <name>" >&2; exit 1; }
      _validate_name "$name" account
      if _account_exists "$name"; then
        printf 'Account already exists: %s\n' "$name" >&2
        printf 'Log in with: claudio account login %s\n' "$name" >&2
        exit 1
      fi
      mkdir -p "$ACCOUNTS_DIR/$name" || exit 1
      # Every account is born wired: its settings.json registers claudio's
      # status line shim, which forwards to the renderer named by `statusline=`
      # and records a plan-usage sample on the way past. Written here rather
      # than after the login because there IS no after — the login `exec`s.
      _statusline_apply "$ACCOUNTS_DIR/$name"; _SL_RC=$?
      # An account with no login is useless, so `new` finishes the job rather
      # than printing the next command for the user to retype.
      printf "Created account '%s' (%s)\n" "$name" "$ACCOUNTS_DIR/$name"
      if [ "$_SL_RC" = 0 ]; then
        printf '  Status line:  %s\n' "$_SL_SHIM"
      elif [ "$_SL_RC" = 2 ]; then
        _statusline_report_conflict "$name" "$_SL_SRC"
        echo ""
      fi
      printf "Logging in to account '%s' — a browser window will open.\n" "$name"
      # Cleared before the exec because there is no after: login replaces this
      # process. Abandoning the browser flow leaves the account reported as
      # logged in until the next attempt, which is a smaller lie than the one
      # this replaces, and you are looking at the login screen when it happens.
      rm -f "$(_account_dir "$name")/.claudio-relogin"
      CLAUDE_CONFIG_DIR="$(_account_dir "$name")" exec claude /login
      ;;
    login)
      name=${1:-}
      _validate_name "$name" account
      _require_account "$name"
      printf "Logging in to account '%s' — a browser window will open.\n" "$name"
      CLAUDE_CONFIG_DIR="$(_account_dir "$name")" exec claude /login
      ;;
    path)
      name=${1:-}
      _validate_name "$name" account
      _require_account "$name"
      _account_dir "$name"
      ;;
    rm|remove)
      name=${1:-}
      # Validate before anything reaches rm -rf: `account rm ../profiles` would
      # otherwise escape the accounts directory.
      _validate_name "$name" account
      _require_account "$name"
      printf 'This deletes %s including its stored login.\n' "$ACCOUNTS_DIR/$name"
      printf 'Type the account name to confirm: '
      read -r confirm
      [ "$confirm" = "$name" ] || { echo "Aborted"; exit 1; }
      rm -rf "${ACCOUNTS_DIR:?}/${name:?}"
      printf "Removed account '%s'\n" "$name"
      ;;
    *)
      echo "Unknown account action: $action" >&2
      echo "Valid: list, new, login, path, default, rm" >&2
      exit 1
      ;;
  esac
}

cmd_default() {
  # Writes project defaults to .claudio.local, which is personal (your account)
  # as opposed to .claudio, which is the project's profile and is shareable.
  [ $# -gt 0 ] || { echo "Usage: claudio default [--account <name>] [--tag k=v]..." >&2; exit 1; }
  _parse_run_opts "$@"
  shift "$RUN_SHIFT"
  # Anything left over is a typo, not something to ignore silently.
  [ $# -eq 0 ] || { printf 'Unexpected argument: %s\n' "$1" >&2; exit 1; }
  [ -n "$RUN_ACCOUNT" ] || [ -n "$RUN_TAGS" ] || {
    echo "Nothing to set. Use --account <name> and/or --tag key=value" >&2; exit 1; }

  if [ -n "$RUN_ACCOUNT" ]; then
    _validate_name "$RUN_ACCOUNT" account
    _require_account "$RUN_ACCOUNT"
    _conf_set "$LOCAL_MARKER" account "$RUN_ACCOUNT" || exit 1
    printf 'Default account for this project: %s\n' "$RUN_ACCOUNT"
  fi

  if [ -n "$RUN_TAGS" ]; then
    printf '%s' "$RUN_TAGS" | while IFS= read -r t; do
      [ -n "$t" ] && printf 'tag=%s\n' "$t" >> "$LOCAL_MARKER"
    done
    printf 'Added default tags to %s\n' "$LOCAL_MARKER"
  fi

  # .claudio.local holds personal settings, so keep it out of the repo. Handle a
  # missing .gitignore, and a .git that is a file (worktrees and submodules).
  if [ -e .git ] && ! grep -qxF "$LOCAL_MARKER" .gitignore 2>/dev/null; then
    printf '%s\n' "$LOCAL_MARKER" >> .gitignore \
      && printf 'Added %s to .gitignore\n' "$LOCAL_MARKER"
  fi
}

# --- migration: claudio's data moved out of Claude Code's directory ---
#
# claudio used to keep profiles, accounts and its global conf inside ~/.claude,
# which belongs to Claude Code. They now live in ~/.claudio. Everything from
# here to cmd_migrate exists only to carry an existing install across that
# move — LEGACY_DIR/LAYOUT_CUSTOM at the top, _legacy_hint's three call sites
# (cmd_list, _require_profile, cmd_clean), and this block. Delete them together
# once the move is old news.
#
# Two facts drive the whole design, and neither is guessable from the source:
#
#   1. On macOS the login is NOT in the account directory. Claude Code derives
#      its Keychain service name from a hash of the config dir path
#      ("Claude Code-credentials-<sha256(dir)[0:8]>"), so moving an account
#      leaves its credential behind under a name nothing will look up again.
#      Elsewhere the credential is a file inside the directory and moves with
#      it. So: warn before moving, on macOS only, and mean it.
#   2. Activation writes ABSOLUTE symlinks into project directories, and
#      _is_claudio_link recognises them by prefix. Move the profiles dir and
#      claudio does not merely dangle them — it disowns them: `clean` reports
#      success and removes nothing, `use` reports success and relinks nothing.
#      Re-running activation therefore cannot repair a project. The links have
#      to be rewritten in place, matched by target prefix.

_count_lines() {
  if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | grep -c .; fi
}

_links_under() {
  # $1 = directory to search, $2 = target prefix.
  # Prints ONE LINK PATH PER LINE for every symlink at depth <= 2 whose target
  # lies inside $2 (.claude/<item> is depth 2; nothing goes deeper).
  #
  # One field, not "<link>\ttarget": both halves would be paths, and a path may
  # contain a tab. A reader splitting on tab then truncated the link path, and
  # the caller went on to `rm -f` whatever sat at the truncated name — deleting
  # an unrelated file of the user's. There is no tab-safe ordering when every
  # field is a path, so the target is not carried at all; the caller re-reads it
  # with readlink, which needs no delimiter.
  #
  # Matched by TARGET PREFIX, never by CONFIG_MAP. A claudio link can sit at a
  # path CONFIG_MAP never mentions — a hand-made .mcp.json.bak, say — and those
  # are precisely the ones no other code path will ever come back for.
  #
  # The emptiness guard is out here rather than inside the case on purpose: an
  # empty prefix degenerates the pattern to "/*", which matches every absolute
  # symlink on the machine.
  [ -n "$2" ] || return 0
  [ -d "$1" ] || return 0
  find "$1" -maxdepth 2 -type l 2>/dev/null | while IFS= read -r _lk; do
    # find prints one line per link, so a name containing a newline arrives as
    # fragments and readlink fails on every one of them. Nothing can be done
    # for such a link, but it must not be passed over in silence: the whole
    # point of migrate is that no link is left dangling without a word.
    if ! _tg=$(readlink "$_lk" 2>/dev/null); then
      printf 'warning: skipping a symlink whose name contains a newline, under %s\n' "$1" >&2
      printf '         repoint it by hand if it points into claudio.\n' >&2
      continue
    fi
    case "$_tg" in
      "$2"/*) printf '%s\n' "$_lk" ;;
    esac
  done
}

_legacy_links() {
  # Symlinks in $1 still pointing into the OLD profiles directory.
  if [ "$LEGACY_DIR/profiles" = "$PROFILES_DIR" ]; then return 0; fi
  _links_under "$1" "$LEGACY_DIR/profiles"
}

_legacy_has_data() {
  # True when the old location still holds claudio data worth moving. Checks
  # for CONTENT, not for the directories: a completed per-item migration leaves
  # ~/.claude/profiles behind as an empty directory, and a hint that never
  # stops firing is a hint nobody reads.
  if [ "$LEGACY_DIR/profiles" = "$PROFILES_DIR" ]; then return 1; fi
  _lh=$(_dirnames "$LEGACY_DIR/profiles"; _dirnames "$LEGACY_DIR/accounts")
  if [ -n "$_lh" ]; then return 0; fi
  [ -f "$LEGACY_DIR/claudio.conf" ] && [ "$LEGACY_DIR/claudio.conf" != "$GLOBAL_CONF" ]
}

_legacy_hint() {
  # Printed at the three moments the user is already confused: no profiles
  # listed, a profile that cannot be found, and a clean that removed nothing.
  _legacy_has_data || return 0
  printf '\nFound claudio data in %s — claudio used to live inside Claude Code'"'"'s\n' "$LEGACY_DIR" >&2
  printf 'directory and now keeps its own. Move it with:  claudio migrate\n' >&2
}

_mg_items() {
  # $1 = label, $2 = source dir, $3 = destination dir.
  # One "<label>/<name>\t<src>\t<dst>" line per immediate subdirectory.
  # Per item, never the parent directory: `mv old/profiles new/profiles` does
  # not fail when the destination exists, it nests into new/profiles/profiles.
  # Non-directories (a stray .DS_Store) are skipped rather than carried over.
  for _mi in "$2"/*/; do
    [ -d "$_mi" ] || continue
    _mn=$(basename "$_mi")
    # The plan is a tab-separated table and every field here is a path, so a
    # name containing a tab has no safe encoding. claudio can never create one
    # (_validate_name rejects whitespace), but a hand-made directory can hold
    # one — and mangling it into a truncated `mv` is the one outcome that is
    # worse than refusing. Say so and move on; the item stays where it is.
    case "$_mn" in
      *"$TAB"*) printf 'warning: skipping %s/%s — its name contains a tab.\n' "$1" "$_mn" >&2
                printf '         rename it, then run migrate again.\n' >&2
                continue ;;
    esac
    printf '%s/%s\t%s\t%s\n' "$1" "$_mn" "$2/$_mn" "$3/$_mn"
  done
}

_mg_move() {
  # $1 = source, $2 = destination. 0 moved, 2 destination occupied, 1 failed.
  #
  # Tested with [ -e ] rather than left to mv: mv refuses a non-empty directory
  # destination but silently REPLACES an empty one, and claudio never
  # overwrites. mv itself is the right primitive for the move — a rename within
  # a filesystem is atomic, and across filesystems mv does its own copy-then-
  # unlink, so the original is never removed before the copy succeeded.
  if [ -e "$2" ] || [ -L "$2" ]; then return 2; fi
  _mp=$(dirname "$2")
  [ -d "$_mp" ] || mkdir -p "$_mp" || return 1
  mv "$1" "$2" || return 1
}

_mg_repoint() {
  # $1 = project dir, $2 = old prefix, $3 = new prefix, $4 = blocked profiles.
  # Rewrites matching links in place; prints "<state>\t<detail>\t<link>".
  # The link path goes LAST so a reader can take it as the whole remainder: it
  # is the field most likely to contain a tab, and a truncated link path is how
  # this function once came to rm an unrelated file (see _links_under).
  #
  # rm then ln -s, never `ln -sf`: -f on an existing symlink-to-a-directory
  # follows it and plants the new link INSIDE the old target, leaving the
  # project's link untouched. (`ln -sfn` gets this right but -n is not POSIX.)
  #
  # Today the difference is unobservable, and deliberately kept anyway: the
  # move runs before the repoint, so by the time we get here the old targets
  # are gone and there is nothing for -f to follow. That is a property of the
  # call order, not of this function. Swapping the two phases, or repointing a
  # project whose old profile is still in place, would make -f silently corrupt
  # the old profile — so no test can currently fail on it. Hence this note.
  # IFS= and one variable: _links_under emits the link path as the whole line,
  # so a tab in it stays part of the name instead of truncating it.
  _links_under "$1" "$2" | while IFS= read -r _lk; do
    _tg=$(readlink "$_lk" 2>/dev/null) || continue
    _rel=${_tg#"$2"/}
    # A profile whose move was refused is still sitting at the old path, and its
    # links still work. Repointing those at a destination we know is not there
    # would turn a reported failure into broken config.
    _pn=${_rel%%/*}
    if [ -n "$4" ] && printf '%s\n' "$4" | grep -qxF -- "$_pn"; then
      printf 'blocked\t%s\t%s\n' "$_pn" "$_lk"
      continue
    fi
    _nt="$3/$_rel"
    if rm -f "$_lk" && ln -s "$_nt" "$_lk"; then
      # Repointed even when the new target does not exist yet, then reported: a
      # link into a directory that is definitely gone is strictly worse than one
      # into a path _ensure_profile_items will fill on the next `use`.
      if [ -e "$_nt" ]; then
        printf 'ok\t%s\t%s\n' "$_nt" "$_lk"
      else
        printf 'missing\t%s\t%s\n' "$_nt" "$_lk"
      fi
    else
      printf 'fail\t%s\t%s\n' "$_nt" "$_lk"
    fi
  done
}

_mg_projects() {
  # $1 = newline separated scan roots. Prints candidate project directories:
  # every directory holding a .claudio marker, plus the roots themselves (you
  # named them, so they are looked at even without a marker — which is what
  # makes `migrate --scan .` work right after a `clean` deleted the marker).
  #
  # Depth 4 from each root. Measured on a real home directory: depth 4 finds
  # every project in 0.2s, depth 6 finds no more and takes 17s. Somewhere
  # deeper is what --scan is for. There is deliberately no registry: claudio
  # never wrote one before the move, so it would be empty for exactly the
  # people who need this. And Claude Code's own project index cannot be used —
  # it encodes both / and . as -, so decoding it is ambiguous.
  # printf '%s\n', not '%s': a $( )-captured value has had its trailing newline
  # stripped, and `read` discards a final line that has none.
  { printf '%s\n' "$1" | while IFS= read -r _rt; do
      [ -n "$_rt" ] || continue
      if [ ! -d "$_rt" ]; then
        printf 'warning: scan root is not a directory, skipping: %s\n' "$_rt" >&2
        continue
      fi
      printf '%s\n' "$_rt"
      find "$_rt" -maxdepth 4 -name "$MARKER" -type f 2>/dev/null | sed 's|/[^/]*$||'
    done
  } | sort -u
}

cmd_migrate() {
  _mg_dry=0; _mg_yes=0; _mg_undo=0; _mg_roots=""; _mg_explicit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) _mg_dry=1; shift ;;
      --yes|-y)  _mg_yes=1; shift ;;
      --undo)    _mg_undo=1; shift ;;
      --scan)    [ $# -ge 2 ] || { echo "--scan needs a directory" >&2; exit 1; }
                 _mg_roots="$_mg_roots$2$NL"; _mg_explicit=1; shift 2 ;;
      --scan=*)  _mg_roots="$_mg_roots${1#--scan=}$NL"; _mg_explicit=1; shift ;;
      *) printf 'Unknown option: %s\n' "$1" >&2
         printf 'Valid: --dry-run, --yes, --scan <dir>, --undo\n' >&2; exit 1 ;;
    esac
  done

  # Direction. Everything below runs either way round off these six names.
  if [ "$_mg_undo" = 1 ]; then
    _mg_verb="migrate --undo"
    _no_slash "$LEGACY_DIR/profiles"
    _src_prof=$PROFILES_DIR;              _dst_prof=$_ns
    _src_acct=$ACCOUNTS_DIR;              _dst_acct="$LEGACY_DIR/accounts"
    _src_conf=$GLOBAL_CONF;               _dst_conf="$LEGACY_DIR/claudio.conf"
    _mg_head="claudio migrate --undo — move claudio's data back to $LEGACY_DIR"
  else
    _mg_verb="migrate"
    _no_slash "$LEGACY_DIR/profiles"
    _src_prof=$_ns;                               _dst_prof=$PROFILES_DIR
    _src_acct="$LEGACY_DIR/accounts";              _dst_acct=$ACCOUNTS_DIR
    _src_conf="$LEGACY_DIR/claudio.conf";          _dst_conf=$GLOBAL_CONF
    _mg_head="claudio migrate — move claudio's data out of Claude Code's directory"
  fi

  # An empty prefix would turn every symlink test into "does the target start
  # with /", i.e. every absolute link on the machine. Never get there.
  if [ -z "$_src_prof" ] || [ -z "$_dst_prof" ]; then
    echo "Refusing to run: a profiles directory resolved to an empty path" >&2
    exit 1
  fi
  if [ "$_src_prof" = "$_dst_prof" ]; then
    printf 'Nothing to do: the old and new profiles directory are the same path\n'
    printf '  %s\n' "$_src_prof"
    exit 0
  fi

  # --- plan ---
  _mg_moves=$(_mg_items profiles "$_src_prof" "$_dst_prof"
              _mg_items accounts "$_src_acct" "$_dst_acct"
              if [ -f "$_src_conf" ]; then
                printf 'claudio.conf\t%s\t%s\n' "$_src_conf" "$_dst_conf"
              fi)

  _mg_scan=$_mg_roots
  if [ -z "$_mg_scan" ] && [ "$LAYOUT_CUSTOM" = 0 ]; then
    _mg_scan="$HOME$NL"
  fi
  _mg_projs=$(_mg_projects "$_mg_scan")

  # "<count>\t<dir>" for every project with links still pointing at the old path.
  # Count first, path last: a directory name may contain a tab, and with the
  # path in front every reader truncated it at the tab — the project was then
  # silently skipped and its links left dangling, with a zero exit status. A
  # count never contains a tab, so putting it first makes the split exact.
  _mg_work=$(printf '%s\n' "$_mg_projs" | while IFS= read -r _pd; do
    [ -n "$_pd" ] || continue
    _n=$(_count_lines "$(_links_under "$_pd" "$_src_prof")")
    if [ "$_n" -gt 0 ]; then printf '%s\t%s\n' "$_n" "$_pd"; fi
  done)

  if [ -z "$_mg_moves" ] && [ -z "$_mg_work" ]; then
    if [ "$_mg_undo" = 1 ]; then
      printf 'Nothing to undo: no claudio data in %s\n' "$_src_prof"
    else
      printf 'Nothing to migrate: no claudio data in %s\n' "$LEGACY_DIR"
      printf "claudio's data already lives in %s\n" "$_dst_prof"
    fi
    exit 0
  fi

  # Which planned moves the act phase is already certain to refuse. Computed
  # here rather than discovered later because a plan that promises a move it
  # will not make is worse than no plan: --dry-run exists precisely so the user
  # can see the collision before typing 'migrate', and until this was checked
  # up front the only warning came afterwards, on stderr, once it was too late
  # to be a preview of anything.
  _mg_conflicts=$(printf '%s\n' "$_mg_moves" | while IFS="$TAB" read -r _lb _sp _dp; do
    [ -n "$_lb" ] || continue
    if [ -e "$_dp" ] || [ -L "$_dp" ]; then printf '%s\n' "$_lb"; fi
  done)

  echo "$_mg_head"
  echo ""
  if [ -n "$_mg_moves" ]; then
    echo "Data to move:"
    printf '%s\n' "$_mg_moves" | while IFS="$TAB" read -r _lb _sp _dp; do
      if [ -e "$_dp" ] || [ -L "$_dp" ]; then
        printf '  %-26s -> %s\n' "$_lb" "CONFLICT: $_dp already exists"
      else
        printf '  %-26s -> %s\n' "$_lb" "$_dp"
      fi
    done
  else
    echo "Data to move: none (already moved)"
  fi
  echo ""

  if [ -n "$_mg_conflicts" ]; then
    printf 'CONFLICTS: %s of the items above will NOT move — something is already\n' \
      "$(_count_lines "$_mg_conflicts")"
    echo "at the destination and claudio never overwrites. Rename or remove the"
    echo "destination, then run migrate again. Everything else still moves, and"
    echo "a conflicted profile's project links are left pointing at the copy that"
    echo "still works."
    echo ""
  fi

  if [ -n "$_mg_work" ]; then
    echo "Projects to re-link (their symlinks still point at the old path):"
    printf '%s\n' "$_mg_work" | while IFS="$TAB" read -r _n _pd; do
      printf '  %-40s %s links\n' "$_pd" "$_n"
    done
  else
    echo "Projects to re-link: none found"
  fi
  echo ""

  _mg_login_plan
  echo ""
  echo "Nothing has been changed yet."

  if [ "$_mg_dry" = 1 ]; then
    printf 'Dry run — stopping here. Run `claudio %s` to do it.\n' "$_mg_verb"
    exit 0
  fi

  if [ "$_mg_yes" != 1 ]; then
    printf "Type 'migrate' to proceed: "
    read -r _mg_confirm
    if [ "$_mg_confirm" != "migrate" ]; then echo "Aborted"; exit 1; fi
  fi

  # --- act ---
  _mg_rc=0; _mg_blocked=""
  echo ""
  if [ -n "$_mg_moves" ]; then
    echo "Moved:"
    # Not a subshell: the loop must be able to raise _mg_rc. A here-doc-free
    # POSIX way to feed a loop without a pipe is `for` over IFS-split lines.
    _oldifs=$IFS; IFS=$NL
    for _mg_line in $_mg_moves; do
      IFS=$_oldifs
      _lb=${_mg_line%%"$TAB"*}
      _rest=${_mg_line#*"$TAB"}
      _sp=${_rest%%"$TAB"*}
      _dp=${_rest#*"$TAB"}
      # Ask before moving: afterwards the source no longer exists, and only
      # an account that HAD a login needs telling to get one again.
      _mg_waslogged=0
      case "$_lb" in
        accounts/*) if _dir_logged_in "$_sp"; then _mg_waslogged=1; fi ;;
      esac
      _mg_move "$_sp" "$_dp"
      _mg_st=$?
      case $_mg_st in
        0) printf '  %-26s -> %s\n' "$_lb" "$_dp"
           # Moving an account changes the path the Keychain entry is named
           # after, so the login does not follow it. Record that, or
           # `account list` cheerfully reports a logged-out account as logged
           # in. Undo moves it back to the original path, which makes the
           # original entry valid again, so the flag is cleared there.
           case "$_lb" in
             accounts/*)
               if [ "$_mg_undo" = 1 ]; then
                 rm -f "$_dp/.claudio-relogin"
               elif [ "$_mg_waslogged" = 1 ] && [ "$(uname -s 2>/dev/null)" = Darwin ]; then
                 : > "$_dp/.claudio-relogin" 2>/dev/null || true
               fi
               ;;
           esac
           ;;
        2) printf '  SKIPPED %s: %s already exists\n' "$_lb" "$_dp" >&2
           printf '          claudio never overwrites. Rename or remove one of them, then run migrate again.\n' >&2 ;;
        *) printf '  FAILED  %s: left in place at %s, nothing was lost\n' "$_lb" "$_sp" >&2 ;;
      esac
      if [ "$_mg_st" != 0 ]; then
        _mg_rc=1
        # Remember which profiles did NOT move, so their still-working links
        # are left alone below instead of being pointed at absent data.
        case "$_lb" in
          profiles/*) _mg_blocked="$_mg_blocked${_lb#profiles/}$NL" ;;
        esac
      fi
      IFS=$NL
    done
    IFS=$_oldifs
    echo ""
  fi

  if [ -n "$_mg_work" ]; then
    echo "Re-linked:"
    _oldifs=$IFS; IFS=$NL
    for _mg_line in $_mg_work; do
      IFS=$_oldifs
      _pd=${_mg_line#*"$TAB"}
      _res=$(_mg_repoint "$_pd" "$_src_prof" "$_dst_prof" "$_mg_blocked")
      _ok=$(printf '%s\n' "$_res" | grep -c '^ok' || true)
      printf '  %-40s %s links\n' "$_pd" "$_ok"
      printf '%s\n' "$_res" | while IFS="$TAB" read -r _st _dt _lk; do
        case "$_st" in
          missing) printf '  warning: %s -> no such item in the new profiles dir\n' "$_lk" >&2
                   printf '           (link updated anyway; remove it with: rm %s)\n' "$_lk" >&2 ;;
          blocked) printf '  left alone: %s (profile %s did not move)\n' "$_lk" "$_dt" >&2 ;;
          # Say exactly how to finish the job by hand: the link is a pointer,
          # so nothing is lost, but the user has to be able to recreate it.
          fail)    printf '  FAILED to repoint %s\n' "$_lk" >&2
                   printf '         recreate it with: ln -s %s %s\n' "$_dt" "$_lk" >&2 ;;
        esac
      done
      if printf '%s\n' "$_res" | grep -q '^fail'; then _mg_rc=1; fi
      IFS=$NL
    done
    IFS=$_oldifs
    echo ""
  fi

  # Conditional, because the unconditional version was a lie in exactly the
  # case that matters. When every move is refused — a destination that already
  # exists, an unwritable parent — the data is all still at the old path, and
  # announcing "claudio's profiles now live in <new>" on stdout, with the only
  # contradiction on stderr, sends the user away believing a migration happened.
  if [ "$_mg_rc" = 0 ]; then
    printf "claudio's profiles now live in %s\n" "$_dst_prof"
    printf "claudio's accounts now live in %s\n" "$_dst_acct"
  else
    echo "FINISHED WITH PROBLEMS — the migration is INCOMPLETE."
    echo "Every message above marked SKIPPED or FAILED names something that did"
    echo "not move; it is still at its old path and nothing was lost. Deal with"
    printf 'the cause, then run `claudio %s` again to finish.\n' "$_mg_verb"
  fi
  _mg_login_result
  if [ "$_mg_explicit" = 0 ]; then
    echo ""
    echo "Projects elsewhere are re-linked with:  claudio $_mg_verb --scan <dir>"
    echo "Safe to run again — it only rewrites links that still point at the old path."
  fi
  if [ "$_mg_undo" = 1 ]; then
    echo ""
    echo "claudio still defaults to the new locations, so it will offer to migrate"
    echo "again. To keep using the old ones, set:"
    printf '  CLAUDIO_PROFILES=%s\n' "$_dst_prof"
    printf '  CLAUDIO_ACCOUNTS=%s\n' "$_dst_acct"
    printf '  CLAUDIO_CONF=%s\n' "$_dst_conf"
  else
    echo ""
    echo "Undo with: claudio migrate --undo"
  fi
  exit "$_mg_rc"
}

_mg_accounts_moving() {
  # Names of the accounts this run would move, read at the time of asking.
  _dirnames "$_src_acct"
}

_mg_login_plan() {
  _mg_accts=$(_mg_accounts_moving)
  if [ -z "$_mg_accts" ]; then
    echo "LOGINS: no accounts to move, so no logins are affected."
    return 0
  fi
  if [ "$(uname -s 2>/dev/null)" != Darwin ]; then
    echo "LOGINS: on this platform the credential is a file inside each account"
    echo "directory (.credentials.json) and moves with it. No re-login needed."
    return 0
  fi
  if [ "$_mg_undo" = 1 ]; then
    echo "LOGINS: macOS ties the Keychain entry to the account directory's path,"
    echo "so moving these accounts BACK restores their original entry — the logins"
    echo "that migrate invalidated will work again:"
  else
    echo "LOGINS: macOS keeps the credential in the Keychain under a name derived"
    echo "from the account directory's path, so moving an account leaves its login"
    echo "behind. Nothing is deleted from the Keychain, but these accounts will"
    echo "need to log in again afterwards:"
  fi
  printf '%s\n' "$_mg_accts" | while IFS= read -r _a; do
    [ -n "$_a" ] || continue
    if _dir_logged_in "$_src_acct/$_a"; then _s="logged in"; else _s="not logged in"; fi
    printf '  %-20s %s\n' "$_a" "$_s"
  done
  if [ "$_mg_undo" != 1 ]; then
    echo 'Run `claudio migrate --undo` to move them back and the logins work again.'
  fi
}

_mg_login_result() {
  if [ "$(uname -s 2>/dev/null)" != Darwin ]; then return 0; fi
  if [ "$_mg_undo" = 1 ]; then return 0; fi
  # Read the flag the move just wrote, not _dir_logged_in — that now returns
  # false for exactly these accounts, which is the whole point of the flag.
  # Telling someone to re-authenticate an account that never had a login is
  # noise, so only flagged ones are listed.
  _mg_relog=$(_dirnames "$_dst_acct" | while IFS= read -r _a; do
    [ -n "$_a" ] || continue
    if [ -f "$_dst_acct/$_a/.claudio-relogin" ]; then printf '%s\n' "$_a"; fi
  done)
  [ -n "$_mg_relog" ] || return 0
  echo ""
  echo "Log back in — these accounts' Keychain entries were tied to the old path:"
  printf '%s\n' "$_mg_relog" | while IFS= read -r _a; do
    printf '  claudio account login %s\n' "$_a"
  done
}

# --- the OTLP receiver: spawn and supervise ---
#
# Stream A — Claude Code's own per-request export — is written by a receiver
# that is neither a container nor an installed service: `usage/recv/otlp-recv`,
# a process spawned on demand by `claudio run` before it execs claude, kept
# alive by the status line shim, exiting by itself when the work stops. The
# reasoning for that shape is in usage/cu/collector.py; the parts that bind
# claudio are these.
#
#   Never wait on it. The spawn is a detached, BRACED background command and
#   nothing checks whether it came up: Claude Code's export batches over
#   seconds, so the receiver has claude's own startup to bind in, and a launch
#   that blocks on a listener is a worse failure than a late bind.
#
#   Never fork-bomb over it. A receiver that cannot bind dies instantly, and the
#   supervisor runs several times a second. Three things stop that: the spawn
#   lock (whoever loses walks away), recv.err (a fault already reported is not
#   chased again — the check in the early block), and the start cap below, which
#   is the backstop for a failure that leaves neither behind.
#
#   Say what went wrong. recv.err is the receiver's own note of why the last
#   start failed, and `claudio run` prints it. A receiver that quietly is not
#   there is the silent loss this project exists to prevent.
#
# The pidfile, lock, error file, start-attempt file and sessions directory are
# declared once, in usage/cu/config.py, because the shell cannot import them.
# _recv_alive and _recv_target are defined at the top of this file, with the
# shim block that needs them.

# The crash-loop cap, shared with the receiver, which enforces the other half of
# it. Five starts in a minute that never reached a bind is a loop, not a retry.
# These two numbers must equal collector.MAX_STARTS and collector.START_WINDOW;
# test.sh reads both files and compares them, because a cap that disagrees with
# itself refuses in one place while the other is still spawning.
RECV_MAX_STARTS=5
RECV_START_WINDOW=60

_recv_cmd() {
  # The receiver command. `receiver=` in the global conf names it — machine
  # level, like statusline=, because it is a path on THIS machine — and it
  # outranks every layout _tool_path knows about, which is the point of having
  # it: a receiver somewhere else is the one case claudio cannot guess.
  # Without it, _tool_path's three layouts decide (checkout, package, $PATH).
  # A wrong guess is written to recv.err and named by the next `claudio run`,
  # never retried in silence.
  #
  # usage/cu/config.py reads the same key from the same file, so `claudio usage
  # doctor` and `claudio usage collect` agree with this about which receiver is
  # this machine's. They disagreed until recently, and the shape of it was the
  # usual one: `claudio run` started the configured receiver while `doctor`
  # reported one missing at the bundled path and exited non-zero for it.
  _rc_c=$(_conf_last "$GLOBAL_CONF" receiver)
  if [ -n "$_rc_c" ]; then printf '%s\n' "$_rc_c"; return 0; fi
  _tool_path recv/otlp-recv otlp-recv
}

_tool_path() {
  # $1 = path under usage/ (repo layout), $2 = bare name to fall back to.
  #
  # Three layouts, because claudio is installed three ways and the Python it
  # drives has to be found in all of them. Repo first (development), then
  # libexec (a package: `bin/claudio` beside `libexec/claudio/`), then $PATH.
  # `_self_path` has already resolved symlinks, so a Homebrew shim lands on the
  # real Cellar path and the ../libexec hop is the packaged tree, not /opt.
  #
  # A wrong guess is never retried in silence: the caller reports it.
  _tp_s=$(_self_path 2>/dev/null) || _tp_s=''
  if [ -n "$_tp_s" ]; then
    _tp_d=${_tp_s%/*}
    [ -x "$_tp_d/usage/$1" ] && { printf '%s\n' "$_tp_d/usage/$1"; return 0; }
    [ -x "${_tp_d%/*}/libexec/claudio/$1" ] && {
      printf '%s\n' "${_tp_d%/*}/libexec/claudio/$1"; return 0; }
  fi
  printf '%s\n' "$2"
}

cmd_recv() {
  # The OTLP receiver, run in the foreground. `claudio run` spawns it detached
  # and the shim keeps it alive, so this verb is for looking at it: `claudio
  # recv serve` in one terminal shows what a session is exporting.
  _cr_c=$(_recv_cmd)
  command -v "$_cr_c" >/dev/null 2>&1 || [ -x "$_cr_c" ] || {
    printf 'claudio: receiver not found (%s)\n' "$_cr_c" >&2
    # The single-file install is what produces this, so the remedy names the
    # target that fixes it rather than saying "install it properly".
    printf 'claudio needs its Python beside it: reinstall from a checkout with\n' >&2
    printf '  sudo make install\n' >&2
    printf 'or name the receiver yourself with receiver=<path> in %s\n' \
      "$GLOBAL_CONF" >&2
    exit 1
  }
  exec "$_cr_c" "$@"
}

cmd_usage_cmd() {
  # The reader over what the shim and the receiver recorded. Named
  # `cmd_usage_cmd` because `_usage` is the help text and `cmd_usage` would
  # read like its command form; the verb is still `claudio usage`.
  #
  # CLAUDIO_SELF is handed down because `claudio usage doctor` asks claudio two
  # questions -- `claudio env` for the stream A export, `claudio statusline`
  # for whether recording is on -- and it asked them of a BARE NAME, i.e. of
  # whichever claudio is first on $PATH. Resolution runs the other way here
  # (this claudio finds its Python through _tool_path's three layouts and then
  # handed nothing back), so a checkout's `./claudio usage doctor` interrogated
  # /usr/local/bin/claudio: a different build reading a different config, which
  # reported "recording is OFF -- claudio reports nothing configured at all"
  # while this one was recording. The one command whose job is to say what is
  # wrong was confidently wrong. Exported and not passed as an argument so the
  # verb's own option surface is untouched; absent, the Python falls back to
  # the bare name, which is what `usage/claudio-usage` run by hand still needs.
  CLAUDIO_SELF=$(_self_path 2>/dev/null) || CLAUDIO_SELF=''
  if [ -n "$CLAUDIO_SELF" ]; then export CLAUDIO_SELF; fi

  # ...and CLAUDIO_USAGE_DIR, which is the seam itself. `usage_dir=` layers
  # global -> profile -> project on THIS side and is read by the shim, by
  # `_run_receiver` and by the receiver spawn — and by nothing at all on the
  # Python side, which only ever looked at the environment variable and
  # otherwise defaulted. So a machine with `usage_dir=/data/usage` recorded
  # into /data/usage and `claudio usage show` read ~/.claudio-usage and printed
  # "No requests recorded yet.": a plausible empty result over a full ledger,
  # with `doctor` reporting two zeroes beside it. Resolving it here, in the one
  # place that already knows how, keeps one resolver rather than adding a
  # second one in Python that would have to agree about the layering for ever.
  #
  # An explicit CLAUDIO_USAGE_DIR in the environment is left alone: it is the
  # narrowest layer on both sides and re-deciding it here would invert that.
  if [ -z "${CLAUDIO_USAGE_DIR:-}" ]; then
    _cu_p=$(_active_profile)
    if [ -n "$_cu_p" ] && [ ! -d "$PROFILES_DIR/$_cu_p" ]; then _cu_p=""; fi
    _cu_a=$(_resolve_account "" "$_cu_p"); _cu_a=${_cu_a#*"$TAB"}
    if [ -n "$_cu_a" ] && [ ! -d "$ACCOUNTS_DIR/$_cu_a" ]; then _cu_a=""; fi
    _cu_d=$(_telemetry_conf usage_dir "$_cu_p" "$_cu_a")
    case "$_cu_d" in
      '')
        : ;;                    # unset: both sides default to the same path
      "$HOME/.claude"|"$HOME/.claude"/*)
        # claudio refuses to write inside Claude Code's own directory however
        # usage_dir is configured, so nothing was ever recorded there. Saying
        # so is the difference between an empty reader and an explained one;
        # the shim cannot say it, because a status line renders and never
        # diagnoses, so this is one of the two places that can.
        printf 'usage: usage_dir is %s, inside ~/.claude — claudio will not\n' "$_cu_d" >&2
        printf '       write there, so there is nothing recorded to read.\n' >&2 ;;
      *)
        CLAUDIO_USAGE_DIR=$_cu_d; export CLAUDIO_USAGE_DIR ;;
    esac
  fi
  _cu_c=$(_tool_path claudio-usage claudio-usage)
  command -v "$_cu_c" >/dev/null 2>&1 || [ -x "$_cu_c" ] || {
    printf 'claudio: usage reader not found (%s)\n' "$_cu_c" >&2
    printf 'claudio needs its Python beside it: reinstall from a checkout with\n' >&2
    printf '  sudo make install\n' >&2
    printf 'or run claudio from the checkout itself.\n' >&2
    exit 1
  }
  exec "$_cu_c" "$@"
}

_recv_note() {
  # $1 = usage dir, $2 = text. Writes recv.err in the receiver's own format:
  # one timestamped line, OVERWRITTEN, because it is a current fault and not a
  # log — a file that grows is a file nobody prints. Best effort throughout: a
  # diagnostic that cannot be written must never cost the launch.
  [ -d "$1" ] || return 0
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$2" \
    > "$1/recv.err" 2>/dev/null || :
  return 0
}

_recv_cap_ok() {
  # $1 = usage dir, $2 = now. True while another start attempt is allowed.
  #
  # recv.starts holds one epoch per start that never reached a bind; the
  # receiver truncates it the moment it binds, so the count is a crash-loop
  # measure and not a usage measure. Read in this shell, no fork, because the
  # answer is needed before deciding to fork at all.
  #
  # NO ARITHMETIC EXPANSION ON A VALUE READ FROM THE FILE. The cutoff is
  # computed once, from claudio's own two numbers, and every line is compared
  # with `test`, which parses base 10 — the pattern `_u_gt` already uses, and
  # for the same reason. Digits alone are not enough to make `$(( ))` safe: a
  # LEADING ZERO makes it fatal in both shells (dash "Illegal number", bash
  # "value too great for base"), and unlike the render path this runs in the
  # main shell of `claudio run`, where no EXIT trap catches it — so one torn or
  # hand-edited line in a shared usage_dir used to kill the tool's primary verb
  # outright, with a raw shell error as its only explanation. What the guards
  # below buy is therefore exact: digits only, at most 18 of them (int64), and
  # a base-10 comparison rather than an evaluation.
  _rk_n=0
  _rk_cut=$(( $2 - RECV_START_WINDOW ))
  if [ -f "$1/recv.starts" ]; then
    while IFS= read -r _rk_l || [ -n "$_rk_l" ]; do
      _rk_l=${_rk_l%%.*}
      case $_rk_l in ''|*[!0-9]*) continue ;; esac
      if [ "${#_rk_l}" -gt 18 ]; then continue; fi
      if [ "$_rk_l" -gt "$_rk_cut" ]; then _rk_n=$((_rk_n + 1)); fi
    done < "$1/recv.starts"
  fi
  [ "$_rk_n" -lt "$RECV_MAX_STARTS" ]
}

_recv_is_receiver() {
  # $1 = pid, $2 = the receiver command. True unless that pid can be shown to be
  # something else.
  #
  # ONE fork, and only from `claudio run`. `kill -0` cannot tell a live receiver
  # from a recycled pid, and believing a recycled one leaves a whole session
  # exporting into nothing — so the pid is checked against the command name
  # exactly once per session, which is the moment the wrong answer starts
  # costing records. The shim cannot afford this and does not do it.
  #
  # "Cannot tell" answers TRUE: with no `ps`, or none that will say, the honest
  # move is to trust the cheap check rather than to respawn over a live receiver,
  # which can only fail to bind and burn an attempt from the cap.
  _ri_n=${2##*/}
  [ -n "$_ri_n" ] || return 0
  _ri_c=$(ps -p "$1" -o command= 2>/dev/null) || return 0
  [ -n "$_ri_c" ] || return 0
  case $_ri_c in *"$_ri_n"*) return 0 ;; esac
  return 1
}

_recv_clear_pid() {
  # $1 = usage dir, $2 = the token that was in the pidfile when it was read.
  # Removes it only if it STILL carries that token.
  #
  # This is what the token is for on this side, and it is not theoretical: a
  # receiver coming up while an old pidfile is being cleaned would otherwise
  # lose the pidfile it has just written, and the supervisor would respawn over
  # a live receiver. A pid alone cannot tell those two apart.
  [ -n "$2" ] || return 0
  _rp_t=''
  { read -r _rp_x; read -r _rp_t; } < "$1/recv.pid" 2>/dev/null || :
  [ "$_rp_t" = "$2" ] || return 0
  rm -f "$1/recv.pid" 2>/dev/null || :
  return 0
}

_recv_cannot() {
  # $1 = usage dir, $2 = 1 to speak, $3 = what could not be done.
  #
  # The data directory itself is unusable. That is neither a race nor a
  # transient: it will be unusable on the next run too, and on every run after
  # it, and until it is said out loud the only symptom is that stream A goes to
  # a closed port — which Claude Code's exporter drops in silence, by design.
  # This is the cardinal sin of this project, so it is the one thing here that
  # is allowed to be noisy on every launch.
  #
  # recv.err is written as well, best effort, for the shim and the next run —
  # but it usually lives in the very directory that cannot be written, so
  # stderr is the diagnostic that actually arrives.
  _rn_m="$3 $1 — stream A will NOT be recorded"
  _recv_note "$1" "$_rn_m"
  if [ "$2" = 1 ]; then printf 'usage receiver: %s\n' "$_rn_m" >&2; fi
  return 0
}

_recv_ensure() {
  # $1 = usage dir, $2 = port ('' = the receiver's own default), $3 = 1 to
  # report on stderr. Starts the receiver unless it is already there or has
  # already told us why it will not start. Returns 0 whatever happens: nothing
  # here may cost a launch or a render.
  _rv_dir=$1; _rv_port=$2; _rv_talk=$3
  [ -n "$_rv_dir" ] || return 0
  _rv_cmd=$(_recv_cmd)

  # The last failure, said on the run path only, and said every run until a
  # successful bind clears the file: it is an unresolved fault, not news.
  #
  # TWO files, because they answer two questions and only one of them is a
  # reason not to spawn. recv.err is a START fault and is what the shim's gate
  # reads; recv.warn is what a receiver that was up and serving reported — an
  # undecodable body, a failed write. Both are losses and both are printed;
  # only recv.err stands the supervisor down. Merging them cost a real bug:
  # one bad payload wrote recv.err, and from then on no render would ever
  # respawn a receiver that died.
  if [ "$_rv_talk" = 1 ]; then
    if [ -f "$_rv_dir/recv.err" ]; then
      printf 'usage receiver: %s\n' "$(cat "$_rv_dir/recv.err" 2>/dev/null)" >&2
    fi
    if [ -f "$_rv_dir/recv.warn" ]; then
      printf 'usage receiver: %s\n' "$(cat "$_rv_dir/recv.warn" 2>/dev/null)" >&2
    fi
  fi

  if _recv_alive "$_rv_dir"; then
    if [ "$_rv_talk" != 1 ] || _recv_is_receiver "$_RECV_PID" "$_rv_cmd"; then
      return 0
    fi
    # A recycled pid: the file names a process that is not the receiver.
    _recv_clear_pid "$_rv_dir" "$_RECV_TOKEN"
  fi

  if [ ! -x "$_rv_cmd" ] && ! command -v "$_rv_cmd" >/dev/null 2>&1; then
    [ -d "$_rv_dir" ] || { mkdir -p "$_rv_dir" 2>/dev/null && chmod 700 "$_rv_dir" 2>/dev/null; } || :
    _recv_note "$_rv_dir" "receiver not found: $_rv_cmd (name it with receiver=<path> in $GLOBAL_CONF)"
    if [ "$_rv_talk" = 1 ]; then
      printf 'usage receiver: not found at %s\n' "$_rv_cmd" >&2
      # A BARE name here means the search fell through both layouts, which is
      # what copying `claudio` on its own produces — so name that cause, not
      # just the override. With a path it is a wrong `receiver=` or a broken
      # tree, and the override is the whole remedy.
      case $_rv_cmd in
        */*) printf '                name it with: echo receiver=<path> >> %s\n' \
               "$GLOBAL_CONF" >&2 ;;
        *)   printf '                claudio was installed without its Python;\n' >&2
             printf '                reinstall from a checkout with: sudo make install\n' >&2
             printf '                or name it with: echo receiver=<path> >> %s\n' \
               "$GLOBAL_CONF" >&2 ;;
      esac
    fi
    return 0
  fi

  if [ ! -d "$_rv_dir" ]; then
    if ! mkdir -p "$_rv_dir" 2>/dev/null; then
      _recv_cannot "$_rv_dir" "$_rv_talk" "cannot create"
      return 0
    fi
    chmod 700 "$_rv_dir" 2>/dev/null || :
  fi
  # And a directory that exists and cannot be written to is the same failure
  # one step later: the pidfile, the lock and the capture all live in it.
  if [ ! -w "$_rv_dir" ]; then
    _recv_cannot "$_rv_dir" "$_rv_talk" "cannot write to"
    return 0
  fi

  _rv_now=$(_now)
  if ! _recv_cap_ok "$_rv_dir" "$_rv_now"; then
    # Past the cap, and the refusal is written ONCE: recv.err existing is what
    # the shim's early block reads as "already reported, stop chasing", so
    # rewriting it every render would be the very fork this cap prevents.
    if [ ! -f "$_rv_dir/recv.err" ]; then
      _recv_note "$_rv_dir" "refusing to start: $RECV_MAX_STARTS starts in ${RECV_START_WINDOW}s never reached a bind. Fix what is holding the port or the data dir, then delete $_rv_dir/recv.starts."
    fi
    if [ "$_rv_talk" = 1 ]; then
      printf 'usage receiver: not starting it — %s failed starts in %ss (delete %s to retry)\n' \
        "$RECV_MAX_STARTS" "$RECV_START_WINDOW" "$_rv_dir/recv.starts" >&2
    fi
    return 0
  fi

  # Claim the spawn. `mkdir` is atomic in POSIX and needs no helper, which is
  # what lets a shell and a Python process share one lock. The loser does NOT
  # wait: whoever won is about to bind the one port there is.
  if ! mkdir "$_rv_dir/recv.lock" 2>/dev/null; then
    # WHICH failure, because the shell cannot see errno and a failed `mkdir`
    # was read unconditionally as "someone else is spawning". EEXIST is the
    # only one of those that is true; a recv.lock left behind as a regular
    # file, or a name that cannot be created at all, then stood every future
    # spawn down for ever, in silence, and no later run could recover it — the
    # staleness rule below cannot help either, since `find -mmin` matches
    # nothing that was never a directory and `rmdir` cannot remove a file.
    if [ -d "$_rv_dir/recv.lock" ]; then
      # A real race, or a lock older than the window: the latter is broken
      # rather than obeyed — a spawner killed between the mkdir and the exec
      # would otherwise stop every future spawn for ever — and then this
      # attempt still stands down, so that breaking it and claiming it are
      # never the same racy step. `find -mmin` is one fork on a path that is
      # already the rare one; the shell has no builtin mtime.
      if [ -n "$(find "$_rv_dir/recv.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
        rmdir "$_rv_dir/recv.lock" 2>/dev/null || :
      fi
      return 0
    fi
    # Not a lock at all. Clear it and claim once; if that still fails, the
    # directory is the problem and saying so is the whole point.
    rm -f "$_rv_dir/recv.lock" 2>/dev/null || :
    if ! mkdir "$_rv_dir/recv.lock" 2>/dev/null; then
      _recv_cannot "$_rv_dir" "$_rv_talk" "cannot claim the spawn lock in"
      return 0
    fi
  fi

  # Counted BEFORE the fork, in this shell, so an attempt that never gets as far
  # as running the command is still an attempt. The receiver appends its own
  # line when it starts and truncates the file when it binds, so a crash loop is
  # counted from both ends and the cap fires sooner rather than later.
  printf '%s\n' "$_rv_now" >> "$_rv_dir/recv.starts" 2>/dev/null || :

  RECV_DIR=$_rv_dir; RECV_CMD=$_rv_cmd; RECV_PORT=$_rv_port
  # The braces are load-bearing, not decoration — the same trap _update_refresh
  # records at length. Redirecting a plain background command leaks the
  # inherited stdout under dash, so any `out=$(claudio run …)` capture stays
  # open until the child exits: here that would be until the RECEIVER exits,
  # i.e. for the whole session. Redirecting a compound command closes it.
  { _recv_start; } >/dev/null 2>&1 </dev/null &
  return 0
}

_recv_start() {
  # The detached child. Runs the receiver in the foreground of this subshell —
  # for as long as it lives — with its stdin and both outputs already on
  # /dev/null.
  #
  # setsid when there is one, so closing the terminal does not take the receiver
  # with it. There is no setsid on macOS: the receiver then shares claude's
  # process group and a SIGHUP to the session stops it gracefully, which the
  # next `claudio run` undoes by starting it again. `nohup` is not the fallback
  # it looks like — the receiver installs its own SIGHUP handler, which replaces
  # the ignore nohup sets.
  #
  # CLAUDIO_USAGE_DIR is the seam: claudio's `usage_dir` and the receiver's data
  # directory are the same directory by construction, never by coincidence.
  if [ -n "$RECV_PORT" ]; then
    set -- serve --quiet --port "$RECV_PORT"
  else
    set -- serve --quiet
  fi
  if command -v setsid >/dev/null 2>&1; then
    CLAUDIO_USAGE_DIR="$RECV_DIR" setsid "$RECV_CMD" "$@"
  else
    CLAUDIO_USAGE_DIR="$RECV_DIR" "$RECV_CMD" "$@"
  fi
  _rs_rc=$?
  # The receiver writes its own recv.err for every failure it can reach, and
  # releases the spawn lock on every path including those. This is the case
  # neither covers: the command never ran at all, or died before it could say
  # so. The lock is deliberately NOT released here — a receiver that lived for
  # hours would be removing a lock some later spawner now holds — the staleness
  # rule in _recv_ensure covers it instead.
  if [ "$_rs_rc" != 0 ] && [ ! -f "$RECV_DIR/recv.pid" ] &&
     [ ! -f "$RECV_DIR/recv.err" ]; then
    _recv_note "$RECV_DIR" "$RECV_CMD exited $_rs_rc without binding"
  fi
  return 0
}

_recv_session() {
  # $1 = usage dir. Registers this session for the receiver's refcount.
  #
  # `exec` preserves the pid, so $$ written here IS the claude process that is
  # about to take this shell's place. That is the whole trick: claudio is gone
  # a moment later and can never come back to tidy up, so the entry is removed
  # by whoever is still running — the receiver sweeps the directory on every
  # watchdog tick and unlinks the pids that no longer answer.
  #
  # The sweep below is not a second owner, it is the case the receiver cannot
  # cover: if the receiver never starts, nothing else would ever remove an
  # entry and the directory would grow for ever. `kill -0` per entry is a
  # builtin, and a recycled pid reads as live and is kept, which is the safe
  # direction — an entry kept too long costs a late idle exit, one removed too
  # early costs the records of a live session.
  #
  # This runs BEFORE _recv_ensure, so it is also the first thing that may have
  # to create the usage dir — hence the mode, which _recv_ensure used to be the
  # only one to set. The directory holds request metadata and an email address.
  # Each directory is chmodded only on the call that CREATED it: a usage_dir
  # the user made themselves is theirs, and quietly narrowing its mode on every
  # launch would be claudio deciding something it was not asked to decide.
  if [ ! -d "$1" ]; then
    mkdir -p "$1" 2>/dev/null || return 0
    chmod 700 "$1" 2>/dev/null || :
  fi
  if [ ! -d "$1/sessions" ]; then
    mkdir -p "$1/sessions" 2>/dev/null || return 0
    chmod 700 "$1/sessions" 2>/dev/null || :
  fi
  for _rn_f in "$1"/sessions/*; do
    [ -e "$_rn_f" ] || continue
    _rn_p=${_rn_f##*/}
    case $_rn_p in ''|*[!0-9]*) continue ;; esac
    kill -0 "$_rn_p" 2>/dev/null || rm -f "$_rn_f" 2>/dev/null || :
  done
  printf '%s\n' "$(_now)" > "$1/sessions/$$" 2>/dev/null || :
  return 0
}

_run_receiver() {
  # Called by `run` with the environment _build_env has just exported, and
  # reading it rather than resolving the same keys a second time: the gate must
  # be the export that is actually about to happen, and two resolutions can
  # disagree. --no-telemetry is checked by the caller, above the export.
  #
  # http/json and loopback only. An endpoint on another host is someone else's
  # collector and starting a local receiver for it would be useless and rude,
  # so that case is silent: claudio cannot know whether something is listening
  # on an endpoint it did not choose, and `claudio usage doctor` prints the two
  # lines to change.
  #
  # A LOOPBACK endpoint in a protocol this receiver cannot speak is the one
  # mismatch that is unambiguously a local mistake, so it is the one that is
  # said out loud. The alternative is an export to this machine, with nothing
  # on this machine listening, failing quietly at the client for ever.
  # The data directory first, and out loud. claudio refuses to squat inside
  # ~/.claude however usage_dir was configured — that is right — but the
  # refusal used to be a bare `return 0`, so logging was on, claude launched,
  # and NOTHING was written by either stream, for ever, with no diagnostic
  # anywhere and `claudio statusline` reporting "Recording plan usage: on".
  # A data directory claudio cannot use must be said out loud, on every run:
  # same rule as _recv_cannot, one layer up. It is checked above the protocol
  # gate because it costs both streams, not just the receiver.
  _rr_dir=$(_telemetry_conf usage_dir "$RUN_PROFILE" "$RUN_ACCT")
  [ -n "$_rr_dir" ] || _rr_dir="$HOME/.claudio-usage"
  case "$_rr_dir" in
    "$HOME/.claude"|"$HOME/.claude"/*)
      printf 'usage: usage_dir is %s, inside ~/.claude — claudio will not write\n' "$_rr_dir" >&2
      printf '       there, so nothing is being recorded. Point usage_dir elsewhere.\n' >&2
      return 0 ;;
  esac

  # The shipper's two files, printed here and not inside _recv_ensure, because
  # shipping does not depend on this machine's receiver: someone exporting to
  # their own collector still ships from the same ledger, and _recv_ensure is
  # never reached on that path. Same two-file split and the same reasoning as
  # recv.err/recv.warn — ship.err means nothing was delivered (the offset is
  # untouched, so the next tick resends), ship.warn means delivery worked but
  # some records can never be placed. Both are unresolved faults rather than
  # news, so both are said on every run until the file is gone; a shipping
  # failure nobody is told about is silent non-delivery, which is this
  # project's cardinal sin wearing a new hat.
  if [ -f "$_rr_dir/ship.err" ]; then
    printf 'usage shipper: %s\n' "$(cat "$_rr_dir/ship.err" 2>/dev/null)" >&2
  fi
  if [ -f "$_rr_dir/ship.warn" ]; then
    printf 'usage shipper: %s\n' "$(cat "$_rr_dir/ship.warn" 2>/dev/null)" >&2
  fi

  if [ "${OTEL_EXPORTER_OTLP_PROTOCOL:-}" != http/json ]; then
    if _recv_target "${OTEL_EXPORTER_OTLP_ENDPOINT:-}"; then
      printf 'usage receiver: exporting %s to %s, which nothing here can serve —\n' \
        "${OTEL_EXPORTER_OTLP_PROTOCOL:-unset}" "${OTEL_EXPORTER_OTLP_ENDPOINT:-unset}" >&2
      printf '                set otel_protocol=http/json and otel_endpoint=http://localhost:4318\n' >&2
    fi
    return 0
  fi
  _recv_target "${OTEL_EXPORTER_OTLP_ENDPOINT:-}" || return 0

  # THE SESSION IS REGISTERED FIRST, and the order is the fix for a real race.
  # The receiver's watchdog decides to exit from a snapshot of `sessions/`
  # taken on a tick; with the ensure first, `run` could find the receiver alive,
  # be told it may export — and only then write the entry that would have held
  # it up, by which time the tick had already counted zero and the receiver was
  # on its way out. Reproduced: run saw ALIVE at t=5.98, registered at t=6.08,
  # and the first export at t=8.08 was refused, connection refused, with the
  # receiver's own uptime record reading "idle: no live session". Registering
  # first means the sweep on that tick counts this session, which removes the
  # whole tick-sized window; the receiver closes the sub-millisecond remainder
  # by re-sweeping immediately before it shuts down.
  _recv_session "$_rr_dir"
  _recv_ensure "$_rr_dir" "$_RECV_PORT" 1
  return 0
}

# --- usage recording ---
#
# The 5-hour and 7-day plan percentages are Anthropic's own, server-side, and
# they exist nowhere else on this machine: Claude Code puts them in the JSON it
# pipes to a status line command and in nothing else, so nothing headless can
# collect them. Drawing "31%" and discarding them throws away the only record
# of what the plan actually thinks. This is the half of claudio's telemetry
# that OTel cannot give you; stream A is the other half — one `logging=local`
# turns both on, because half a picture is what this design refuses — and the
# two join on
# the account/profile/host/email tags, which is why the tags here are LIFTED
# out of $OTEL_RESOURCE_ATTRIBUTES rather than derived again.
#
# Everything is prefixed _u_/_U_. Three properties are the whole design:
#
#   A recorder fault costs a sample, never the render. The rendered line has
#   already gone to stdout before any of this runs, stderr is discarded, every
#   failure path is `return 0`, and _u_shim's traps catch the two classes that
#   never reach a `||` at all — a signal and a fatal expansion.
#
#   Quantisation is a TRIGGER, never a transformation. The percentages are
#   compared as canonical integers and stored as the raw float, byte for byte:
#   the real data contains 7.000000000000001 (which is 0.07*100) and
#   14.000000000000002, and a raw float comparison fires on every single tick.
#   The rounding happens inside the jq that already parses the payload, so it
#   costs no process — and it is why there is no `printf -v` to port and no
#   `10#` arithmetic, which in dash is a live hazard: $((08)) is a FATAL error
#   that would take the whole render down.
#
#   A record is written only when the plan has actually moved. See _u_win.

_u_peel() {
  # $1 = the remaining block. Sets $_UL to its first line and $_UR to the rest.
  #
  # The `case` guard is the entire point. `${1#*"$NL"}` on a string with NO
  # newline in it returns the string UNCHANGED, so a naive peel re-reads the
  # last field for ever — and $( ) has already stripped every trailing newline,
  # so the empty trailing fields (prompt_id and agent are commonly empty) are
  # exactly where it happens. Same class as the "$( ) strips the final newline"
  # trap recorded for migrate.
  case $1 in
    *"$NL"*) _UL=${1%%"$NL"*}; _UR=${1#*"$NL"} ;;
    *)       _UL=$1; _UR='' ;;
  esac
}

_u_epoch() {
  # $1 = a canonical integer, $2 = now. Sets $_UE to $1 when it is a plausible
  # rate-limit reset epoch, empty otherwise. Floor and ceiling, both load-bearing.
  #
  # The floor is 2001: the real data contains five_hour_resets_at: 1, which
  # without it reads as an ancient window and makes every later tick a rollover.
  #
  # The ceiling is 30 days out, past the 7-day window and short of anything
  # plausible. Without it ONE millisecond epoch freezes a window for good:
  # _u_win reads a stored mark newer than the incoming one as a stale snapshot
  # from another session and returns without moving anything, so a mark 55 000
  # years out can never be beaten and that window never records again. There is
  # no self-healing path — only deleting the state file clears it.
  #
  # The length guard comes FIRST, and is the second line of defence rather
  # than the first. Measured on this machine, `test` in both dash and bash
  # SATURATES an out-of-range integer, so a 23-digit mark fails both
  # comparisons below and is refused with or without this line. POSIX does not
  # specify that — it says the behaviour is undefined — and the bash original
  # this was ported from used $(( )), which genuinely does wrap. Keeping the
  # check is what makes the refusal independent of an unspecified behaviour;
  # do not delete it on the grounds that no test fails, because none will.
  _UE=''
  case $1 in ''|*[!0-9]*) return 0 ;; esac
  [ "${#1}" -le 11 ] || return 0
  [ "$1" -ge 1000000000 ] 2>/dev/null || return 0
  [ "$1" -le $(( $2 + 2592000 )) ] 2>/dev/null || return 0
  _UE=$1
}

_u_gt() {
  # Numeric > on two canonical integers. jq emits them as `round|tostring`, so
  # there is no decimal point to drop and no leading zero — which is what
  # removes the `10#` the bash original needed.
  #
  # Do NOT reach for $(( )) here. dash reads a leading zero as octal and an
  # invalid octal digit as a FATAL error that exits the shell, so a single
  # externally edited "08" in the state file would kill the render rather than
  # cost a sample. `test -gt` parses base 10 and cannot do that.
  case $1 in ''|*[!0-9]*) return 1 ;; esac
  case $2 in ''|*[!0-9]*) return 1 ;; esac
  # 19 digits is not a percentage. Belt and braces, like the one in _u_epoch:
  # jq already refuses to emit a quantised value this long, and _u_record
  # already clears one read back out of the state file, so no test fails when
  # this line goes. It stays because those are the two guards that keep the
  # window from freezing — `used_percentage: 1e30` stored as a high-water mark
  # nothing can beat — and a comparison helper should not depend on both of
  # its callers having got it right.
  if [ "${#1}" -gt 18 ] || [ "${#2}" -gt 18 ]; then return 1; fi
  [ "$1" -gt "$2" ]
}

_u_tag() {
  # Lift one key out of $OTEL_RESOURCE_ATTRIBUTES into $_UT, without forking.
  # claudio's `run` exports profile=/account=/host=/email= there and Claude
  # Code spawns the status line as a child, so the shim inherits it. Reading it
  # rather than re-deriving the same facts is what makes these keys identical
  # to the ones on the per-request OTLP stream BY CONSTRUCTION — the two
  # streams have to join, and two derivations would eventually disagree.
  # "$1" inside the pattern is quoted, so it is a literal: an attribute value
  # cannot inject a glob.
  _ut_r=",${OTEL_RESOURCE_ATTRIBUTES:-},"
  case $_ut_r in
    *",$1="*) _ut_r=${_ut_r#*",$1="}; _UT=${_ut_r%%,*} ;;
    *)        _UT='' ;;
  esac
}

_u_win() {
  # Decide one rate-limit window. $1 quantised pct (empty = window absent or
  # unusable), $2 validated reset epoch (empty = unknown), $3 stored high-water
  # pct, $4 stored reset. Sets $_U_FIRE (empty|change|reset) and the new marks
  # $_U_NQ / $_U_NR.
  #
  # High-water marks with forward-only reset acceptance, not plain change
  # detection. Concurrent sessions hold snapshots of different ages and
  # ping-pong the shared state: the 65 real samples contain 3 in-window 5-hour
  # decreases, 4 seven-day decreases, one identical-timestamp pair reporting 5%
  # and 4%, and resets_at flapping backwards six times. Every one of those
  # looks like a change. Replaying that file, this rule keeps 49 of 65.
  #
  # Be precise about what that buys, because the obvious reading is wrong. The
  # rule decides WHETHER a record is written; it does not filter the values in
  # it, and one record carries both windows. So the window that fired is
  # monotone non-decreasing on a serial replay and the other is whatever this
  # tick happened to see, which may sit below something already written. The
  # state file is an unlocked read-modify-write, so simultaneous sessions can
  # additionally emit duplicates and out-of-order records. This rule removes
  # most negative movement, not all of it: a later delta attribution must clamp
  # negative deltas rather than assume none occur. The real 65 come out
  # monotone in both windows by luck, not by construction.
  _U_FIRE=''; _U_NQ=$3; _U_NR=$4
  [ -n "$1" ] || return 0
  if [ -n "$2" ] && [ -n "$4" ]; then
    # An older snapshot from another session. Ignore the window entirely: do
    # not record, and do not move the marks backwards.
    if [ "$2" -lt "$4" ]; then return 0; fi
    if [ "$2" -gt "$4" ]; then
      # Rollover, recorded UNCONDITIONALLY whichever way the percentage went.
      # This is the only line that carries the new window's boundary, and it is
      # most of the feature rather than an edge case: deleting this branch
      # drops the replay of the real data from 49 records to 22, and turns a
      # 90% -> 2% rollover into one record followed by permanent silence,
      # because 2% never beats a 90% high-water mark again.
      _U_FIRE=reset; _U_NQ=$1; _U_NR=$2; return 0
    fi
  fi
  if [ -z "$3" ] || _u_gt "$1" "$3"; then
    _U_FIRE=change; _U_NQ=$1
    if [ -n "$2" ]; then _U_NR=$2; fi
    return 0
  fi
  # No movement worth a line. Still adopt a reset epoch we did not have, so a
  # later rollover stays detectable; nothing is recorded either way.
  if [ -z "$4" ] && [ -n "$2" ]; then _U_NR=$2; fi
  return 0
}

_u_save_state() {
  # $1 = account uuid for the record, $2 = timestamp of the last RECORD.
  #
  # Temp + rename, because rename(2) is atomic: a concurrent reader sees the
  # old line or the new one, never a half-written one — which would read as "no
  # state" and force a spurious `first`. $$ keeps two writers apart.
  #
  # $2 is passed rather than taken from now because the quiet-tick caller must
  # NOT move it: the field means "when the last RECORD was written", and a tick
  # that wrote no record is not one. Nothing in claudio reads it back today —
  # `usage_heartbeat` was dropped along with `usage_precision` — so it is a
  # slot, kept for the same reason field 8 is: so that a key that wants it
  # later needs no second bump of the state version. If you delete the field,
  # bump the version, or every existing state file silently shifts.
  #
  # `-` stands for "not known" and no field is ever written empty. Tab is an
  # IFS *whitespace* character, so a run of tabs collapses into one delimiter
  # and an empty field simply disappears on the way back in — silently shifting
  # every later mark and making a settled window look like a change on every
  # tick. Field 7 is the state version and field 8 the quantiser precision;
  # precision is fixed at 0 today, and the slot is kept so that making it
  # configurable later does not need a second version bump.
  if printf '%s\t%s\t%s\t%s\t%s\t%s\t2\t0\n' \
       "${1:--}" "${_u_nr5:--}" "${_u_nq5:--}" "${_u_nr7:--}" "${_u_nq7:--}" \
       "$2" > "$_u_state.$$.tmp" 2>/dev/null; then
    mv -f "$_u_state.$$.tmp" "$_u_state" 2>/dev/null || rm -f "$_u_state.$$.tmp" 2>/dev/null
  else
    rm -f "$_u_state.$$.tmp" 2>/dev/null
  fi
}

# The jq that parses the payload. One fork, and it does four jobs at once: it
# lifts the fields the record needs, quantises the two percentages into the
# canonical integers the dedupe rule compares, canonicalises the two reset
# epochs, and reads the clock — so there is no `date` fork either.
#
# Every path segment carries `?`, and that is what keeps one jq call from being
# one shared point of failure. `.rate_limits.five_hour` against a
# `"rate_limits": "oops"` is not a missing field, it is a fatal "Cannot index
# string with string": jq aborts and EVERY field comes back empty because of
# one bad one. `?` turns each index into `empty`, which `// ""` then fills, so
# a malformed parent costs exactly its own segment. It must be on every
# segment — `.rate_limits.five_hour.used_percentage?` still dies, because the
# abort happens at the first index, not the last.
#
# `q` is the quantiser. It refuses anything that is not a finite number, so
# "n/a" and {"a":1} and null all become the empty string, and it refuses a
# result of more than 18 digits, which is what stops `used_percentage: 1e30`
# being stored as a high-water mark that nothing can ever beat. Negatives fail
# the same test. Each field degrades on its own; jq never aborts.
#
# Newlines and carriage returns are squashed to spaces because the output is
# peeled apart on newlines, and the 19th field is a constant sentinel: if it is
# not there when the peel finishes, the field list has drifted and every
# variable is shifted, so the record is dropped rather than mis-assembled.
_U_JQ_PARSE='
def s: tostring | gsub("[\r\n]"; " ");
def q: if type == "number" and (isnan|not) and (isinfinite|not)
       then (round | tostring | if test("^[0-9]{1,18}$") then . else "" end)
       else "" end;
[ (.workspace?.current_dir? // .cwd? // "" | s),
  (.workspace?.project_dir? // "" | s),
  (.rate_limits?.five_hour?.used_percentage? // "" | s),
  (.rate_limits?.seven_day?.used_percentage? // "" | s),
  (.session_id? // "" | s),
  (.model?.id? // "" | s),
  (.cost?.total_cost_usd? // "" | s),
  (.version? // "" | s),
  (.prompt_id? // "" | s),
  (.agent_type? // "" | s),
  (.rate_limits?.five_hour?.used_percentage? // null | q),
  (.rate_limits?.seven_day?.used_percentage? // null | q),
  (.rate_limits?.five_hour?.resets_at? // null | q),
  (.rate_limits?.seven_day?.resets_at? // null | q),
  (.cost?.total_cost_usd? // null
     | if type == "number" and (isnan|not) and (isinfinite|not) and . >= 0
       then "1" else "" end),
  (now | floor | tostring),
  "." ] | join("\n")'

_u_record() {
  # Runs after the rendered line has been delivered. Reads $_U_IN, $_U_ACCT and
  # $_U_PROF, which the shim and the early dispatch block set.
  # Resolved once, in the early block, in the same pass as `usage` — the
  # receiver check needs it too and a second layered pass would cost every
  # render. Empty means "nowhere to write": unset with no HOME, or a directory
  # inside ~/.claude, which claudio refuses rather than squats in.
  _u_dir=$_U_DIR
  [ -n "$_u_dir" ] || return 0

  _u_p=$(printf '%s' "$_U_IN" | jq -r "$_U_JQ_PARSE" 2>/dev/null) || return 0
  [ -n "$_u_p" ] || return 0
  _u_r=$_u_p
  _u_peel "$_u_r"; _u_cwd=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_proj=$_UL;   _u_r=$_UR
  _u_peel "$_u_r"; _u_p5r=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_p7r=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_sid=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_model=$_UL;  _u_r=$_UR
  _u_peel "$_u_r"; _u_costr=$_UL;  _u_r=$_UR
  _u_peel "$_u_r"; _u_ver=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_pid=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_agent=$_UL;  _u_r=$_UR
  _u_peel "$_u_r"; _u_q5=$_UL;     _u_r=$_UR
  _u_peel "$_u_r"; _u_q7=$_UL;     _u_r=$_UR
  _u_peel "$_u_r"; _u_c5=$_UL;     _u_r=$_UR
  _u_peel "$_u_r"; _u_c7=$_UL;     _u_r=$_UR
  _u_peel "$_u_r"; _u_costok=$_UL; _u_r=$_UR
  _u_peel "$_u_r"; _u_now=$_UL;    _u_r=$_UR
  _u_peel "$_u_r"; _u_sent=$_UL
  [ "$_u_sent" = . ] || return 0
  # $_u_now reaches $(( )), where garbage is fatal in dash rather than false.
  case $_u_now in ''|*[!0-9]*) return 0 ;; esac

  # No rate-limit block in this payload: nothing to say, and nothing created.
  [ -n "$_u_q5" ] || [ -n "$_u_q7" ] || return 0

  _u_epoch "$_u_c5" "$_u_now"; _u_r5=$_UE
  _u_epoch "$_u_c7" "$_u_now"; _u_r7=$_UE

  # State key: an account IS a config dir, so the config dir path is a 1:1
  # account key that costs no process to compute. ${var//\//_} is bash; this
  # peel loop is the POSIX equivalent and forks nothing either.
  _u_key=${CLAUDE_CONFIG_DIR:-$HOME}
  _u_key=${_u_key%/}; _u_key=${_u_key#/}
  _u_s=$_u_key; _u_key=''
  while :; do
    case $_u_s in
      */*) _u_key="$_u_key${_u_s%%/*}_"; _u_s=${_u_s#*/} ;;
      *)   _u_key="$_u_key$_u_s"; break ;;
    esac
  done
  _u_state="$_u_dir/.last_$_u_key"
  _u_cache="$_u_dir/account_$_u_key.json"

  # <uuid> <hw5_reset> <hw5_pct> <hw7_reset> <hw7_pct> <last_ts> <ver> <prec>
  _u_su=-; _u_sr5=-; _u_sq5=-; _u_sr7=-; _u_sq7=-; _u_sts=''; _u_sver=''; _u_sprec=''
  _u_have=0
  if [ -f "$_u_state" ]; then
    _u_have=1
    IFS="$TAB" read -r _u_su _u_sr5 _u_sq5 _u_sr7 _u_sq7 _u_sts _u_sver _u_sprec \
      < "$_u_state" || :
  fi
  if [ "$_u_sr5" = - ]; then _u_sr5=''; fi
  if [ "$_u_sq5" = - ]; then _u_sq5=''; fi
  if [ "$_u_sr7" = - ]; then _u_sr7=''; fi
  if [ "$_u_sq7" = - ]; then _u_sq7=''; fi

  # A mark read BACK out of the state file gets exactly the validation an
  # incoming one gets. Without this a single implausible epoch — a millisecond
  # timestamp, an external edit, a usage_dir shared by two machines — sticks
  # permanently and silences its window; and a stored percentage that is not a
  # number makes _u_gt answer "not greater" for ever, which is the same freeze
  # by another route. A rejected mark is cleared and forces `first`, which
  # re-establishes the baseline in exactly one record.
  _u_reason=''
  if [ -n "$_u_sr5" ]; then
    _u_epoch "$_u_sr5" "$_u_now"
    if [ -z "$_UE" ]; then _u_sr5=''; _u_reason=first; fi
  fi
  if [ -n "$_u_sr7" ]; then
    _u_epoch "$_u_sr7" "$_u_now"
    if [ -z "$_UE" ]; then _u_sr7=''; _u_reason=first; fi
  fi
  if [ -n "$_u_sq5" ]; then
    case $_u_sq5 in *[!0-9]*) _u_sq5=''; _u_reason=first ;; esac
    if [ "${#_u_sq5}" -gt 18 ]; then _u_sq5=''; _u_reason=first; fi
  fi
  if [ -n "$_u_sq7" ]; then
    case $_u_sq7 in *[!0-9]*) _u_sq7=''; _u_reason=first ;; esac
    if [ "${#_u_sq7}" -gt 18 ]; then _u_sq7=''; _u_reason=first; fi
  fi

  if [ "$_u_have" = 0 ]; then
    _u_reason=first
  elif [ "$_u_sver" != 2 ] || [ "$_u_sprec" != 0 ]; then
    # A state file from an older layout, or one written at a different
    # quantiser precision. Its marks are not comparable with what is about to
    # be computed, so they go and one record re-establishes the baseline.
    _u_reason=first; _u_sq5=''; _u_sr5=''; _u_sq7=''; _u_sr7=''
  fi

  _u_win "$_u_q5" "$_u_r5" "$_u_sq5" "$_u_sr5"
  _u_f5=$_U_FIRE; _u_nq5=$_U_NQ; _u_nr5=$_U_NR
  _u_win "$_u_q7" "$_u_r7" "$_u_sq7" "$_u_sr7"
  _u_f7=$_U_FIRE; _u_nq7=$_U_NQ; _u_nr7=$_U_NR

  if [ -z "$_u_reason" ]; then
    if   [ "$_u_f5" = reset ]  || [ "$_u_f7" = reset ];  then _u_reason=reset
    elif [ "$_u_f5" = change ] || [ "$_u_f7" = change ]; then _u_reason=change
    fi
  fi
  if [ -z "$_u_reason" ]; then
    # Nothing to record — but _u_win may still have adopted a reset epoch it
    # did not have before, and that is the only thing that makes a later
    # rollover detectable. Dropping it here is what made a window go silent for
    # good after a rollover it could not see. Only the epochs can have moved:
    # on a quiet tick _u_win returns the stored percentage unchanged. The old
    # last_ts is kept, never now.
    if [ "$_u_nr5" != "$_u_sr5" ] || [ "$_u_nr7" != "$_u_sr7" ]; then
      _u_save_state "$_u_su" "${_u_sts:-$_u_now}"
    fi
    return 0
  fi

  # --- cold path: a few times an hour ---------------------------------------
  if [ ! -d "$_u_dir" ]; then
    mkdir -p "$_u_dir" 2>/dev/null || return 0
    chmod 700 "$_u_dir" 2>/dev/null || :
  fi

  # Identity: account uuid, address, organisation and plan tier appear nowhere
  # in the status line payload — there is no identity block in it at all — so
  # they come from the config dir's own .claude.json and are cached, because
  # that file is ~180 KB. `-nt` is not in POSIX test but IS implemented by dash
  # and by bash, which is claudio's whole test matrix; the portable alternative
  # costs a fork on a path that is meant to be nearly free.
  #
  # Read from $CLAUDE_CONFIG_DIR and from nowhere else, exactly as _dir_email
  # is: there is deliberately no $HOME fallback, because Claude Code's own
  # default login is not claudio's account to describe — and reading it would
  # make the test suite read the developer's real address.
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    _u_cj="$CLAUDE_CONFIG_DIR/.claude.json"
    if [ -f "$_u_cj" ] && { [ ! -f "$_u_cache" ] || [ "$_u_cj" -nt "$_u_cache" ]; }; then
      # userRateLimitTier is null on a Max plan and organizationRateLimitTier
      # holds the value; reading only the first regresses every record to null.
      if jq -c '{account_uuid: (.oauthAccount.accountUuid // null),
                 account_email: (.oauthAccount.emailAddress // null),
                 organization_uuid: (.oauthAccount.organizationUuid // null),
                 rate_limit_tier: (.oauthAccount.userRateLimitTier
                                   // .oauthAccount.organizationRateLimitTier // null)}' \
           "$_u_cj" > "$_u_cache.$$.tmp" 2>/dev/null; then
        mv -f "$_u_cache.$$.tmp" "$_u_cache" 2>/dev/null \
          || rm -f "$_u_cache.$$.tmp" 2>/dev/null
      else
        rm -f "$_u_cache.$$.tmp" 2>/dev/null
      fi
    fi
  fi

  _u_tag profile; _u_rprof=$_UT
  _u_tag account; _u_racct=$_UT
  _u_tag host;    _u_rhost=$_UT
  [ -n "$_u_rprof" ] || _u_rprof=$_U_PROF
  [ -n "$_u_racct" ] || _u_racct=$_U_ACCT
  [ -n "$_u_rhost" ] || _u_rhost=$(_host_slug)

  _u_cachearg=$_u_cache
  [ -f "$_u_cachearg" ] || _u_cachearg=/dev/null   # --slurpfile of /dev/null is []

  # --argjson parses its argument as JSON, so a raw payload string cannot go in
  # unchecked. Two separate failures came from doing exactly that:
  #   `used_percentage: "n/a"` is not JSON, so jq exits non-zero and the WHOLE
  #   record is dropped, including the other window's genuine observation and
  #   including the state write, so the loss repeats on every tick for as long
  #   as the field stays malformed.
  #   `used_percentage: {"a":1}` IS valid JSON, so it sails into a numeric
  #   field and anything reading five_hour_pct as a number gets an object.
  # The quantiser has already ruled on all three values: $_u_q5 and $_u_q7 are
  # empty exactly when the percentage is absent or unusable, so reusing that
  # verdict costs nothing and makes "one bad field costs one field" true of the
  # record too.
  _u_a5=null; _u_a7=null; _u_ac=null
  if [ -n "$_u_q5" ]; then _u_a5=$_u_p5r; fi
  if [ -n "$_u_q7" ]; then _u_a7=$_u_p7r; fi
  if [ -n "$_u_costok" ]; then _u_ac=$_u_costr; fi

  _u_line=''; _u_uuid='-'
  _u_out=$(jq -rn --slurpfile a "$_u_cachearg" \
      --argjson ts "$_u_now" \
      --argjson p5 "$_u_a5"  --argjson r5 "${_u_r5:-null}" \
      --argjson p7 "$_u_a7"  --argjson r7 "${_u_r7:-null}" \
      --argjson cost "$_u_ac" \
      --arg sid "$_u_sid"        --arg model "$_u_model" \
      --arg profile "$_u_rprof"  --arg client "$_u_ver" \
      --arg project "${_u_proj:-$_u_cwd}" --arg reason "$_u_reason" \
      --arg host "$_u_rhost"     --arg account "$_u_racct" \
      --arg pid "$_u_pid"        --arg agent "$_u_agent" \
      --arg tags "${OTEL_RESOURCE_ATTRIBUTES:-}" '
      ($a[0] // {}) as $A
      | def s: if . == "" then null else . end;
      { ts:                  $ts,
        account_uuid:        ($A.account_uuid // null),
        account_email:       ($A.account_email // null),
        organization_uuid:   ($A.organization_uuid // null),
        rate_limit_tier:     ($A.rate_limit_tier // null),
        five_hour_pct:       $p5,
        five_hour_resets_at: $r5,
        seven_day_pct:       $p7,
        seven_day_resets_at: $r7,
        session_id:          ($sid|s),
        model:               ($model|s),
        session_cost_usd:    $cost,
        profile:             ($profile|s),
        client:              (if $client == "" then null else "claude-code/" + $client end),
        project:             ($project|s),
        schema:              2,
        reason:              $reason,
        host:                ($host|s),
        account:             ($account|s),
        prompt_id:           ($pid|s),
        agent:               ($agent|s),
        tags:                ($tags|s) } as $rec
      # The line must fit ONE write(2). The governing limit is not PIPE_BUF —
      # this is a regular file opened O_APPEND, where a single write is atomic
      # under the inode lock at any size — it is the SHELL stdio flush unit,
      # BUFSIZ, which is 1024 on Darwin. So 1023 bytes of JSON plus the newline
      # is the largest append that cannot interleave. Measured, not assumed: 16
      # concurrent writers x 60 lines tear never at 1023 bytes and immediately
      # at 1024, identically under dash and bash. Do not "fix" this to 512 to
      # match PIPE_BUF; that halves the usable record for nothing.
      #
      # The cap is genuinely reachable: `tags` is the whole
      # $OTEL_RESOURCE_ATTRIBUTES and `project` an arbitrary path, and a deep
      # monorepo path with a full six-key tag string reaches 950 bytes of the
      # 1023 available. The all-null skeleton is 402.
      #
      # ONE shared cap on every string, tightened until the line fits, rather
      # than shrinking each field proportionally: the field that overflowed the
      # record is the one that should pay for it. Halving everything cut a
      # 28-character project path to 7 to make room for a bloated `tags`, and
      # session_id and prompt_id are the keys this log joins to the OTel stream
      # on. Under a shared cap they are untouched until the cap falls below
      # their own length, which only a pathological record reaches.
      #
      # `reason` is exempt: a truncated "chang" would be a lie, and it is 9
      # bytes at most. utf8bytelength, not length, because the boundary is
      # bytes and jq counts codepoints. Numbers are never touched, so the
      # fields the dedupe rule reads cannot be altered by truncation.
      #
      # `first` over a descending list, not a loop: it stops at the first cap
      # that fits, and the list ends at 0, whose candidate is the ~400-byte
      # skeleton and therefore always fits. A condition that could never become
      # true would hang the status line, which is worse than a long line.
      | def capall($n): with_entries(
          if .key != "reason" and (.value|type) == "string"
          then .value |= .[0:$n] else . end );
        ( if ($rec|tojson|utf8bytelength) <= 1023 then $rec
          else first( (768,512,384,256,192,128,96,64,48,32,24,16,8,4,0) as $n
                      | ($rec | capall($n) | .truncated = true)
                      | select( (tojson|utf8bytelength) <= 1023 ) )
          end ) as $out
      # The state keeps the untruncated uuid: it is an identity, not a payload.
      | ($out|tojson), ($rec.account_uuid // "-")' 2>/dev/null) || return 0
  _u_peel "$_u_out"; _u_line=$_UL; _u_peel "$_UR"; _u_uuid=$_UL
  [ -n "$_u_uuid" ] || _u_uuid='-'
  # jq failed, or produced something that is not a record: write neither the
  # record nor the state, so the next tick tries again rather than silently
  # swallowing the change.
  case $_u_line in '{'*) ;; *) return 0 ;; esac

  # One printf of one line of at most 1024 bytes to an O_APPEND descriptor: the
  # offset choice and the write are atomic under the inode lock, so concurrent
  # sessions cannot interleave. The size is what makes that true and the jq
  # above is what makes the size true. This is also why the record is assembled
  # into a variable first and why jq never writes to the log itself. flock is
  # not on macOS by default, so lock-free append is not merely cheapest, it is
  # the only portable option.
  printf '%s\n' "$_u_line" >> "$_u_dir/samples.jsonl" || return 0

  # A record was written, so this tick is what field 6 means: the last record.
  _u_save_state "$_u_uuid" "$_u_now"
}

_u_shim() {
  # Reached only when recording is on — the early dispatch block at the top of
  # this file `exec`s the renderer directly when it is off, and set $_U_CMD,
  # $_U_ACCT and $_U_PROF on the way past.
  _U_RC=0
  # $( ) strips trailing newlines, so what the renderer receives is the payload
  # modulo trailing whitespace. No consumer can tell: it is one JSON object,
  # and a status line reads it with `$(cat)` itself.
  _U_IN=$(cat)
  if [ -n "$_U_CMD" ]; then
    # Streamed, never captured: the rendered line must reach Claude Code before
    # anything below runs, and the renderer's own exit status is passed through
    # so the shim stays transparent. Bare word without a shell, command line
    # with one, for the reason given on the recording-off path above.
    case $_U_CMD in
      *[!A-Za-z0-9_/.-]*) printf '%s' "$_U_IN" | sh -c "$_U_CMD" ;;
      *)                  printf '%s' "$_U_IN" | "$_U_CMD" ;;
    esac
    _U_RC=$?
  fi

  # Everything from here is after the line has been delivered, and swallows
  # everything: a recorder bug must cost you a sample, never your status line
  # and never a non-zero exit.
  #
  # `|| :` alone is not "swallowing everything" — it catches a non-zero RETURN,
  # and two whole classes never return to it:
  #
  #   A signal. A write past RLIMIT_FSIZE raises SIGXFSZ, which kills the shell
  #   outright. Ignoring it turns that write into an ordinary EFBIG failure,
  #   which `|| return 0` inside the recorder already handles. Only XFSZ is
  #   ignored: trapping TERM would make a status line that overran Claude
  #   Code's timeout unkillable, which is a worse bug than the one being fixed.
  #
  #   A fatal expansion. `${x:?}`, a division by zero, an arithmetic expansion
  #   of a leading-zero string under dash — each exits the shell where it
  #   stands, so `||` is never reached. The EXIT trap is the backstop for all
  #   of them at once, and for a stray `exit` too. It re-exits with the
  #   RENDERER's status, so containment cannot turn a working render into a
  #   failure or a failed one into a success.
  #
  # Both traps are builtins, so containment costs no fork.
  trap '' XFSZ
  trap 'exit ${_U_RC:-0}' EXIT
  # The receiver first: a missing sample is one sample, a missing receiver is
  # every request this session makes until something notices. Contained by the
  # same traps and the same `|| :` as the recorder, for the same reason.
  if [ "$_U_SPAWN" = 1 ]; then
    { _recv_ensure "$_U_DIR" "$_RECV_PORT" ''; } 2>/dev/null || :
  fi
  # Guarded here as well as by the early block's exec. Nothing can reach this
  # with recording off today, but "the caller already checked" is exactly the
  # assumption a later refactor breaks, and the cost of being wrong is samples
  # appearing for a user who never opted in.
  if [ "$_U_ON" = 1 ]; then { _u_record; } 2>/dev/null || :; fi
  exit "$_U_RC"
}

# --- dispatch ---

[ $# -eq 0 ] && { _usage; exit 0; }

CMD=$1; shift
case $CMD in
  list)    cmd_list ;;
  use)     cmd_use "$@" ;;
  run)     cmd_run "$@" ;;
  env)     cmd_env "$@" ;;
  account) cmd_account "$@" ;;
  default) cmd_default "$@" ;;
  statusline) cmd_statusline "$@" ;;
  usage)   cmd_usage_cmd "$@" ;;
  recv)    cmd_recv "$@" ;;
  clean)   cmd_clean ;;
  migrate) cmd_migrate "$@" ;;
  update)  cmd_update "$@" ;;
  new)     cmd_new "$@" ;;
  mcp)     cmd_mcp "$@" ;;
  # edit/show default to the profile active in cwd: in practice that is
  # always the one you mean, and it is the only argument you would type.
  edit)    cmd_edit "${1:-$(_active_profile)}" "$2" ;;
  show)    cmd_show "${1:-$(_active_profile)}" "$2" ;;
  current) cmd_current ;;
  init)    cmd_init "$1" ;;
  -h|--help|help) _usage ;;
  # A flag, not a `version` verb: the usage text's doc-drift guard enumerates
  # verbs, so keeping this out of that list keeps the list honest.
  -V|--version) printf '%s\n' "$VERSION" ;;
  *)       echo "Unknown command: $CMD" >&2; _usage; exit 1 ;;
esac
