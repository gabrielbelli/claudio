# Copy to `.env` beside this file and edit.  `.env` is gitignored: it names a
# host's real certificate directory and the paths to two token files, and
# neither belongs in a repository.
#
#     cp server/oci/.env.example server/oci/.env
#
# EVERY VALUE HERE HAS A WORKING DEFAULT, so an empty `.env` -- or none at all
# -- still starts the stack. That is the point: `docker compose up` comes up
# self-signed, on loopback, before anyone has a certificate.

# The name the certificate is for. With no CLAUDIO_TLS_DIR the proxy generates
# a self-signed pair for this name on first start and says so on every start
# after it, so `localhost` is a working default and never a silent one.
CLAUDIO_DOMAIN=localhost

# A host directory holding a real `fullchain.pem` and `privkey.pem`. Leave it
# commented out and a named volume is used with the self-signed pair above.
#CLAUDIO_TLS_DIR=/etc/letsencrypt/live/claudio.example.com

# The store, and the two token files. Defaults are relative to `server/`.
#   echo '{"<token>": "<account-uuid>"}' > server/tokens.json   # who may SHIP
#   echo '{"<token>": "*"}'              > server/readers.json  # who may READ
#CLAUDIO_STORE=../.store
#CLAUDIO_TOKENS=../tokens.json
#CLAUDIO_READERS=../readers.json

# The published ports. BOTH ARE PINNED TO 127.0.0.1 in `compose.yml` and these
# only change the host-side number; making them reachable from off-box is an
# edit to `compose.yml` itself, deliberately, because this stack's bearer
# tokens are routing labels and not credentials. Read the trust section of
# `server/README.md` before you make it.
#CLAUDIO_HTTP_PORT=8080
#CLAUDIO_HTTPS_PORT=8443

# Extra nginx server blocks, if you have any.
#CLAUDIO_NGINX_D=./nginx/nginx.d

# THE UPSTREAM WATCHER. nginx resolves an upstream name once, when its
# configuration loads, so an address that MOVES afterwards is never noticed --
# and `docker compose restart ingest api` can swap two containers' addresses
# (reproduced). The proxy's entrypoint re-resolves the three service names on
# this interval and reloads nginx when one moves. Off, the crossed state is two
# named 503s that persist until somebody runs `nginx -s reload`.
#CLAUDIO_PROXY_WATCH=1
#CLAUDIO_PROXY_WATCH_SECONDS=15
