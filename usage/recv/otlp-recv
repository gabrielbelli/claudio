#!/usr/bin/env python3
"""The OTLP receiver: stream A's only door onto this machine.

This was a debugging aid -- "is anything coming out at all" -- next to a Docker
collector that did the real capture.  The container is gone and this is the
real capture now.  What that promotion demands, and what the rest of this file
is about, is that a receiver nobody watches must never lose a record quietly.

**Spawned on demand, never installed.**  `claudio run` starts it before
`exec claude`, the status-line shim keeps it alive, and it exits by itself when
the work stops.  There is no launchd or systemd unit, for three reasons that
are settled: the flush argument for a resident daemon was measured false (see
`cu/collector.py`); stream A does not exist outside claudio-launched sessions,
because the OTLP variables are written only into the environment of the
`exec`ed claude, so an always-on service listens to an unplugged wire; and
`launchctl`/`systemctl` cannot be stubbed in a hermetic test suite, while every
promise in this repo is pinned by one.

**Why this and not otelcol-contrib.**  The design requires idle self-exit,
which the collector cannot do without a second watcher process -- the daemon
coming back in through the side door.  The binary is 93-107MB with no Homebrew
formula.  Python is already a dependency of `usage/`, and it is testable here.
otelcol wins the argument back the day remote mTLS and a durable retry queue
matter; that is a separate decision, made later, on its own evidence.

Protocol: **OTLP/HTTP with a JSON body**, on loopback only.  gRPC is HTTP/2
framing plus protobuf and `http.server` cannot be talked into it, so Claude
Code is pointed here with:

    logging=local
    otel_protocol=http/json      # claudio's default
    otel_endpoint=http://localhost:4318   # claudio's default

`logging=local` alone is now enough: claudio's defaults *are* these two lines,
which they were not while it defaulted to the Docker collector's `grpc`.  An
export aimed at a port nothing listens on fails **quietly** -- by design, in
Claude Code -- so a default that starts nothing and records nothing was the
one failure this project exists to prevent, shipped as the feature's normal
behaviour.  `claudio usage doctor` still checks both values, because anyone may
have set them by hand.

Four properties carry the design:

  * **Durable before the 200.**  Every accepted payload is appended with
    O_APPEND and one `write(2)` *before* the response is sent, and a write that
    fails answers 503 so the client keeps its copy and retries.  Nothing is
    ever held only in memory, which is what makes the shutdown path irrelevant
    to data integrity -- the whole basis of an on-demand receiver.
  * **Verbatim in, counted at the door.**  See `Capture` for why nothing is
    filtered or allow-listed here.
  * **Idle exit needs both conditions.**  No records for `idle_minutes` AND no
    live pid under `<usage_dir>/sessions/`.  Either alone is wrong: a user
    thinking for 40 minutes mid-task would be orphaned by the timer, and a
    session file left by a crashed claude would keep the receiver up for ever.
  * **A crash loop refuses itself.**  A receiver that cannot bind dies
    instantly, and a supervisor firing several times a second would fork-bomb.
    Starts that never reached a successful bind are counted in a window; past
    the cap it writes `recv.err` and exits without binding.  The supervisor
    carries the cheap half of this cap; this half is the backstop that works
    even if the supervisor is wrong.

The contract with claudio (POSIX sh, which cannot import any of this) is eight
paths, all defined in `cu/config.py` so that they are spelled once:
`recv.pid`, `recv.lock`, `recv.err`, `recv.warn`, `recv.starts`,
`recv-counters.json`, `sessions/<pid>` and `raw/api_request.jsonl`.

`recv.err` and `recv.warn` are two files because they answer two questions.
claudio's supervisor spawns when the receiver is dead **and** `recv.err` is
absent, so that file means "a start fault is already reported, do not chase
it".  A running receiver's own faults -- an undecodable body, a failed write --
are neither reported starts nor reasons to stop respawning, and writing them
into `recv.err` disarmed the supervisor for every later session.
"""

import argparse
import datetime
import gzip
import json
import os
import signal
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# `cu` is imported rather than copied.  This file is one directory below it in
# the same repo and is never installed anywhere else, and the alternative --
# a second host_slug, a second uptime writer, a second config reader -- is the
# duplication that has already cost this project three silently dropped fields.
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from cu import collector, config, ingest, otlp, ship, tail   # noqa: E402

DEFAULT_HOST = "127.0.0.1"

# Requirement, not a default: this receiver holds an unauthenticated firehose of
# one person's request metadata, including their email address.  `0.0.0.0` would
# publish it to the network.  There is no flag that reaches it.
LOOPBACK = ("127.0.0.1", "::1", "localhost")

SIGNALS = {
    "/v1/logs": "logs",
    "/v1/metrics": "metrics",
    "/v1/traces": "traces",
}

# Cap a single body so a malformed or hostile client cannot exhaust memory.
MAX_BODY = 32 * 1024 * 1024

# The crash-loop cap and the lock's staleness live in `cu/collector.py` with
# the files they govern: `collector.MAX_STARTS`, `collector.START_WINDOW`,
# `collector.LOCK_STALE`.


# --------------------------------------------------------------------------
# counters
# --------------------------------------------------------------------------

class Counters:
    """What arrived, what was written, and what nothing downstream will keep.

    This is the replacement for otelcol's `:8888` scrape, and it exists for the
    same one reason: it is the only artefact on this machine that can tell
    *nothing arrived* apart from *everything was dropped*.  Every bug this
    project has had was the second wearing the first's face.

    It answers one question the scrape could not.  `raw/api_request.jsonl` used
    to be the collector's own **output**, so nothing downstream could ever see
    what never arrived -- a field deleted by `keep_keys` was invisible in the
    only file anyone read, and that is how `prompt.id`, every user `--tag` and
    `agent.name` were each lost in silence.  Counting at the door closes that
    blind spot structurally: `events` names every distinct `event.name` seen,
    and `unknown_attributes` names every attribute key that arrived and that
    the ledger has no column for.  A field nothing keeps is now *countable*,
    which was the standing requirement.
    """

    def __init__(self):
        self.lock = threading.Lock()
        self.started_at = time.time()
        self.last_record_at = self.started_at
        self.payloads = {"logs": 0, "metrics": 0, "traces": 0}
        self.dropped = {"metrics": 0, "traces": 0}
        self.accepted = 0           # log records parsed out of a logs payload
        self.written = 0            # log records durably on disk
        self.bytes = 0
        self.undecodable = 0        # a body we could not parse (protobuf, junk)
        self.write_failed = 0       # answered 503; the client still holds it
        self.rejected = 0           # 404/400: not ours, or no body
        self.events = {}            # {event.name: count}
        self.unknown_attributes = {}    # {key: count} -- arrived, nothing keeps

    def snapshot(self, extra=None):
        with self.lock:
            out = {
                "version": 1,
                "started_at": self.started_at,
                "last_record_at": self.last_record_at,
                "payloads": dict(self.payloads),
                "dropped": dict(self.dropped),
                "accepted": self.accepted,
                "written": self.written,
                "bytes": self.bytes,
                "undecodable": self.undecodable,
                "write_failed": self.write_failed,
                "rejected": self.rejected,
                "events": dict(self.events),
                "unknown_attributes": dict(self.unknown_attributes),
            }
        if extra:
            out.update(extra)
        return out


def _count_records(counters, payload):
    """Count one logs payload's records, by event name and by unknown key.

    Returns the number of log records seen.  `otlp.STORED_ATTRS` is imported
    rather than restated: the ledger's column list is the definition of "kept",
    and a copy of it here would be a second allow-list, which is precisely the
    shape of bug this counter exists to expose.
    """
    n = 0
    with counters.lock:
        for rl in payload.get("resourceLogs") or []:
            for sl in rl.get("scopeLogs") or []:
                for rec in sl.get("logRecords") or []:
                    n += 1
                    name = None
                    for a in rec.get("attributes") or []:
                        k = a.get("key")
                        if not k:
                            continue
                        if k == "event.name":
                            v = a.get("value") or {}
                            name = v.get("stringValue")
                        elif k not in otlp.STORED_ATTRS:
                            counters.unknown_attributes[k] = \
                                counters.unknown_attributes.get(k, 0) + 1
                    counters.events[name] = counters.events.get(name, 0) + 1
        counters.accepted += n
        if n:
            counters.last_record_at = time.time()
    return n


# --------------------------------------------------------------------------
# the capture file
# --------------------------------------------------------------------------

class Capture:
    """Append-only JSONL of every accepted logs payload, one payload per line.

    **Nothing is filtered and nothing is allow-listed here, deliberately.**
    The Docker collector did both -- `filter/only_api_request` and a `keep_keys`
    over the attributes -- and `cu/otlp.py` then did the same two jobs again one
    layer in, because it stores exactly the columns the ledger has and skips
    every record whose `event.name` is not `api_request`, counting and *naming*
    what it skipped.  One decision implemented twice is how three fields were
    silently dropped: each half looked right beside the other, and the file
    everyone read was the output of both.

    So the keeping decision stays in `cu/otlp.py`, which is the only place that
    knows what a ledger row is, and this file becomes what no downstream reader
    could otherwise have: the bytes as they arrived.  The blind spot the audit
    named -- "raw/api_request.jsonl is the collector's own OUTPUT, so nothing
    downstream can see what never arrived" -- is closed by construction, and
    `Counters` names the drift at the door as well.

    Two costs of that choice, stated rather than buried.  The file now holds
    `user_prompt` and `assistant_response` records too, so it grows faster --
    hence the rotation below, at the figures lumberjack was configured with.
    And the log record *body* is stored as it arrives: Claude Code leaves it
    empty unless `OTEL_LOG_USER_PROMPTS=1`, which is the user's own opt-in, and
    a silent redaction here would be exactly the second, invisible policy this
    docstring is arguing against.  Mode 0600, in a 0700 directory, on loopback.

    The line is re-serialised rather than echoed byte for byte, and that is
    load-bearing twice over: a pretty-printed body would otherwise put newlines
    inside a JSONL record, and `cu/otlp.py` recovers a torn write by cutting
    back to the last `{"resourceLogs"` in the line, which requires the payload
    to start with exactly that key.
    """

    HEAD = "resourceLogs"

    def __init__(self, path, max_bytes, max_backups, unread=None, note=None):
        self.path = path
        self.max_bytes = max_bytes
        self.max_backups = max_backups
        # `unread(path) -> bool`: does that file still hold bytes no ingest has
        # turned into ledger rows?  See `_rotate`.
        self.unread = unread
        self.note = note
        self.lock = threading.Lock()

    def _line(self, payload):
        if self.HEAD in payload:
            # `resourceLogs` first, whatever order it arrived in.
            rest = {k: v for k, v in payload.items() if k != self.HEAD}
            payload = dict([(self.HEAD, payload[self.HEAD])] + list(rest.items()))
        return json.dumps(payload, separators=(",", ":"), default=str) + "\n"

    def append(self, payload):
        """Write one payload durably.  Returns the byte count, or raises.

        One `write(2)` on a regular file opened `O_APPEND` is atomic at any
        size, so a concurrent writer cannot interleave and a process killed
        after this call cannot lose the record.  There is no `fsync`: that
        defends against the host losing power, not against this process dying,
        and the client's own retry queue is a better answer to a machine that
        went down mid-write than a 5ms stall on every record.
        """
        data = self._line(payload).encode("utf-8")
        with self.lock:
            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            try:
                written = 0
                while written < len(data):
                    written += os.write(fd, data[written:])
                size = os.lseek(fd, 0, os.SEEK_END)
            finally:
                os.close(fd)
            if self.max_bytes and size >= self.max_bytes:
                self._rotate()
        return len(data)

    def _rotate(self):
        """Rename the live file aside.  Called with the lock held.

        Ingest copes by construction: `otlp.raw_files` picks up every
        `api_request*.jsonl`, the rotated name is new so it is read from byte
        0, and `ledger.request_id` dedupes on content -- a re-read costs one
        parse, never a duplicate row.

        **It copes only if ingest has actually run.**  There was no interlock
        at all between this unlink and the ingest offset, and while nothing on
        any automatic path ingested (see `cu/ingest.py`), the deletion was not
        an edge case -- it was where the records went.  Reproduced with real
        processes at `raw_max_megabytes=1`, `raw_max_backups=2`: 6000 real
        payloads POSTed, then one `claudio usage ingest` -> 1900 rows, 4100
        records gone for good, with `doctor` printing "6000 accepted -> 6000
        written" directly above "ledger rows: 1900" and exiting 0.  A tight
        ingest loop still lost 830 of 9000, because rotation outran the reader.

        So a backup whose stored ingest offset is short of its size is KEPT and
        said out loud.  The raw directory then grows past `raw_max_backups`,
        which is visible in a byte count and recoverable by ingesting; a
        deleted record is neither.  Cannot-tell answers "keep", for the same
        reason `_recv_is_receiver` answers "alive": the safe direction is the
        one that costs disk rather than data.
        """
        # `splitext` on the *stem*, never `path.replace(".jsonl", ...)`: that
        # would rewrite the first match anywhere in the string, including a
        # directory component, and silently rename into a path that does not
        # exist.
        stem, ext = os.path.splitext(self.path)
        stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
        aside = "%s-%s%s" % (stem, stamp, ext)
        n = 0
        while os.path.exists(aside):
            n += 1
            aside = "%s-%s.%d%s" % (stem, stamp, n, ext)
        try:
            os.rename(self.path, aside)
        except OSError:
            return
        if not self.max_backups:
            return
        d = os.path.dirname(self.path)
        live = os.path.basename(self.path)
        old = sorted(f for f in os.listdir(d)
                     if f.startswith("api_request") and f.endswith(".jsonl")
                     and f != live)
        kept = []
        for f in old[:max(0, len(old) - self.max_backups)]:
            full = os.path.join(d, f)
            if self.unread is not None and self.unread(full):
                kept.append(f)
                continue
            try:
                os.unlink(full)
            except OSError:
                pass
        if kept and self.note:
            self.note("kept %d rotated capture file(s) past raw_max_backups "
                      "because ingest has not read them: %s. Run "
                      "`claudio usage ingest` -- they are deleted on the next "
                      "rotation once their records are in the ledger."
                      % (len(kept), ", ".join(kept)))


