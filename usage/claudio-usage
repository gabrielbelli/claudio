#!/usr/bin/env python3
"""claudio usage - record what this machine sent, and what the plan says.

Standard library only.  Two streams are recorded and neither is interpreted
here: Claude Code's OTLP per-request export (tokens and metadata, tagged by
claudio) and the plan percentages the status line sees.

NOTHING IS ATTRIBUTED LOCALLY.  The plan percentage belongs to the account,
not to this machine, and no local process can see the whole account: two
machines each observe the same 5% -> 7% move and each claim the full 2pp, and
browser, desktop and phone sessions are invisible from here.  Attribution needs
every machine's requests reconciled against a closed window, with a check for
percentage that moved while nobody was watching.  That is the server's job.
"""

import argparse
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from cu import (collector, config, ingest, ledger,  # noqa: E402,F401
                otlp, samples, tail)

_REL = re.compile(r"^(\d+)([smhdw])$")
_UNIT = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}


def parse_time(value, now=None):
    """ISO-8601, a bare epoch, or a relative offset like `24h` / `7d`."""
    if value is None:
        return None
    now = now if now is not None else time.time()
    v = value.strip()
    m = _REL.match(v)
    if m:
        return now - int(m.group(1)) * _UNIT[m.group(2)]
    try:
        return float(v)
    except ValueError:
        pass
    import datetime
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d"):
        try:
            dt = datetime.datetime.strptime(v, fmt).replace(
                tzinfo=datetime.timezone.utc)
            return dt.timestamp()
        except ValueError:
            continue
    raise SystemExit("cannot parse time: %r (use ISO-8601, epoch, or 24h/7d)" % value)


